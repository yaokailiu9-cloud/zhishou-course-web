@import "./styles/design-tokens.wxss";

page {
  min-height: 100vh;
  color: var(--em-color-text);
  background: #fbf9f8;
  font-family: var(--em-font-family);
}

view,
text,
button,
input,
textarea,
scroll-view,
navigator,
image {
  box-sizing: border-box;
}

button {
  max-width: 100%;
  min-width: 0;
  padding: 0;
  margin: 0;
  overflow: hidden;
  line-height: 1;
  background: transparent;
  border-radius: 0;
}

button::after {
  border: 0;
}

input,
textarea {
  max-width: 100%;
  min-width: 0;
  color: var(--em-color-text);
  font: inherit;
}

.safe-bottom {
  padding-bottom: calc(48rpx + env(safe-area-inset-bottom));
}

.serenity-page {
  min-height: 100vh;
  padding: 28rpx var(--em-page-x) var(--em-safe-bottom);
  color: var(--em-color-text);
  background: #fbf9f8;
}

.serenity-topbar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  min-height: 84rpx;
  margin: -4rpx -6rpx 26rpx;
  padding: 0 10rpx;
}

.serenity-menu {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 64rpx;
  height: 64rpx;
  color: var(--em-color-primary);
  font-size: 34rpx;
  border-radius: var(--em-radius-round);
}

.serenity-brand {
  color: var(--em-color-primary);
  font-family: var(--em-font-serif);
  font-size: 40rpx;
  font-style: italic;
  font-weight: 600;
  line-height: 1;
}

.serenity-avatar {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 62rpx;
  height: 62rpx;
  overflow: hidden;
  color: var(--em-color-text-inverse);
  font-size: 24rpx;
  font-weight: var(--em-font-weight-bold);
  background: var(--em-color-primary);
  border: 2rpx solid rgba(254, 214, 91, 0.45);
  border-radius: var(--em-radius-round);
  box-shadow: 0 12rpx 28rpx rgba(0, 39, 39, 0.14);
}

.section-title {
  display: block;
  margin: var(--em-section-gap) 0 var(--em-card-gap);
  color: var(--em-color-text);
  font-family: var(--em-font-serif);
  font-size: var(--em-font-size-xl);
  font-weight: 600;
  line-height: 1.28;
  letter-spacing: 0;
}

.muted {
  color: var(--em-color-text-muted);
}

.pill {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  min-height: 42rpx;
  padding: 0 var(--em-space-3);
  color: var(--em-color-gold-strong);
  font-size: var(--em-font-size-xxs);
  font-weight: var(--em-font-weight-bold);
  background: var(--em-color-gold-soft);
  border-radius: var(--em-radius-pill);
}

.primary-button {
  display: flex;
  align-items: center;
  justify-content: center;
  height: var(--em-height-button);
  color: var(--em-color-text-inverse);
  font-size: var(--em-font-size-sm);
  font-weight: var(--em-font-weight-bold);
  background: var(--em-color-primary);
  border-radius: var(--em-radius-pill);
  box-shadow: var(--em-shadow-button);
}

.ghost-button {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 72rpx;
  color: var(--em-color-primary);
  font-size: var(--em-font-size-sm);
  font-weight: var(--em-font-weight-bold);
  background: var(--em-color-surface);
  border: var(--em-border-thin) solid rgba(0, 39, 39, 0.28);
  border-radius: var(--em-radius-pill);
}

.surface-card {
  background: rgba(255, 255, 255, 0.94);
  border: var(--em-border-thin) solid var(--em-color-border);
  border-radius: var(--em-radius-xl);
  box-shadow: var(--em-shadow-card);
}

.hairline {
  height: 1rpx;
  background: var(--em-color-border);
}

.retry-button { display:flex; align-items:center; justify-content:center; min-height:44px; padding:20rpx 28rpx; margin:20rpx 0; color:#fff; background:#003b36; border-radius:12rpx; font-size:28rpx; line-height:1.5; }
.loading-notice,.detail-state,.advisor-state { padding:40rpx 32rpx; font-size:28rpx; color:#536262; line-height:1.7; }

/* A neutral placeholder while a course has no approved cover image. */
.course-cover-placeholder { display:flex; flex-direction:column; align-items:center; justify-content:center; width:100%; height:100%; padding:24rpx; background:#ece9e2; color:#7b7e76; text-align:center; }
.cover-label { display:block; font-size:24rpx; line-height:1.6; letter-spacing:3rpx; }
.cover-message { display:block; margin-top:12rpx; font-size:23rpx; line-height:1.6; }
