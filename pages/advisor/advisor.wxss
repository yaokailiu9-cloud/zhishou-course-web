.advisor-page {
  min-height: 100vh;
  padding: 8rpx var(--em-page-x) 182rpx;
  color: var(--em-color-text);
  background: linear-gradient(180deg, #fffefe 0%, var(--em-color-bg) 100%);
}

.advisor-hero {
  display: flex;
  align-items: center;
  gap: 28rpx;
}

.hero-avatar {
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  width: 144rpx;
  height: 144rpx;
  overflow: hidden;
  color: #ffffff;
  font-family: var(--em-font-serif);
  font-size: 56rpx;
  background: var(--em-color-primary);
  border: 4rpx solid var(--em-color-surface);
  border-radius: 50%;
  box-shadow: 0 18rpx 42rpx rgba(0, 39, 39, 0.14);
}

.hero-avatar image {
  width: 100%;
  height: 100%;
}

.hero-copy {
  min-width: 0;
}

.advisor-name {
  display: block;
  color: var(--em-color-primary);
  font-family: var(--em-font-serif);
  font-size: 48rpx;
  font-weight: 600;
  line-height: 1.2;
}

.advisor-title {
  display: block;
  margin-top: 10rpx;
  color: var(--em-color-gold-strong);
  font-size: 23rpx;
  font-weight: var(--em-font-weight-bold);
}

.score-line {
  display: flex;
  gap: 10rpx;
  margin-top: 12rpx;
  color: var(--em-color-text-secondary);
  font-size: 24rpx;
}

.advisor-quote {
  display: block;
  margin: 40rpx 0 26rpx;
  color: var(--em-color-text-secondary);
  font-size: 29rpx;
  font-style: italic;
  line-height: 1.8;
}

.tag-scroll {
  width: 100%;
  white-space: nowrap;
}

.tag-row {
  display: inline-flex;
  gap: 14rpx;
  padding-bottom: 10rpx;
}

.tag {
  display: inline-flex;
  align-items: center;
  height: 50rpx;
  padding: 0 22rpx;
  color: var(--em-color-primary);
  font-size: 24rpx;
  font-weight: var(--em-font-weight-semibold);
  background: var(--em-color-surface-muted);
  border-radius: var(--em-radius-pill);
}

.service-card,
.flow-card,
.notice-card {
  margin-top: 34rpx;
  padding: 34rpx;
  background: var(--em-color-surface);
  border: 1rpx solid var(--em-color-border);
  border-radius: var(--em-radius-xl);
  box-shadow: var(--em-shadow-card);
}

.service-head {
  display: flex;
  justify-content: space-between;
  gap: 20rpx;
}

.service-title,
.section-title {
  margin: 0;
  color: var(--em-color-primary);
  font-family: var(--em-font-serif);
  font-size: 34rpx;
  font-weight: 600;
}

.service-price {
  color: var(--em-color-primary);
  font-family: var(--em-font-serif);
  font-size: 34rpx;
  font-weight: 700;
}

.service-grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 18rpx;
  margin-top: 28rpx;
}

.service-grid view {
  padding: 26rpx;
  background: var(--em-color-surface-muted);
  border-radius: var(--em-radius-lg);
}

.service-label,
.service-value,
.flow-title,
.flow-desc,
.notice-title,
.notice-desc {
  display: block;
}

.service-label {
  color: var(--em-color-text-muted);
  font-size: 24rpx;
}

.service-value {
  margin-top: 10rpx;
  color: var(--em-color-primary);
  font-size: 26rpx;
  font-weight: var(--em-font-weight-bold);
}

.flow-list {
  display: flex;
  flex-direction: column;
  gap: 28rpx;
  margin-top: 28rpx;
}

.flow-item {
  display: flex;
  gap: 22rpx;
}

.flow-num {
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  width: 58rpx;
  height: 58rpx;
  color: var(--em-color-gold-strong);
  font-size: 24rpx;
  font-weight: var(--em-font-weight-bold);
  background: var(--em-color-gold-soft);
  border-radius: 50%;
}

.flow-title,
.notice-title {
  color: var(--em-color-primary);
  font-size: 27rpx;
  font-weight: var(--em-font-weight-bold);
}

.flow-desc,
.notice-desc {
  margin-top: 8rpx;
  color: var(--em-color-text-secondary);
  font-size: 24rpx;
  line-height: 1.6;
}

.notice-card {
  box-shadow: none;
}

.notice-row {
  display: flex;
  gap: 22rpx;
  padding: 22rpx 0;
  border-bottom: 1rpx solid var(--em-color-border);
}

.notice-row:last-child {
  border-bottom: 0;
}

.notice-icon {
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  width: 50rpx;
  height: 50rpx;
  color: var(--em-color-primary);
  font-size: 24rpx;
  font-weight: var(--em-font-weight-bold);
  background: var(--em-color-primary-soft);
  border-radius: 50%;
}

.sticky-pay {
  position: fixed;
  right: 24rpx;
  bottom: calc(28rpx + env(safe-area-inset-bottom));
  left: 24rpx;
  z-index: 20;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 24rpx;
  padding: 28rpx 28rpx;
  background: rgba(255, 255, 255, 0.96);
  border: 1rpx solid var(--em-color-border);
  border-radius: var(--em-radius-xl);
  box-shadow: var(--em-shadow-card-lg);
}

.pay-label {
  display: block;
  color: var(--em-color-text-muted);
  font-size: 21rpx;
  font-weight: var(--em-font-weight-semibold);
}

.pay-price {
  color: var(--em-color-primary);
  font-family: var(--em-font-serif);
  font-size: 42rpx;
  font-weight: 700;
}

.pay-unit {
  color: var(--em-color-text-secondary);
  font-size: 24rpx;
}

.pay-button {
  display: flex;
  align-items: center;
  justify-content: center;
  min-width: 210rpx;
  height: 82rpx;
  color: #ffffff;
  font-size: 25rpx;
  font-weight: var(--em-font-weight-bold);
  background: var(--em-color-primary);
  border-radius: var(--em-radius-pill);
  box-shadow: var(--em-shadow-button);
}

/* A full portrait introduction, with the original biography and service details. */
.advisor-page { padding-top:24rpx; }
.advisor-hero { position:relative; display:block; height:650rpx; overflow:hidden; border-radius:24rpx; background:#003436; }
.hero-avatar { width:100%; height:100%; border:0; border-radius:0; box-shadow:none; }
.hero-copy { position:absolute; inset:0; display:flex; flex-direction:column; justify-content:flex-end; padding:36rpx; background:linear-gradient(180deg,transparent 35%,rgba(0,30,30,.92) 100%); }
.advisor-name { color:#fff; font-size:56rpx; }
.advisor-title { color:#e5ce99; font-weight:500; margin-top:16rpx; }
.score-line { color:#d1ddd7; margin-top:18rpx; }
.advisor-quote { font-family:var(--em-font-serif); color:#38544f; font-size:31rpx; font-style:normal; line-height:1.9; padding:8rpx 0 20rpx; }
.service-card,.flow-card,.notice-card { border-radius:18rpx; box-shadow:none; padding:30rpx; }
.service-price { font-size:26rpx; color:#82704b; line-height:1.6; }
.service-grid view { background:#f6f3ec; border-radius:10rpx; }
.flow-num { border-radius:0; background:transparent; border-top:1rpx solid #b6a16c; font-family:Georgia,serif; font-size:26rpx; }
.tag { background:#f1efe8; border-radius:6rpx; font-weight:400; }
.sticky-pay { right:0; left:0; bottom:0; padding:22rpx 28rpx calc(22rpx + env(safe-area-inset-bottom)); border-radius:0; box-shadow:none; gap:20rpx; }
.sticky-pay > view { flex:1; min-width:0; }
.pay-price { display:block; font-family:var(--em-font-family); font-size:25rpx; font-weight:500; line-height:1.6; margin-top:8rpx; }
.pay-button { min-width:0; width:250rpx; flex-shrink:0; border-radius:12rpx; box-shadow:none; }
