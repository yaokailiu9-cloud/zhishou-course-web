@import "../../styles/course-components.wxss";
.access-step { display:block; margin:8rpx 0 12rpx; font-size:26rpx; font-weight:600; color:#002727; }
.access-choice { justify-content:flex-start !important; text-align:left; }
.access-choice.on { color:#fff !important; background:#003436 !important; border-color:#003436 !important; }
.access-picked { display:block; margin:8rpx 0 16rpx; font-size:25rpx; color:#3e4c4c; }
.access-grant-meta { display:block; margin-top:8rpx; font-size:23rpx; line-height:1.6; color:#5b6767; }
.pill.active { color:#fff; background:#2f6b58; }
.pill.ended { color:#5b6767; background:#eceeec; }
