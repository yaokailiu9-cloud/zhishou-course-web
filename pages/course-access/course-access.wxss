@import "../../styles/course-components.wxss";
.access-card { padding:28rpx; }
.access-head { display:flex; align-items:center; gap:14rpx; margin-bottom:20rpx; }
.access-num { flex:0 0 auto; width:40rpx; height:40rpx; line-height:40rpx; border-radius:50%; background:#003436; color:#fff; font-size:22rpx; font-weight:600; text-align:center; }
.access-title { flex:1; font-size:29rpx; font-weight:600; color:#002727; }
.access-chosen { max-width:46%; overflow:hidden; text-overflow:ellipsis; white-space:nowrap; padding:6rpx 16rpx; border-radius:999rpx; background:#e7efe9; color:#2f6b58; font-size:23rpx; }
.access-search { display:flex; gap:14rpx; align-items:center; }
.access-page .access-search-input { flex:1; min-width:0; height:80rpx; margin:0; padding:0 22rpx; border:1rpx solid #deded7; border-radius:12rpx; background:#fcfbf8; font-size:27rpx; box-sizing:border-box; }
.access-page .access-search-button { flex:0 0 auto; width:auto; min-height:80rpx; height:80rpx; margin:0; padding:0 30rpx; border-radius:12rpx; background:#003436; color:#fff; font-size:26rpx; }
.access-page .access-search-button[disabled] { background:#b9c3bf; }
.access-list { max-height:560rpx; margin-top:18rpx; border:1rpx solid #ebe7e1; border-radius:14rpx; overflow-y:auto; }
.access-person { display:flex; align-items:center; gap:18rpx; padding:18rpx 20rpx; border-bottom:1rpx solid #f0ede8; cursor:pointer; }
.access-person:last-child { border-bottom:none; }
.access-person.on { background:#eef4f0; }
.access-avatar { flex:0 0 auto; width:60rpx; height:60rpx; line-height:60rpx; border-radius:50%; background:#f1ece2; color:#735c27; text-align:center; font-size:26rpx; font-weight:600; }
.access-person.on .access-avatar { background:#003436; color:#fff; }
.access-person-copy { flex:1; min-width:0; }
.access-person-name { display:block; font-size:28rpx; color:#002727; overflow:hidden; text-overflow:ellipsis; white-space:nowrap; }
.access-person-meta { display:block; margin-top:4rpx; font-size:22rpx; color:#7a8484; }
.access-check { flex:0 0 auto; width:40rpx; height:40rpx; line-height:40rpx; border-radius:50%; border:2rpx solid #d6d9d3; color:#fff; text-align:center; font-size:24rpx; box-sizing:border-box; }
.access-person.on .access-check { background:#2f6b58; border-color:#2f6b58; }
.access-hint { display:block; margin-top:16rpx; font-size:24rpx; line-height:1.7; color:#7a8484; }
.access-select { display:flex; align-items:center; gap:16rpx; min-height:84rpx; padding:0 24rpx; border:1rpx solid #deded7; border-radius:12rpx; background:#fcfbf8; box-sizing:border-box; }
.access-select-text { flex:1; min-width:0; font-size:28rpx; color:#002727; overflow:hidden; text-overflow:ellipsis; white-space:nowrap; }
.access-select.placeholder .access-select-text { color:#9aa3a1; }
.access-select-arrow { flex:0 0 auto; font-size:30rpx; color:#717878; line-height:1; margin-top:-10rpx; }
.access-warn { display:block; margin-top:16rpx; padding:14rpx 18rpx; border-radius:10rpx; background:#fbf3e2; color:#8a6420; font-size:23rpx; line-height:1.6; }
.access-segment { display:flex; gap:8rpx; padding:8rpx; border-radius:16rpx; background:#f1f1ec; }
.access-segment-item { flex:1; display:flex; flex-direction:column; align-items:center; justify-content:center; min-height:92rpx; border-radius:12rpx; color:#3e4c4c; cursor:pointer; }
.access-segment-item.on { background:#003436; color:#fff; box-shadow:0 4rpx 12rpx rgba(0,52,54,.18); }
.access-segment-main { font-size:29rpx; font-weight:600; line-height:1.3; }
.access-segment-sub { font-size:21rpx; opacity:.75; line-height:1.4; }
.access-summary { display:flex; flex-wrap:wrap; align-items:center; gap:8rpx; margin:24rpx 0 4rpx; font-size:24rpx; color:#5b6767; }
.access-summary-dot { color:#b8bfbd; }
.access-page .access-submit { margin:16rpx 0 0; border-radius:14rpx; }
.access-records-head { display:flex; align-items:baseline; justify-content:space-between; margin:40rpx 4rpx 4rpx; }
.access-records-title { font-size:29rpx; font-weight:600; color:#002727; }
.access-records-count { font-size:23rpx; color:#7a8484; }
.access-record { padding:26rpx 28rpx; margin:18rpx 0; }
.access-record-course { display:block; margin-top:6rpx; font-size:25rpx; color:#3e4c4c; }
.access-record-grid { display:grid; grid-template-columns:auto 1fr; column-gap:20rpx; row-gap:6rpx; margin-top:16rpx; padding-top:16rpx; border-top:1rpx solid #f0ede8; font-size:23rpx; line-height:1.6; }
.access-record-label { color:#9aa3a1; }
.access-record-value { color:#3e4c4c; }
.access-page .access-revoke { width:auto; min-height:64rpx; margin:16rpx 0 0 auto; padding:0 24rpx; border:1rpx solid #e2c7bf; border-radius:999rpx; background:#fff; color:#9a4a3a; font-size:24rpx; }
.access-empty { margin:16rpx 0; padding:48rpx 24rpx; border:1rpx dashed #ddd8cf; border-radius:16rpx; text-align:center; color:#9aa3a1; font-size:25rpx; }
.pill.active { color:#fff; background:#2f6b58; }
.pill.ended { color:#5b6767; background:#eceeec; }
