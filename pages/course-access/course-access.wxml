<view class="service-page course-page access-page"><view class="service-hero"><text class="eyebrow">管理工作台</text><text class="page-title">课程观看授权</text><text class="muted">为指定家长开通一节课，选 1 天或 2 天，从开通时开始计时，到期自动关闭。家长端不显示期限。</text></view>
<view wx:if="{{error}}" class="error"><text>{{error}}</text><button bindtap="refresh">重试</button></view>
<block wx:if="{{allowed}}">
<view class="card access-card"><view class="access-head"><text class="access-num">1</text><text class="access-title">选择家长</text><text wx:if="{{viewer.id}}" class="access-chosen">{{viewer.name}}</text></view>
<view class="access-search"><input class="access-search-input" value="{{keyword}}" placeholder="姓名、昵称或手机号" bindinput="inputKeyword" bindconfirm="search" confirm-type="search"/><button class="access-search-button" bindtap="search" disabled="{{searching}}">{{searching ? '查找中' : '查找'}}</button></view>
<scroll-view wx:if="{{candidates.length}}" class="access-list" scroll-y><view wx:for="{{candidates}}" wx:key="id" class="access-person {{viewer.id === item.id ? 'on' : ''}}" data-id="{{item.id}}" data-name="{{item.name}}" bindtap="pickViewer"><text class="access-avatar">{{item.initial}}</text><view class="access-person-copy"><text class="access-person-name">{{item.name}}</text><text wx:if="{{item.metaText}}" class="access-person-meta">{{item.metaText}}</text></view><text class="access-check">{{viewer.id === item.id ? '✓' : ''}}</text></view></scroll-view>
<text wx:elif="{{searched}}" class="access-hint">没有找到匹配的家长，请确认对方已登录过网站。</text>
<text wx:else class="access-hint">输入姓名或手机号后点“查找”；不填直接查找可列出最近登录的用户。</text></view>
<view class="card access-card"><view class="access-head"><text class="access-num">2</text><text class="access-title">选择课程</text></view>
<picker range="{{courseOptions}}" value="{{courseIndex >= 0 ? courseIndex : 0}}" bindchange="pickCourse"><view class="access-select {{courseIndex >= 0 ? '' : 'placeholder'}}"><text class="access-select-text">{{courseIndex >= 0 ? courses[courseIndex].title : '点击选择课程'}}</text><text class="access-select-arrow">⌄</text></view></picker>
<text wx:if="{{courseIndex >= 0 && !courses[courseIndex].hasVideo}}" class="access-warn">这节课还没有上传视频，开通后家长暂时看不到内容。</text></view>
<view class="card access-card"><view class="access-head"><text class="access-num">3</text><text class="access-title">选择时长</text></view>
<view class="access-segment"><view class="access-segment-item {{hours === 24 ? 'on' : ''}}" data-hours="24" bindtap="pickHours"><text class="access-segment-main">1 天</text><text class="access-segment-sub">24 小时</text></view><view class="access-segment-item {{hours === 48 ? 'on' : ''}}" data-hours="48" bindtap="pickHours"><text class="access-segment-main">2 天</text><text class="access-segment-sub">48 小时</text></view></view>
<view class="access-summary"><text>{{viewer.id ? viewer.name : '未选家长'}}</text><text class="access-summary-dot">·</text><text>{{courseIndex >= 0 ? courses[courseIndex].title : '未选课程'}}</text><text class="access-summary-dot">·</text><text>{{hours === 48 ? '2 天' : '1 天'}}</text></view>
<button class="primary access-submit" bindtap="grant" disabled="{{saving || !viewer.id || courseIndex < 0}}">{{saving ? '正在开通…' : '开通观看'}}</button></view>
<view class="access-records-head"><text class="access-records-title">开通记录</text><text wx:if="{{grants.length}}" class="access-records-count">{{grants.length}} 条</text></view>
<view wx:for="{{grants}}" wx:key="id" class="card access-record"><view class="row"><text class="card-title">{{item.viewerName}}</text><text class="pill {{item.status === 'ACTIVE' ? 'active' : 'ended'}}">{{item.statusText}}</text></view>
<text class="access-record-course">《{{item.courseTitle}}》 · {{item.durationText}}</text>
<view class="access-record-grid"><text class="access-record-label">开通</text><text class="access-record-value">{{item.grantedText}}</text><text class="access-record-label">到期</text><text class="access-record-value">{{item.expiresText}}</text><block wx:if="{{item.revokedText}}"><text class="access-record-label">收回</text><text class="access-record-value">{{item.revokedText}}</text></block><text class="access-record-label">开通人</text><text class="access-record-value">{{item.grantedByName || '管理人员'}}</text></view>
<button wx:if="{{item.status === 'ACTIVE'}}" class="access-revoke" data-id="{{item.id}}" bindtap="revoke">提前收回</button></view>
<view wx:if="{{!loading && !grants.length}}" class="access-empty">还没有开通记录</view><button wx:if="{{nextCursor}}" class="secondary" bindtap="more" disabled="{{loading}}">加载更多</button>
</block><text wx:if="{{loading}}" class="muted">正在加载…</text><button wx:if="{{!loading && !allowed && !error}}" class="primary" bindtap="refresh">登录并核实管理人员身份</button></view>
