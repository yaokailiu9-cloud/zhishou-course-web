<view class="service-page course-page"><view class="service-hero"><text class="eyebrow">课程工作台</text><text class="page-title">把一堂课，准备好</text><text class="muted">发布场次、邀请报名、联系进群，再核实实际到课。</text></view>
<view wx:if="{{error}}" class="error"><text>{{error}}</text><button bindtap="refresh">重试</button></view>
<block wx:if="{{allowed}}"><button class="primary" bindtap="create">＋ 新建免费公开课</button><input value="{{search}}" placeholder="搜索课程名称或城市" bindinput="inputSearch" bindconfirm="refresh" confirm-type="search"/><button class="text-button" bindtap="refresh">搜索</button>
<view wx:for="{{classes}}" wx:key="id" class="card course-card"><image wx:if="{{item.coverUrl}}" class="course-cover" src="{{item.coverUrl}}" mode="aspectFill"/><view class="course-card-content"><view class="row"><text class="card-title">{{item.title}}</text><text class="pill">{{item.statusText}}</text></view><text class="course-meta">{{item.timeText}} · {{item.city || '城市待补充'}}</text><text class="course-meta">{{item.reserved_count || 0}} 人已报名 · {{item.capacity ? item.capacity + ' 个名额' : '不限名额'}}</text><view class="entry-grid"><button class="secondary" data-id="{{item.id}}" bindtap="edit">编辑课程</button><button class="primary" data-id="{{item.id}}" bindtap="roster">名单与扫码入场</button></view><button wx:if="{{item.status !== 'DRAFT'}}" class="text-button" data-id="{{item.id}}" open-type="share">微信分享课程</button></view></view>
<view wx:if="{{!loading && !classes.length}}" class="empty">还没有匹配的课程。新建场次后，保存草稿或发布到首页公开课入口。</view><button wx:if="{{nextCursor}}" class="secondary" bindtap="more" disabled="{{loading}}">加载更多</button></block><text wx:if="{{loading}}" class="muted">正在加载课程…</text><button wx:if="{{!loading && !allowed && !error}}" class="primary" bindtap="refresh">登录并核实工作人员身份</button></view>
