.detail-page {
  min-height: 100vh;
  box-sizing: border-box;
  background: #fbf9f8;
  color: #002727;
}

.detail-nav {
  position: fixed;
  top: 0;
  right: 0;
  left: 0;
  z-index: 30;
  box-sizing: border-box;
  padding: 0;
  background: rgba(251, 249, 248, 0.9);
  backdrop-filter: blur(18px);
}

.nav-back {
  position: absolute;
  bottom: 12rpx;
  left: 40rpx;
  z-index: 2;
  display: flex;
  align-items: center;
  justify-content: flex-start;
  width: 56rpx;
  height: 64rpx;
  padding: 0;
  margin: 0;
  color: #002727;
  font-size: 44rpx;
  font-weight: 400;
  line-height: 1;
  background: transparent;
  border-radius: 0;
  box-shadow: none;
}

.nav-back::after,
.primary-action::after {
  border: none;
}

.nav-title {
  position: absolute;
  right: 0;
  bottom: 12rpx;
  left: 0;
  height: 64rpx;
  color: #002727;
  font-size: 30rpx;
  font-weight: 800;
  line-height: 64rpx;
  text-align: center;
  pointer-events: none;
}

.detail-body {
  box-sizing: border-box;
  padding: 0 28rpx 180rpx;
}

.detail-hero,
.state-card,
.info-grid,
.message-list {
  border: 1rpx solid rgba(0, 39, 39, 0.08);
  border-radius: 28rpx;
  background: #fff;
  box-shadow: 0 12rpx 30rpx rgba(0, 39, 39, 0.06);
}

.detail-hero {
  display: flex;
  gap: 20rpx;
  align-items: flex-start;
  padding: 28rpx;
}

.client-avatar,
.message-avatar {
  width: 60rpx;
  height: 60rpx;
  flex: 0 0 60rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  overflow: hidden;
  border-radius: 50%;
  background: #eaf2f1;
  color: #002727;
  font-size: 26rpx;
  font-weight: 800;
}

.avatar-image {
  width: 100%;
  height: 100%;
}

.hero-main {
  flex: 1;
  min-width: 0;
}

.client-line {
  display: flex;
  align-items: center;
  gap: 14rpx;
  min-width: 0;
}

.client-name {
  max-width: 220rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  font-size: 32rpx;
  font-weight: 800;
}

.tag-pill,
.status-pill {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  min-height: 44rpx;
  padding: 0 18rpx;
  border-radius: 999rpx;
  background: #eaf2f1;
  color: #002727;
  font-size: 23rpx;
  font-weight: 700;
  white-space: nowrap;
}

.status-pill.orange {
  background: #fff1c6;
  color: #7a5800;
}

.status-pill.blue {
  background: #dcf5ef;
  color: #00634e;
}

.status-pill.gray {
  background: #f1efee;
  color: #717878;
}

.order-title {
  display: block;
  margin-top: 12rpx;
  color: #717878;
  font-size: 27rpx;
  line-height: 1.5;
}

.info-grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 18rpx;
  margin-top: 22rpx;
  margin-bottom: 22rpx;
  padding: 24rpx;
}

.info-item {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
  padding: 18rpx;
  border-radius: 20rpx;
  background: #f7f4f2;
}

.info-item.wide {
  grid-column: span 2;
}

.info-label {
  color: #717878;
  font-size: 23rpx;
}

.info-value {
  overflow-wrap: anywhere;
  font-size: 29rpx;
  font-weight: 800;
}

.records-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
  padding-bottom: 20rpx;
  margin-bottom: 8rpx;
  border-bottom: 1rpx solid rgba(0, 39, 39, 0.06);
}

.section-title {
  flex: 1;
  min-width: 0;
  font-size: 32rpx;
  font-weight: 800;
}

.text-action {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  flex: none;
  height: 52rpx;
  padding: 0 22rpx;
  color: #002727;
  font-size: 23rpx;
  font-weight: 700;
  line-height: 1;
  white-space: nowrap;
  background: #eaf2f1;
  border-radius: 999rpx;
}

.message-list {
  min-height: 240rpx;
  padding: 24rpx;
}

.message-row {
  display: flex;
  align-items: flex-start;
  gap: 14rpx;
  margin-bottom: 22rpx;
}

.message-row.user {
  justify-content: flex-end;
}

.message-avatar.user {
  background: #002727;
  color: #fff;
}

.bubble {
  max-width: 500rpx;
  padding: 18rpx 22rpx;
  border-radius: 24rpx;
  background: #f2efed;
  color: #1f3030;
  font-size: 27rpx;
  line-height: 1.55;
}

.message-row.user .bubble {
  background: #002727;
  color: #fff;
}

.state-card {
  margin-top: 24rpx;
  padding: 42rpx 28rpx;
  color: #717878;
  text-align: center;
  font-size: 27rpx;
}

.state-card.compact {
  margin-top: 0;
  padding: 30rpx 20rpx;
  box-shadow: none;
}

.primary-action {
  height: 88rpx;
  margin: 0;
  border-radius: 999rpx;
  background: #002727;
  color: #fff;
  font-size: 30rpx;
  font-weight: 800;
  line-height: 88rpx;
}

.fixed-action {
  position: fixed;
  right: 28rpx;
  bottom: calc(34rpx + env(safe-area-inset-bottom));
  left: 28rpx;
  z-index: 5;
}
