<view class="search-page safe-bottom">
 <view class="search-bar"><view class="search-field"><view class="search-lens"></view><input class="search-input" placeholder="{{mode === 'courses' ? '搜索课程名称或主题' : '搜索专家姓名或擅长方向'}}" value="{{keyword}}" focus="{{true}}" confirm-type="search" maxlength="80" bindinput="onKeywordInput"/><button wx:if="{{keyword}}" class="search-clear" aria-label="清空搜索" bindtap="clearKeyword">×</button></view></view>
 <view wx:if="{{loading}}" class="search-hint"><text>正在加载搜索内容…</text></view>
 <view wx:elif="{{error}}" class="search-empty"><text>{{error}}</text><button class="retry-button" bindtap="refresh">重新加载</button></view>
 <view wx:elif="{{!searched}}" class="search-hint"><text class="hint-desc">{{mode === 'courses' ? '输入课程名称或主题。' : '输入专家姓名、擅长方向或你正在困扰的问题。'}}</text></view>
 <view wx:elif="{{!results.length}}" class="search-empty"><text class="empty-title">{{mode === 'courses' ? '没有找到相关课程' : '没有找到相关专家'}}</text><text class="empty-desc">换个关键词试试。</text></view>
 <view wx:else class="result-list"><navigator wx:for="{{results}}" wx:key="id" class="result-card" url="{{item.detailUrl}}"><view class="result-avatar"><image wx:if="{{mode === 'courses' ? item.coverUrl : item.imageUrl}}" src="{{mode === 'courses' ? item.coverUrl : item.imageUrl}}" mode="aspectFill"/><view wx:else class="course-cover-placeholder"><text class="cover-message">{{mode === 'courses' ? '课程' : '知守'}}</text></view></view><view class="result-body"><text class="result-name">{{mode === 'courses' ? item.title : item.name}}</text><text class="result-role">{{mode === 'courses' ? item.subtitle : item.title}}</text><view wx:if="{{mode !== 'courses'}}" class="result-tags"><text wx:for="{{item.displayTags}}" wx:for-item="tag" wx:key="*this" class="result-tag">{{tag}}</text></view></view><text>›</text></navigator></view>
</view>
