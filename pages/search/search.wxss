.search-page {
  min-height: 100vh;
  padding: 24rpx var(--em-page-x) 60rpx;
  background: #fbf9f8;
  font-family: var(--em-font-family);
}

.search-bar {
  width: 100%;
}

.search-field {
  display: flex;
  align-items: center;
  width: 100%;
  height: 96rpx;
  padding: 0 32rpx;
  background: var(--em-color-surface);
  border: 1rpx solid var(--em-color-border);
  border-radius: var(--em-radius-pill);
  box-shadow: 0 10rpx 34rpx rgba(0, 39, 39, 0.06);
}

.search-lens {
  position: relative;
  flex-shrink: 0;
  width: 32rpx;
  height: 32rpx;
  margin-right: 24rpx;
  border: 4rpx solid #a7adad;
  border-radius: 50%;
}

.search-lens::after {
  position: absolute;
  right: -13rpx;
  bottom: -8rpx;
  width: 18rpx;
  height: 4rpx;
  content: "";
  background: #a7adad;
  border-radius: 4rpx;
  transform: rotate(45deg);
}

.search-input {
  flex: 1;
  min-width: 0;
  color: var(--em-color-primary);
  font-size: 28rpx;
  font-weight: 600;
}

.search-placeholder {
  color: var(--em-color-text-placeholder);
  font-weight: 600;
}

.search-clear {
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  width: 44rpx;
  height: 44rpx;
  margin-left: 16rpx;
  color: var(--em-color-text-secondary);
  font-size: 32rpx;
  background: var(--em-color-surface-muted);
  border-radius: 50%;
}

.search-hint,
.search-empty {
  padding: 80rpx 12rpx 0;
  text-align: center;
}

.hint-title,
.empty-title {
  display: block;
  color: var(--em-color-primary);
  font-family: var(--em-font-serif);
  font-size: 34rpx;
  font-weight: 600;
}

.hint-desc,
.empty-desc {
  display: block;
  max-width: 520rpx;
  margin: 18rpx auto 0;
  color: var(--em-color-text-secondary);
  font-size: 26rpx;
  line-height: 1.65;
}

.result-list {
  display: flex;
  flex-direction: column;
  gap: 22rpx;
  margin-top: 30rpx;
}

.result-card {
  display: flex;
  align-items: center;
  gap: 22rpx;
  padding: 26rpx;
  background: var(--em-color-surface);
  border: 1rpx solid var(--em-color-border);
  border-radius: var(--em-radius-xl);
  box-shadow: var(--em-shadow-card);
}

.result-avatar {
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  width: 108rpx;
  height: 108rpx;
  overflow: hidden;
  color: var(--em-color-text-inverse);
  font-family: var(--em-font-serif);
  font-size: 40rpx;
  background: linear-gradient(135deg, #1a3d3d, #84a8a7);
  border-radius: 28rpx;
}

.result-avatar image {
  width: 100%;
  height: 100%;
}

.result-body {
  flex: 1;
  min-width: 0;
}

.result-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
}

.result-name {
  overflow: hidden;
  color: var(--em-color-primary);
  font-family: var(--em-font-serif);
  font-size: 32rpx;
  font-weight: 600;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.result-rating {
  flex-shrink: 0;
  color: var(--em-color-gold-strong);
  font-size: 24rpx;
  font-weight: 800;
}

.result-role {
  display: block;
  margin-top: 8rpx;
  color: var(--em-color-text-secondary);
  font-size: 24rpx;
  font-weight: 600;
}

.result-tags {
  display: flex;
  flex-wrap: wrap;
  gap: 10rpx;
  margin-top: 14rpx;
}

.result-tag {
  display: inline-flex;
  align-items: center;
  height: 40rpx;
  padding: 0 14rpx;
  color: var(--em-color-primary);
  font-size: 24rpx;
  font-weight: 700;
  background: var(--em-color-surface-muted);
  border-radius: var(--em-radius-pill);
}

.search-clear { flex:0 0 44px; width:44px; height:44px; min-height:44px; }
