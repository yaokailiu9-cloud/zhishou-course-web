<view class="service-page">
 <view class="error" wx:if="{{error}}"><text>{{error}}</text><button bindtap="refresh">重新加载</button></view><text wx:if="{{loading}}" class="muted">正在加载咨询资料…</text>
 <block wx:if="{{appointment}}">
  <view class="service-hero member-hero"><text class="eyebrow">线下咨询 · {{appointment.statusText}}</text><text class="page-title">{{appointment.child_info.name || appointment.contact_name}}的沟通记录</text><text class="muted">负责老师：{{appointment.provider.display_name || '待安排'}}</text></view>
  <view class="card record-section"><text class="section-title">预约安排</text><text class="body">{{appointment.status === 'PENDING' ? '期望时间：' + appointment.requested_time : '咨询时间：' + appointment.timeText}}</text><text class="muted">{{appointment.concerns}}</text><text class="body" wx:if="{{appointment.staff_note}}">{{appointment.staff_note}}</text><text class="notice" wx:if="{{appointment.status === 'PENDING'}}">申请已提交，工作人员确认时间后才算预约成功。</text>
   <block wx:if="{{canAccept && appointment.status === 'PENDING'}}"><picker mode="date" bindchange="dateChange"><view class="picker-field">{{confirmDate || '选择确认日期'}}</view></picker><picker mode="time" bindchange="timeChange"><view class="picker-field">{{confirmTime || '选择确认时间'}}</view></picker><textarea placeholder="预约说明、到店指引" value="{{staffNote}}" bindinput="noteChange" maxlength="2000"/><button class="primary" disabled="{{busy}}" bindtap="confirmAppointment">确认预约时间</button></block>
   <button wx:if="{{appointment.status === 'PENDING' || appointment.status === 'CONFIRMED'}}" class="text-button" disabled="{{busy}}" bindtap="cancelAppointment">取消本次预约</button>
  </view>
  <view wx:if="{{appointment.status === 'CONFIRMED' || appointment.child_info}}" class="card record-section"><text class="section-title">孩子基础信息</text>
   <block wx:if="{{!isStaff && appointment.status === 'CONFIRMED'}}"><text class="muted">请在到店前填写。本次信息与本次预约关联保存。</text><text class="field-label">孩子姓名或称呼</text><input placeholder="孩子姓名或称呼" value="{{childForm.name}}" data-key="name" bindinput="inputChild" maxlength="60"/><text class="field-label">年龄（0–30岁）</text><input placeholder="年龄" type="number" value="{{childForm.age}}" data-key="age" bindinput="inputChild" maxlength="2"/><text class="field-label">年级（选填）</text><input placeholder="年级（选填）" value="{{childForm.grade}}" data-key="grade" bindinput="inputChild" maxlength="60"/><text class="field-label">家长姓名</text><input placeholder="家长姓名" value="{{childForm.guardian}}" data-key="guardian" bindinput="inputChild" maxlength="60"/><text class="field-label">与孩子关系</text><input placeholder="与孩子关系" value="{{childForm.relationship}}" data-key="relationship" bindinput="inputChild" maxlength="60"/><text class="field-label">联系电话</text><input placeholder="联系电话" type="number" value="{{childForm.phone}}" data-key="phone" bindinput="inputChild" maxlength="11"/><text class="field-label">当前主要困扰</text><textarea placeholder="当前主要困扰" value="{{childForm.concerns}}" data-key="concerns" bindinput="inputChild" maxlength="4000"/><text class="field-label">希望本次沟通解决的问题（选填）</text><textarea placeholder="希望本次沟通解决的问题（选填）" value="{{childForm.goals}}" data-key="goals" bindinput="inputChild" maxlength="2000"/><button class="primary" loading="{{busy}}" disabled="{{busy}}" bindtap="saveChild">保存基础信息</button></block>
   <block wx:elif="{{appointment.child_info}}"><text class="body">{{appointment.child_info.name}} · {{appointment.child_info.age}}岁 · {{appointment.child_info.grade}}</text><text class="muted">{{appointment.child_info.guardian}}（{{appointment.child_info.relationship}}） · {{appointment.child_info.phone}}</text><text class="body">{{appointment.child_info.concerns}}</text><text class="muted">沟通期待：{{appointment.child_info.goals || '未填写'}}</text></block><text wx:else class="muted">等待家长填写基础信息。</text>
  </view>
  <view wx:if="{{appointment.status === 'CONFIRMED' || appointment.status === 'COMPLETED'}}" class="card record-section"><text class="section-title">沟通总结</text><text class="muted">本页本次咨询的留言、反馈与老师回复可生成文字草稿，也支持经同意录制面谈。由老师检查确认后形成正式记录。</text><button class="secondary" disabled="{{summaryBusy || recording}}" loading="{{summaryBusy}}" bindtap="summarizeText">总结本次文字沟通</button><button wx:if="{{!recording}}" class="secondary" disabled="{{summaryBusy}}" bindtap="startRecording">经同意录制面谈</button><button wx:else class="primary" bindtap="stopRecording">录音中 {{recordingSeconds}} 秒 · 停止并总结</button><text wx:if="{{recording}}" class="muted">单段最长10分钟，可分段录制。离开页面会停止录音。</text>
   <view wx:for="{{summaryJobs}}" wx:key="id" class="task"><text class="muted">{{item.source === 'AUDIO' ? '面谈录音' : '文字聊天'}} · {{item.statusText}} · {{item.createdText}}</text><text class="body" wx:if="{{item.draft}}">{{item.draft}}</text><text class="error" wx:if="{{item.error_message}}">{{item.error_message}}</text><button wx:if="{{item.status === 'FAILED'}}" class="text-button" data-id="{{item.id}}" bindtap="retrySummary" disabled="{{busy}}">重新生成</button><button wx:if="{{item.status === 'UPLOADING'}}" class="text-button" data-id="{{item.id}}" bindtap="processRecording" disabled="{{busy}}">处理已上传录音</button><button wx:if="{{canReply && item.draft && (!record || record.status !== 'CONFIRMED')}}" class="text-button" data-id="{{item.id}}" bindtap="useSummary">填入老师记录，继续编辑</button></view><button wx:if="{{summaryJobs.length}}" class="text-button" bindtap="refreshSummary">刷新总结进度</button><text wx:if="{{summaryJobs.length}}" class="muted">{{nextSummaryCursor ? '已加载' : '共'}} {{summaryJobs.length}} 条总结</text><button wx:if="{{nextSummaryCursor}}" class="secondary" data-kind="summary" bindtap="moreHistory" disabled="{{moreLoading || loading}}">查看更多总结</button>
  </view>
  <view wx:if="{{record || canReply}}" class="card record-section"><text class="section-title">本次沟通与执行建议</text>
   <block wx:if="{{canReply && (!record || record.status !== 'CONFIRMED') && (appointment.status === 'CONFIRMED' || appointment.status === 'COMPLETED')}}"><text class="field-label">今天沟通的主要内容</text><textarea placeholder="今天沟通的主要内容" value="{{recordForm.summary}}" data-key="summary" bindinput="inputRecord" maxlength="16000"/><text class="field-label">给家长的具体执行建议，每行一条</text><text class="muted">最多30条，每条最多2000字。</text><textarea placeholder="给家长的具体执行建议，每行一条" value="{{recordForm.advice}}" data-key="advice" bindinput="inputRecord" maxlength="16000"/><button class="secondary" data-confirm="false" disabled="{{busy}}" bindtap="saveRecord">保存草稿</button><button class="primary" data-confirm="true" disabled="{{busy}}" bindtap="saveRecord">确认记录并给家长查看</button></block>
   <block wx:elif="{{record}}"><text class="body">{{record.summary}}</text><view wx:for="{{record.advice}}" wx:key="key" class="task"><text class="body">{{index + 1}}. {{item.content}}</text></view></block>
   <button wx:if="{{canReply && record.status === 'CONFIRMED' && appointment.status === 'CONFIRMED'}}" class="primary" disabled="{{busy}}" bindtap="complete">确认本次咨询已完成</button>
  </view>
  <view wx:if="{{!isStaff && record.status === 'CONFIRMED' && (appointment.status === 'CONFIRMED' || appointment.status === 'COMPLETED')}}" class="card record-section"><text class="section-title">反馈执行情况</text><picker range="{{record.advice}}" range-key="content" value="{{adviceIndex}}" bindchange="chooseAdvice"><view class="picker-field">{{record.advice[adviceIndex].content || '选择执行建议'}}</view></picker><textarea placeholder="我是怎么做的？孩子有什么反应？遇到了什么困难？" value="{{feedbackContent}}" bindinput="inputFeedback" maxlength="6000"/><button class="primary" disabled="{{busy}}" bindtap="sendFeedback">提交本次反馈</button></view>
  <view wx:if="{{!isStaff && (appointment.status === 'CONFIRMED' || appointment.status === 'COMPLETED')}}" class="card record-section"><text class="section-title">本次咨询留言</text><text class="muted">补充想和老师沟通的情况，老师可在下方回复。</text><textarea placeholder="想补充的情况或问题" value="{{noteContent}}" bindinput="inputNote" maxlength="6000"/><button class="secondary" disabled="{{busy}}" bindtap="sendNote">发送留言</button></view>
  <text class="section-title">沟通、执行反馈与老师回复</text><view wx:for="{{feedbacks}}" wx:key="id" class="card"><text class="muted">{{item.createdText}} · {{item.statusText === '待确认' ? '待回复' : item.statusText}}</text><text class="body">{{item.content}}</text><view wx:for="{{item.replies}}" wx:for-item="reply" wx:key="id" class="reply"><text class="muted">{{reply.author.display_name || '老师'}}回复</text><text class="body">{{reply.content}}</text></view><block wx:if="{{canReply}}"><textarea placeholder="回复这条执行反馈" data-id="{{item.id}}" value="{{replyContents[item.id]}}" bindinput="inputReply" maxlength="6000"/><button class="secondary" disabled="{{busy}}" data-id="{{item.id}}" bindtap="sendReply">回复家长</button></block></view><view wx:if="{{!feedbacks.length}}" class="empty">还没有沟通记录。预约确认后可留言，老师确认建议后可持续反馈。</view>
 <text wx:if="{{feedbacks.length}}" class="muted">{{nextFeedbackCursor ? '已加载' : '共'}} {{feedbacks.length}} 条沟通记录</text><button wx:if="{{nextFeedbackCursor}}" class="secondary" data-kind="feedback" bindtap="moreHistory" disabled="{{moreLoading || loading}}">查看更多沟通记录</button>
 </block><button class="text-button" bindtap="backToCustomer">返回</button>
</view>
