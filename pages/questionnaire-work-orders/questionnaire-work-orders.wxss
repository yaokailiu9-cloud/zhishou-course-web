@import "../../styles/course-components.wxss";
.work-orders-page{padding-bottom:90rpx}.tabs{display:grid;grid-template-columns:repeat(4,1fr);gap:10rpx;margin:8rpx 0 28rpx;padding:8rpx;background:#eeece7;border-radius:18rpx}.tab{display:flex;flex-direction:column;align-items:center;justify-content:center;min-height:82rpx;color:#737b79;font-size:23rpx;border-radius:14rpx}.tab.active{color:#fff;background:#123b35;box-shadow:0 8rpx 18rpx rgba(0,39,39,.13)}.tab-count{margin-top:4rpx;font-size:19rpx;opacity:.8}.ticket{padding:30rpx 30rpx 24rpx;margin:18rpx 0;background:#fff;border:1rpx solid var(--em-color-border);border-radius:22rpx;box-shadow:0 12rpx 32rpx rgba(0,39,39,.045)}.ticket-top,.ticket-bottom{display:flex;align-items:center;justify-content:space-between;gap:18rpx}.ticket-person{min-width:0}.ticket-name{display:block;color:#123b35;font-size:32rpx;font-weight:700;line-height:1.45}.ticket-parent{display:block;margin-top:8rpx;color:#717878;font-size:24rpx}.status{flex:0 0 auto;padding:10rpx 16rpx;font-size:21rpx;border-radius:10rpx}.status-PENDING{color:#785f27;background:#f6eedb}.status-DRAFT{color:#285f51;background:#e6f0ec}.status-CONFIRMED{color:#52605d;background:#edf0ef}.ticket-bottom{padding-top:22rpx;margin-top:22rpx;color:#717878;font-size:23rpx;border-top:1rpx solid #ece8e2}.ticket-link{color:#285f51;font-weight:700}.more{margin-top:24rpx}
