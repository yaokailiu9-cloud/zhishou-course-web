@import "../../styles/course-components.wxss";
.questionnaire-page{padding-bottom:100rpx}.questionnaire-hero{padding:24rpx 8rpx 34rpx}.price-card{display:flex;align-items:center;justify-content:space-between;gap:24rpx}.price{flex-shrink:0;color:#8a6f2b;font-family:var(--em-font-serif);font-size:64rpx;font-weight:800}.price text{font-size:28rpx}.pay-button{margin-top:28rpx}.privacy-tip{display:block;padding:20rpx 18rpx;text-align:center;line-height:1.6}.form-card input,.form-card textarea,.questionnaire-page .card>input{box-sizing:border-box;width:100%;margin-top:14rpx;padding:24rpx 26rpx;background:#fbfaf7;border:1rpx solid var(--em-color-border);border-radius:18rpx;font-size:28rpx}.form-card textarea{min-height:220rpx}.field-label{display:block;margin-top:30rpx;font-size:27rpx;font-weight:800}.required{color:#8a6f2b;font-size:22rpx}.choice-row{display:flex;gap:16rpx;margin-top:14rpx}.choice{flex:1;padding:22rpx 10rpx;text-align:center;background:#f3f1ed;border:1rpx solid transparent;border-radius:16rpx}.choice.selected,.issue.selected{color:#fff;background:#123b35;border-color:#123b35}.two-columns{display:grid;grid-template-columns:1fr 1fr;gap:20rpx}.issue-grid{display:grid;grid-template-columns:1fr 1fr;gap:14rpx;margin-top:14rpx}.issue{display:flex;align-items:center;justify-content:space-between;min-height:76rpx;padding:0 20rpx;background:#f3f1ed;border:1rpx solid transparent;border-radius:16rpx;font-size:25rpx}.section-gap{display:block;margin-top:46rpx}.consent{display:flex;gap:16rpx;align-items:flex-start;margin:32rpx 0;color:var(--em-color-text-secondary);font-size:24rpx;line-height:1.6}.consent-box{display:flex;flex:0 0 36rpx;align-items:center;justify-content:center;height:36rpx;margin-top:1rpx;border:2rpx solid #8e9996;border-radius:8rpx}.consent-box.checked{color:#fff;background:#123b35;border-color:#123b35}.success-card{display:flex;flex-direction:column;align-items:center;box-sizing:border-box;width:100%;padding:68rpx 42rpx;text-align:center;background:#fff;border:1rpx solid var(--em-color-border);border-radius:28rpx}.success-mark{display:flex;align-items:center;justify-content:center;width:86rpx;height:86rpx;margin:0 0 28rpx;color:#fff;font-size:42rpx;background:#123b35;border-radius:50%}.success-title{display:block;width:100%;margin:0 0 20rpx;color:#123b35;font-family:var(--em-font-serif);font-size:40rpx;font-weight:700;line-height:1.35;background:transparent}.success-body{display:block;width:100%;margin:0;color:#53605e;font-size:27rpx;line-height:1.85;white-space:normal}
