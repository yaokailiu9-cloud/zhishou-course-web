@import "../../styles/course-components.wxss";
.questionnaire-share-page{padding-bottom:80rpx}.qr-card{text-align:center}.questionnaire-code{display:block;margin:36rpx auto;background:#fff;border:20rpx solid #fff;border-radius:24rpx;box-shadow:0 18rpx 48rpx rgba(0,39,39,.1)}.center{display:block;margin-top:24rpx;text-align:center;line-height:1.7}.records-head{display:flex;align-items:flex-end;justify-content:space-between;gap:20rpx;margin:54rpx 0 20rpx}.records-head .panel-caption{margin-bottom:8rpx}.records-title{display:block;font-family:var(--em-font-serif);font-size:38rpx;font-weight:700;line-height:1.35}.records-count{color:#82704b;font-size:24rpx}.record-card{padding:30rpx 30rpx 24rpx;margin:18rpx 0;background:#fff;border:1rpx solid var(--em-color-border);border-radius:20rpx;box-shadow:0 12rpx 32rpx rgba(0,39,39,.045)}.record-top,.record-bottom{display:flex;align-items:center;justify-content:space-between;gap:18rpx}.record-top>view{min-width:0}.record-name{display:block;color:#123b35;font-size:31rpx;font-weight:700;line-height:1.45}.record-guardian{display:block;margin-top:8rpx;color:#717878;font-size:24rpx}.record-bottom{padding-top:22rpx;margin-top:22rpx;color:#717878;font-size:23rpx;border-top:1rpx solid #ece8e2}.record-link{color:#285f51;font-weight:600}
