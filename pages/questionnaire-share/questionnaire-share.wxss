@import "../../styles/course-components.wxss";
.questionnaire-share-page{padding-bottom:80rpx}.qr-card{text-align:center}.questionnaire-code{display:block;margin:36rpx auto;background:#fff;border:20rpx solid #fff;border-radius:24rpx;box-shadow:0 18rpx 48rpx rgba(0,39,39,.1)}.center{display:block;margin-top:24rpx;text-align:center;line-height:1.7}.records-title{display:block;margin:6rpx 0 8rpx;font-family:var(--em-font-serif);font-size:38rpx;font-weight:700;line-height:1.35}.work-order-entry{display:flex;align-items:center;justify-content:space-between;gap:28rpx;padding:34rpx 30rpx;margin-top:32rpx;background:#fff;border:1rpx solid var(--em-color-border);border-radius:22rpx;box-shadow:0 12rpx 32rpx rgba(0,39,39,.045)}.entry-copy{min-width:0}.entry-copy .muted{display:block;line-height:1.65}.entry-side{display:grid;grid-template-columns:auto auto;align-items:center;flex:0 0 auto;min-width:118rpx;color:#123b35;text-align:center}.entry-count{font-family:var(--em-font-serif);font-size:44rpx;font-weight:700}.entry-label{grid-column:1;color:#82704b;font-size:21rpx}.entry-arrow{grid-column:2;grid-row:1/3;padding-left:18rpx;font-size:44rpx}
