<view class="service-page questionnaire-share-page">
 <view class="service-hero"><text class="eyebrow">代理专属发放</text><text class="page-title">简易方案梳理</text><text class="muted">2026问卷梳理，填写前缴费，代理可以发</text></view>
 <view wx:if="{{error}}" class="error"><text>{{error}}</text><button bindtap="refresh">重新核实身份</button></view>
 <view wx:if="{{loading && !allowed}}" class="card"><text class="muted">正在生成专属二维码…</text></view>
 <view wx:if="{{allowed}}" class="card qr-card">
  <text class="panel-caption">我的专属问卷码</text><text class="section-title">微信扫码 · 支付 19.9 元后填写</text>
  <canvas wx:if="{{shareUrl && !qrError}}" class="questionnaire-code" canvas-id="questionnaire-code" style="width:256px;height:256px;"></canvas>
  <text wx:if="{{qrError}}" class="error">{{qrError}}</text>
  <button class="primary" bindtap="openPoster" disabled="{{!shareUrl}}">打开二维码大图</button>
  <text class="muted center">打开后可长按保存到手机，再发送给家长。二维码包含你的推荐信息，不展示或复制长链接。</text>
 </view>
 <block wx:if="{{allowed && isManager}}">
  <view class="records-head"><view><text class="panel-caption">管理查看</text><text class="records-title">已提交问卷</text></view><text class="records-count">{{records.length}} 份</text></view>
  <view wx:for="{{records}}" wx:key="id" class="record-card" data-id="{{item.id}}" bindtap="openRecord">
   <view class="record-top"><view><text class="record-name">{{item.child_name || '未填写姓名'}}</text><text class="record-guardian">家长：{{item.guardian_name || '未填写'}}</text></view><text class="pill">{{item.statusText}}</text></view>
   <view class="record-bottom"><text>{{item.submittedText}}</text><text class="record-link">查看填写内容 ›</text></view>
  </view>
  <view wx:if="{{!recordsLoading && !records.length}}" class="empty">暂时没有已提交的问卷。家长提交后会显示在这里。</view>
  <button wx:if="{{nextCursor}}" class="secondary" disabled="{{recordsLoading}}" bindtap="loadMore">{{recordsLoading ? '正在加载…' : '查看更多问卷'}}</button>
  <text wx:if="{{recordsLoading && !records.length}}" class="muted">正在读取已提交问卷…</text>
 </block>
</view>
