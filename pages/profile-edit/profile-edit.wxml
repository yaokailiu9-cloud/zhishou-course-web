<view class="edit-page safe-bottom">
  <view class="edit-hero">
    <view class="avatar-shell">
      <button disabled="{{saving}}" class="avatar-picker" open-type="chooseAvatar" bindchooseavatar="onChooseAvatar">
        <image wx:if="{{avatarUrl}}" class="avatar-image" src="{{avatarUrl}}" mode="aspectFill"></image>
        <image wx:else class="avatar-image" src="{{defaultPortrait}}" mode="aspectFill"></image>
      </button>
      <view class="avatar-badge">改</view>
    </view>
    <text class="edit-title">编辑个人资料</text>
    <text class="edit-subtitle">完善你的资料，方便报名和咨询联系。</text>
  </view>

  <text wx:if="{{loading}}" class="form-notice">正在读取资料…</text>
  <view wx:if="{{error}}" class="form-error">{{error}}</view>
  <view class="form-section">
    <text class="section-caption">基础信息</text>
    <view class="form-card">
      <view class="form-row">
        <text class="field-label">用户名</text>
        <input class="field-input" type="nickname" placeholder="填写用户名" value="{{userName}}" bindinput="onUserNameInput" maxlength="80" disabled="{{saving}}" />
      </view>
      <text wx:if="{{usernameError}}" class="form-error">{{usernameError}}</text>
      <view class="form-row"><text class="field-label">所在地区（选填）</text><input class="field-input" placeholder="填写省、市、区" value="{{region}}" maxlength="100" bindinput="onRegionInput" disabled="{{saving}}"/></view>
      <view class="form-row"><text class="field-label">详细地址（选填）</text><input class="field-input" placeholder="街道、门牌号" value="{{detailAddress}}" maxlength="300" bindinput="onAddressInput" disabled="{{saving}}"/></view>
      <button class="location-button" bindtap="chooseRegion" disabled="{{saving}}">使用定位辅助填写</button>
      <picker disabled="{{saving}}" mode="selector" range="{{genderOptions}}" value="{{genderIndex}}" bindchange="onGenderChange">
        <view class="form-row">
          <text class="field-label">性别</text>
          <text class="field-static strong">{{gender || '未设置'}}</text>
        </view>
      </picker>
      <view class="form-row">
        <text class="field-label">已绑定手机号</text>
        <view class="field-link">
          <text class="field-static strong">{{phone || '暂未绑定'}}</text>
          <view wx:if="{{phone}}" class="phone-verified-badge">已验证</view>
        </view>
      </view>
      <picker disabled="{{saving}}" end="{{today}}" mode="date" value="{{birthday}}" bindchange="onBirthdayChange">
        <view class="form-row">
          <text class="field-label">生日</text>
          <text class="field-static strong">{{birthday || '未设置'}}</text>
        </view>
      </picker>
      <view class="form-row">
        <text class="field-label">ID</text>
        <text class="field-static">{{accountId || '暂未生成'}}</text>
      </view>
    </view>
  </view>

  <button class="save-button" loading="{{saving}}" disabled="{{saving || loading}}" bindtap="saveProfile">保存资料</button>
</view>
