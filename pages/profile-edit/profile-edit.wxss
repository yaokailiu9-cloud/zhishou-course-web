.edit-page {
  min-height: 100vh;
  padding: 36rpx var(--em-page-x) calc(56rpx + env(safe-area-inset-bottom));
  color: var(--em-color-primary);
  background: #fbf9f8;
  font-family: var(--em-font-family);
}

.edit-hero {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 18rpx 0 48rpx;
  text-align: center;
}

.avatar-shell {
  position: relative;
  width: 176rpx;
  height: 176rpx;
  flex: 0 0 176rpx;
}

.avatar-picker {
  position: relative;
  display: block;
  width: 176rpx;
  height: 176rpx;
  padding: 0;
  overflow: hidden;
  line-height: 1;
  border-radius: 50%;
  box-shadow: 0 18rpx 54rpx rgba(0, 39, 39, 0.12);
}

.avatar-image {
  width: 100%;
  height: 100%;
  display: block;
  border: 6rpx solid #fff6dd;
  border-radius: 50%;
}

.avatar-badge {
  position: absolute;
  right: -4rpx;
  bottom: 18rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  width: 54rpx;
  height: 54rpx;
  color: var(--em-color-gold-strong);
  font-size: 24rpx;
  font-weight: 800;
  background: var(--em-color-gold);
  border-radius: 50%;
  box-shadow: 0 10rpx 22rpx rgba(115, 92, 0, 0.16);
}

.edit-title {
  display: block;
  margin-top: 34rpx;
  color: var(--em-color-primary);
  font-size: 42rpx;
  font-weight: 800;
  line-height: 1.25;
}

.edit-subtitle {
  display: block;
  max-width: 584rpx;
  margin-top: 18rpx;
  color: var(--em-color-text-secondary);
  font-size: 25rpx;
  font-weight: 600;
  line-height: 1.65;
}

.form-section {
  margin-top: 34rpx;
}

.section-caption {
  display: block;
  margin-bottom: 18rpx;
  color: var(--em-color-text-secondary);
  font-size: 24rpx;
  font-weight: 700;
  line-height: 1.4;
}

.form-card {
  background: #ffffff;
  border: 1rpx solid var(--em-color-border-muted);
  border-radius: 26rpx;
  box-shadow: 0 10rpx 32rpx rgba(0, 39, 39, 0.04);
}

.form-card picker {
  display: block;
}

.form-row {
  display: flex;
  align-items: center;
  min-height: 102rpx;
  padding: 0 30rpx;
  border-bottom: 1rpx solid var(--em-color-border-muted);
}

.form-row:last-child {
  border-bottom: 0;
}

.field-label {
  flex: 0 0 230rpx;
  color: var(--em-color-primary);
  font-size: 27rpx;
  font-weight: 800;
  line-height: 1.3;
}

.field-input,
.field-static {
  flex: 1;
  min-width: 0;
  color: var(--em-color-primary);
  font-size: 27rpx;
  font-weight: 600;
  text-align: right;
}

.field-static {
  color: var(--em-color-text-secondary);
}

.field-static.strong {
  color: var(--em-color-primary);
}

.field-link {
  display: flex;
  align-items: center;
  justify-content: flex-end;
  flex: 1;
  min-width: 0;
  gap: 10rpx;
}

.field-link .field-static {
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.address-row {
  min-height: 118rpx;
  align-items: flex-start;
  padding-top: 28rpx;
  padding-bottom: 24rpx;
}

.address-link {
  align-items: flex-start;
}

.address-text {
  display: -webkit-box;
  max-height: 76rpx;
  overflow: hidden;
  white-space: normal;
  text-overflow: clip;
  line-height: 1.45;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
}

.field-arrow {
  flex: 0 0 auto;
  color: var(--em-color-text-muted);
  font-size: 34rpx;
  font-weight: 400;
  line-height: 1;
}

.phone-verified-badge {
  flex: 0 0 auto;
  padding: 4rpx 16rpx;
  color: var(--em-color-gold-strong);
  font-size: 24rpx;
  font-weight: 800;
  background: var(--em-color-gold);
  border-radius: 999rpx;
}

.save-button {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 100%;
  height: 86rpx;
  margin-top: 42rpx;
  color: #ffffff;
  font-size: 28rpx;
  font-weight: 800;
  background: var(--em-color-primary);
  border-radius: var(--em-radius-lg);
  box-shadow: 0 14rpx 34rpx rgba(0, 39, 39, 0.18);
}

.form-error { display:block; color:#923e32; background:#fff0ea; padding:24rpx; margin:16rpx 0; font-size:28rpx; line-height:1.6; }
.form-notice { display:block; color:#596464; font-size:28rpx; padding:16rpx; }
.location-button { min-height:44px; padding:24rpx; color:#164d44; background:#eef3ef; font-size:28rpx; }
.save-button[disabled] { opacity:.6; }
