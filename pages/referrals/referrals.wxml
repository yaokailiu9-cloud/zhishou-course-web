<view class="service-page course-page">
 <view wx:if="{{allowed}}" class="service-hero"><text class="eyebrow">分享课程 · 推荐归属</text><text class="page-title">推荐客户</text><text class="muted">先核实客户已参加公开课，再由所属代理代约，负责人老师确认时间。</text></view>
 <view wx:if="{{error}}" class="error"><text>{{error}}</text><button bindtap="refresh">重试</button></view>
 <block wx:if="{{allowed}}">
  <view class="card"><text class="section-title">我的推荐报名码</text><text class="body">{{courseTitle || '扫码后选择课程报名'}}</text>
   <canvas wx:if="{{shareUrl && !qrError}}" class="referral-code" canvas-id="referral-code" style="width:256px;height:256px;"></canvas>
   <text wx:if="{{qrError}}" class="error">二维码暂未显示，请点击下方按钮重新生成。</text>
   <button wx:if="{{shareUrl}}" class="secondary" bindtap="copyInvitation">复制邀请链接</button><button wx:if="{{shareUrl}}" class="primary" bindtap="shareCode">生成图片 · 转发报名二维码</button><text wx:else class="muted">请在课程网页中打开此页面，获取专属报名二维码。</text>
   <text class="muted">邀请链接和二维码均包含推荐信息，可直接发送给家长。对方在微信内扫码后先登录，登录及刷新后推荐来源仍会保留。已登录客户打开链接或扫码即绑定推荐关系；未登录客户登录后绑定，已有推荐人不变。</text><button class="text-button" bindtap="courses">选择课程，生成该场报名码</button>
  </view>
  <view wx:if="{{isManager}}" class="course-tabs"><view class="course-tab {{scope === 'own' ? 'active' : ''}}" data-scope="own" bindtap="changeScope">我推荐的</view><view class="course-tab {{scope === 'all' ? 'active' : ''}}" data-scope="all" bindtap="changeScope">全部推荐客户</view></view>
  <view wx:if="{{booking}}" class="card form-card"><text class="section-title">代理代约 · 首次免费咨询</text><text class="muted">预备学员已核实参加公开课，可由所属代理代约。提交后等待负责人老师确认具体时间。</text><text wx:if="{{bookingNotice}}" class="notice">{{bookingNotice}}</text>
   <block wx:if="{{booking.appointment && booking.appointment.status !== 'CANCELED'}}"><text class="body">{{booking.appointment.contact_name}} · {{booking.appointment.statusText}}</text><text class="muted">期望时间：{{booking.appointment.requested_time}}</text><text wx:if="{{booking.appointment.confirmed_at}}" class="body">确认时间：{{booking.appointment.timeText}}</text></block>
   <block wx:else><text class="field-label">家长姓名</text><input value="{{bookingForm.name}}" data-key="name" bindinput="bookingInput" maxlength="60"/><text class="field-label">联系电话</text><input value="{{bookingForm.phone}}" data-key="phone" bindinput="bookingInput" type="number" maxlength="11"/><text class="field-label">期望咨询日期</text><picker mode="date" value="{{bookingForm.date}}" data-key="date" bindchange="bookingInput"><view class="secondary">{{bookingForm.date || '选择日期'}}</view></picker><text class="field-label">期望咨询时间</text><picker mode="time" value="{{bookingForm.time}}" data-key="time" bindchange="bookingInput"><view class="secondary">{{bookingForm.time || '选择时间'}}</view></picker><text class="field-label">本次咨询的主要困扰</text><textarea value="{{bookingForm.concerns}}" data-key="concerns" bindinput="bookingInput" maxlength="4000"/><button class="primary" bindtap="submitBooking" disabled="{{bookingBusy}}" loading="{{bookingBusy}}">提交免费咨询预约</button></block><button class="text-button" bindtap="closeBooking" disabled="{{bookingBusy}}">收起预约</button>
  </view>
  <text class="section-title">{{scope === 'all' ? '全部推荐客户' : '我的推荐客户'}} · {{total}} 人</text>
  <view wx:for="{{items}}" wx:key="id" class="card"><view class="row"><text class="card-title">{{item.customerName}}</text><text wx:if="{{item.isProspectiveStudent}}" class="pill">预备学员</text></view><text class="referral-source">推荐人：{{item.referrerName}}</text><text class="muted">记录时间 {{item.timeText}}</text>
   <view wx:for="{{item.enrollments}}" wx:for-item="enrollment" wx:key="id" class="referral-course"><view class="row"><text>{{enrollment.courseTitle}}</text><text class="pill">{{enrollment.statusText}}</text></view><text class="muted">报名人：{{enrollment.name}}</text><button wx:if="{{scope === 'own' && enrollment.canBookConsultation}}" class="secondary" data-referral="{{item.id}}" data-enrollment="{{enrollment.id}}" bindtap="book" disabled="{{bookingBusy}}">代约咨询 / 查看预约</button></view>
   <text wx:if="{{!item.isProspectiveStudent}}" class="muted">尚未核实参加公开课，暂不能预约咨询。</text><text wx:if="{{!item.enrollments.length}}" class="muted">已记录推荐关系，暂无课程报名。</text><text wx:if="{{item.enrollments.length === 20}}" class="muted">展示最近 20 条报名。</text>
  </view>
  <view wx:if="{{!loading && !items.length}}" class="empty">暂无推荐客户。分享上方报名二维码，客户打开邀请链接并登录后会显示在这里。核实参加公开课后才能代约咨询。</view>
  <button wx:if="{{nextCursor}}" class="secondary" bindtap="more" disabled="{{loading}}">加载更多客户</button>
 </block>
 <text wx:if="{{loading}}" class="muted">正在读取推荐信息…</text>
</view>
