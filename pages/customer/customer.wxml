<view class="service-page">
 <view class="service-hero member-hero"><text class="eyebrow">客户中心</text><text class="page-title">每一步，都有人陪你</text><text class="muted">从课堂相见，到沟通后的每一次改变。</text><view class="journey"><view class="journey-step"><text class="journey-number">01</text><text>公开课报名</text></view><view class="journey-step"><text class="journey-number">02</text><text>线下咨询</text></view><view class="journey-step"><text class="journey-number">03</text><text>执行与反馈</text></view></view></view>
 <view class="entry-grid"><button class="primary" bindtap="goClasses">免费公开课</button><button wx:if="{{pkg.package && pkg.package.remaining && !pkg.package.hasPending}}" class="secondary" bindtap="apply">预约下一次咨询</button></view>
 <view wx:if="{{error}}" class="error"><text>{{error}}</text><button bindtap="refresh">重试</button></view>
 <view wx:if="{{showForm}}" class="card form-card"><text class="section-title">预约下一次咨询</text><text class="muted">提交后由咨询主管确认具体时间，孩子档案会自动带入。</text><text class="field-label">家长姓名</text><input placeholder="家长姓名" value="{{form.name}}" data-key="name" bindinput="input" maxlength="60"/><text class="field-label">联系电话</text><input placeholder="手机号" type="number" maxlength="11" value="{{form.phone}}" data-key="phone" bindinput="input"/><text class="field-label">期望咨询日期</text><picker mode="date" value="{{form.date}}" data-key="date" bindchange="input"><view class="picker-field">{{form.date || '选择日期'}}</view></picker><text class="field-label">期望咨询时间</text><picker mode="time" value="{{form.time}}" data-key="time" bindchange="input"><view class="picker-field">{{form.time || '选择时间'}}</view></picker><text class="field-label">本次咨询的主要困扰</text><textarea placeholder="希望本次沟通解决什么问题" value="{{form.concerns}}" data-key="concerns" bindinput="input" maxlength="4000"/><button class="primary" loading="{{busy}}" disabled="{{busy}}" bindtap="submit">提交预约，等待确认</button><button class="text-button" disabled="{{busy}}" bindtap="closeForm">暂不预约</button></view>
 <view wx:if="{{!isLoggedIn}}" class="card"><text class="section-title">登录后查看你的服务记录</text><text class="muted">报名、预约和反馈会保存在你的微信账号下。</text><button class="primary" bindtap="login">微信登录</button></view>
 <text wx:if="{{loading}}" class="muted">正在加载你的记录…</text>
 <block wx:if="{{isLoggedIn}}">
  <view wx:if="{{hasMyPlan}}" class="card" bindtap="openMyPlan"><view class="row"><text class="section-title">我的方案</text><text class="link">查看 ›</text></view><text class="body">{{myPlanSubmitted ? '查看我提交的问卷、梳理进度和结果' : '继续填写我的问卷'}}</text></view>
  <view wx:if="{{pkg.package}}" class="card"><view class="row"><text class="section-title">{{pkg.offer.title || '5次咨询'}}</text><text class="pill">剩余 {{pkg.package.remaining}} 次</text></view><text class="body">已预约 {{pkg.package.used}} / {{pkg.package.total}} 次，每次时间由咨询主管确认。</text><text wx:if="{{pkg.package.hasPending}}" class="muted">已有待确认的预约，确认后可以预约下一次。</text><button wx:if="{{pkg.package.remaining && !pkg.package.hasPending && !showForm}}" class="primary" bindtap="apply">预约下一次咨询</button><text class="muted">单次咨询 ￥{{pkg.offer.unitPrice}} · {{pkg.offer.sessions}}次咨询 ￥{{pkg.offer.price}}</text><button class="secondary" loading="{{payBusy}}" disabled="{{payBusy}}" bindtap="buyPackage">再购买{{pkg.offer.title}}</button></view>
  <view wx:elif="{{pkg.eligible && pkg.offer}}" class="card"><view class="row"><text class="section-title">后续{{pkg.offer.title}}</text><text class="pill">￥{{pkg.offer.price}}</text></view><text class="body">单次咨询 ￥{{pkg.offer.unitPrice}}，{{pkg.offer.sessions}}次咨询 ￥{{pkg.offer.price}}。</text><text class="muted">首次咨询已建立孩子档案。购买后可在这里自行预约，时间由咨询主管确认。</text><button class="primary" loading="{{payBusy}}" disabled="{{payBusy}}" bindtap="buyPackage">购买{{pkg.offer.title}}</button></view>
  <view wx:else class="notice">参加公开课后，由代理为你预约第1次免费咨询；首次咨询建立孩子档案后，可在这里购买后续5次咨询。</view>
  <view class="row"><text class="section-title">我的公开课报名</text><button class="text-button" bindtap="goMine">全部报名 ›</button></view>
  <view wx:for="{{enrollments}}" wx:key="id" class="card" data-id="{{item.id}}" bindtap="openClass"><view class="row"><text class="card-title">{{item.public_class.title}}</text><text class="pill">免费</text></view><text class="muted">{{item.statusText}} · {{item.attendanceText}} · {{item.groupText}}</text><text class="body">{{item.public_class.group_guide || '工作人员将联系你进群，课程地址在群内通知。'}}</text><text class="link">查看入场凭证与进群指引 ›</text></view>
  <view wx:if="{{!loading && !enrollments.length}}" class="empty">还没有报名，先从一堂免费公开课开始。</view>
  <text class="section-title">我的线下咨询</text>
  <view wx:for="{{appointments}}" wx:key="id" class="card" data-id="{{item.id}}" bindtap="openAppointment"><view class="row"><text class="card-title">{{item.child_info.name || '线下沟通预约'}}</text><text class="pill">{{item.statusText}}</text></view><text class="body">{{item.concerns}}</text><text class="muted">{{item.status === 'PENDING' ? '期望时间：' + item.requested_time : item.timeText}}</text><text class="link">{{item.status === 'CONFIRMED' && !item.child_info ? '填写孩子基础信息' : '查看记录与执行反馈'}} ›</text></view>
  <view wx:if="{{!loading && !appointments.length}}" class="empty">预约确认后，在这里填写基础信息、查看老师建议并反馈执行情况。</view>
 </block>
 <text wx:if="{{appointments.length}}" class="muted">{{nextAppointmentCursor ? '已加载' : '共'}} {{appointments.length}} 条咨询记录</text>
 <button wx:if="{{nextAppointmentCursor}}" class="secondary" loading="{{moreLoading}}" disabled="{{moreLoading || loading}}" bindtap="moreAppointments">查看更多咨询记录</button>
 <button class="text-button" bindtap="goHome">返回客户首页</button>

</view>
