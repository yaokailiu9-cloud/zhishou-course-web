<view class="service-page"><view class="service-hero"><text class="eyebrow">知守</text><text class="page-title">{{about ? '关于知守' : '帮助与支持'}}</text><text class="muted">{{about ? '从理解开始，让关系慢慢变好。' : '找到报名、咨询和资料管理的帮助。'}}</text></view>
 <view wx:if="{{about}}" class="card"><text class="section-title">学习与持续沟通</text><text class="body">免费公开课、线下咨询预约与执行反馈，让每一次沟通都有回应。</text><text class="muted">当前版本：{{version}}</text></view>
 <view wx:for="{{questions}}" wx:key="title" class="card"><text class="section-title">{{item.title}}</text><text class="body">{{item.answer}}</text></view>
 <button class="secondary" bindtap="classes">查看免费公开课</button><button class="text-button" bindtap="privacy">隐私与安全说明</button></view>