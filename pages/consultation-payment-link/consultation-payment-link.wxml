<view class="service-page">
 <text class="page-title">咨询缴费链接</text>
 <text wx:if="{{allowed}}" class="muted">生成链接后发给家长，由家长本人在微信中完成缴费。</text>
 <view wx:if="{{loading}}" class="notice">正在核实发放权限…</view>
 <view wx:if="{{error}}" class="error"><text>{{error}}</text><button bindtap="refresh">重试</button></view>
 <view wx:if="{{!loading && !allowed && !error}}" class="notice"><text>请使用获授权的管理账号进入。</text><button wx:if="{{!loggedIn}}" class="secondary" bindtap="login">微信登录</button><button wx:else class="secondary" bindtap="goProfile">返回我的</button></view>
 <view wx:if="{{allowed}}" class="card">
  <text class="section-title">发给需要缴费的家长</text>
  <text class="muted">链接7天有效，仅指定微信账号登录后可打开并缴费，转发给其他人无法使用。</text>
  <text class="field-label">指定微信收款对象</text>
  <input class="input" value="{{search}}" placeholder="输入家长昵称、姓名或完整账号ID" disabled="{{busy}}" bindinput="inputSearch" />
  <button class="secondary" loading="{{searching}}" disabled="{{busy || searching || !search}}" bindtap="searchCustomers">查找微信账号</button>
  <picker wx:if="{{customers.length}}" range="{{customers}}" range-key="label" value="{{customerIndex}}" disabled="{{busy}}" bindchange="selectCustomer"><view class="picker-field">{{customerName || '请选择并核对收款账号'}}</view></picker>
  <text wx:if="{{customerAccountId}}" class="muted">收款账号ID：{{customerAccountId}}</text>
  <text class="field-label">上级代理</text>
  <picker range="{{agents}}" range-key="name" value="{{agentIndex}}" disabled="{{busy || boundAgentId}}" bindchange="selectAgent"><view class="picker-field">{{agentName || '请选择上级代理'}}</view></picker>
  <text class="muted">已有代理时自动保留并锁定；未绑定时，由你选择，缴费成功后绑定。归属不一致时无法生成链接。</text>
  <text wx:if="{{!loading && !agents.length}}" class="error">暂无启用中的代理，请联系管理员。</text>
  <button class="{{shareUrl ? 'secondary' : 'primary'}}" loading="{{busy}}" disabled="{{busy || loading || !agentAccountId || !customerAccountId}}" bindtap="generate">{{shareUrl ? '生成新链接' : '生成缴费链接'}}</button>
  <block wx:if="{{shareUrl}}">
   <text class="body">指定收款对象：{{generatedCustomerName}}</text>
   <text class="body">上级代理：{{generatedAgentName}}</text>
   <text class="body">{{offer.title}} · ￥{{offer.price}}</text>
   <text class="muted">有效期至 {{expiresText}}</text>
   <button class="primary" bindtap="copy">复制缴费链接</button>
   <text class="muted">复制后粘贴到微信发给家长。生成新链接不会提前关闭已发出的链接。</text>
  </block>
 </view>
</view>
