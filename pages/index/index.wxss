.home-page {
  min-height: 100vh;
  padding: 0 var(--em-page-x) 150rpx;
  overflow-x: hidden;
  color: var(--em-color-primary);
  background: #fbf9f8;
  font-family: var(--em-font-family);
}

.custom-nav {
  display: flex;
  align-items: center;
  justify-content: flex-start;
  width: 100%;
  min-height: 104rpx;
  padding-left: 0;
  margin-bottom: 12rpx;
}

.nav-left {
  display: flex;
  align-items: center;
  flex: 1;
  min-width: 0;
  max-width: 430rpx;
  padding: 6rpx 18rpx 6rpx 0;
  border-radius: var(--em-radius-pill);
}

.nav-avatar {
  flex-shrink: 0;
  width: 76rpx;
  height: 76rpx;
  margin-right: 16rpx;
  overflow: hidden;
  background: var(--em-color-primary-soft);
  border: 2rpx solid rgba(254, 214, 91, 0.42);
  border-radius: 50%;
  box-shadow: 0 12rpx 28rpx rgba(0, 39, 39, 0.14);
}

.nav-avatar-img {
  display: block;
  width: 100%;
  height: 100%;
}

.nav-copy {
  flex: 1;
  min-width: 0;
}

.nav-title,
.nav-greeting {
  display: block;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.nav-title {
  color: var(--em-color-primary);
  font-family: var(--em-font-serif);
  font-size: 34rpx;
  font-weight: 600;
  line-height: 1.12;
}

.nav-greeting {
  margin-top: 6rpx;
  color: var(--em-color-text-secondary);
  font-size: 24rpx;
  font-weight: 700;
  line-height: 1;
}

.search-box {
  display: flex;
  align-items: center;
  width: 100%;
  height: 96rpx;
  padding: 0 32rpx;
  margin: 16rpx 0 28rpx;
  background: var(--em-color-surface);
  border: 1rpx solid var(--em-color-border);
  border-radius: var(--em-radius-pill);
  box-shadow: 0 10rpx 34rpx rgba(0, 39, 39, 0.06);
}

.search-lens {
  position: relative;
  flex-shrink: 0;
  width: 36rpx;
  height: 36rpx;
  margin-right: 28rpx;
  border: 4rpx solid #a7adad;
  border-radius: 50%;
}

.search-lens::after {
  position: absolute;
  right: -14rpx;
  bottom: -9rpx;
  width: 20rpx;
  height: 4rpx;
  content: "";
  background: #a7adad;
  border-radius: 4rpx;
  transform: rotate(45deg);
}

.search-text {
  flex: 1;
  min-width: 0;
  overflow: hidden;
  color: var(--em-color-text-placeholder);
  font-size: 28rpx;
  font-weight: 700;
  line-height: 1;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.home-page .section-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  width: 100%;
  margin: 44rpx 0 22rpx;
}

.home-page .section-title {
  display: block;
  max-width: 420rpx;
  margin: 0;
  overflow: hidden;
  color: var(--em-color-primary);
  font-family: var(--em-font-serif);
  font-size: 42rpx;
  font-weight: 600;
  line-height: 1.22;
  text-overflow: ellipsis;
  white-space: nowrap;
}

/* Keep the existing public-class entry above the course recommendations. */
.public-class-entry { position:relative; overflow:hidden; padding:42rpx 36rpx 36rpx; margin:18rpx 0 0; background:#002f30; color:#fff; border-radius:28rpx; }
.hero-arch { position:absolute; width:260rpx; height:360rpx; top:44rpx; right:-80rpx; border:1rpx solid rgba(211,186,128,.24); border-radius:160rpx 160rpx 0 0; transform:rotate(15deg); }
.hero-arch::after { content:""; position:absolute; inset:24rpx; border:1rpx solid rgba(211,186,128,.16); border-radius:140rpx 140rpx 0 0; }
.public-class-kicker,.public-class-title,.public-class-desc { position:relative; display:block; }
.public-class-kicker { color:#ddc48d; font-size: 24rpx; letter-spacing:4rpx; }
.public-class-title { margin-top:24rpx; font-family:var(--em-font-serif); font-size:52rpx; line-height:1.38; letter-spacing:2rpx; white-space:pre-line; }
.public-class-desc { margin-top:20rpx; color:#c5d4d0; font-size:24rpx; line-height:1.8; white-space:pre-line; }
.public-class-actions { position:relative; margin-top:30rpx; }
.home-page .join-button { display:flex; align-items:center; justify-content:space-between; width:100%; min-height:84rpx; padding:20rpx 26rpx; background:#e5ce99; color:#002727; border-radius:12rpx; font-size:27rpx; font-weight:600; line-height:1.4; }
.join-button text { font-size:34rpx; font-weight:400; }
.home-paths { display:flex; margin:24rpx 0 30rpx; border-bottom:1rpx solid #dedbd3; padding:4rpx 0 28rpx; }
.home-path { flex:1; width:0; text-align:left; padding:4rpx 18rpx 4rpx 0; overflow:visible; }
.home-path + .home-path { border-left:1rpx solid #dedbd3; padding:4rpx 0 4rpx 24rpx; }
.path-number,.path-title,.path-desc { display:block; }
.path-number { color:#80714e; font-size: 24rpx; letter-spacing:2rpx; }
.path-title { margin-top:14rpx; color:#002727; font-size:27rpx; font-weight:600; line-height:1.5; }
.path-title text { font-size:24rpx; margin-left:6rpx; }
.path-desc { margin-top:8rpx; color:#717878; font-size: 24rpx; line-height:1.6; }
.section-kicker { display:block; font-size: 24rpx; color:#827452; letter-spacing:3rpx; margin-bottom:12rpx; }
.section-note { font-size:21rpx; color:#717878; }
.home-page .section-head { align-items:flex-end; margin-top:40rpx; }
.search-box { height:80rpx; border-radius:12rpx; box-shadow:none; margin-bottom:16rpx; }
.search-text { font-weight:400; font-size:24rpx; }
.search-lens { width:26rpx; height:26rpx; border-width:3rpx; }
.nav-avatar { box-shadow:none; width:64rpx; height:64rpx; }
.nav-title { font-family:var(--em-font-family); font-size:27rpx; }
.nav-greeting { font-weight:400; font-size: 24rpx; margin-top:10rpx; }

.nav-brand { display:flex; align-items:center; justify-content:center; color:#002727; font-family:var(--em-font-serif); font-size:32rpx; }
.home-course-list { display:flex; flex-direction:column; gap:28rpx; }
.home-course-card { overflow:hidden; border:1rpx solid #e6e1da; border-radius:22rpx; background:#fff; }
.home-course-cover { position:relative; display:block; height:300rpx; }
.home-course-image { width:100%; height:100%; }
.home-course-badge { position:absolute; top:22rpx; left:22rpx; padding:8rpx 20rpx; border-radius:6rpx; background:#e5ce99; color:#002727; font-size:24rpx; }
.home-course-body { padding:30rpx; }
.home-course-title { display:block; font-family:var(--em-font-serif); font-size:36rpx; line-height:1.55; }
.home-course-subtitle { display:block; margin-top:14rpx; color:#717878; font-size:25rpx; line-height:1.8; }
.home-course-footer { display:flex; align-items:center; justify-content:space-between; gap:16rpx; margin-top:26rpx; padding-top:24rpx; border-top:1rpx solid #e6e1da; }
.home-course-footer > text { flex:1; color:#717878; font-size:23rpx; line-height:1.6; }
.course-button { flex-shrink:0; padding:22rpx 26rpx; min-height:80rpx; border-radius:12rpx; background:#002727; color:#fff; font-size:25rpx; line-height:1.5; }
