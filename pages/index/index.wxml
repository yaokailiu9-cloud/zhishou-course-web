<view class="home-page safe-bottom">
  <view class="custom-nav" style="height: {{navHeight}}px; padding-top: {{statusBarHeight}}px; padding-right: {{navPaddingRight}}px;">
    <view class="nav-left">
      <view class="nav-avatar nav-brand">
        <image class="nav-avatar-img" src="/assets/branding/zhishou-logo-transparent.png" mode="aspectFit" aria-label="知守 Logo"/>
      </view>
      <view class="nav-copy">
        <text class="nav-title">{{userName}}</text>
        <text class="nav-greeting">知守</text>
      </view>
    </view>
  </view>

  <view class="public-class-entry">
    <view class="hero-arch"></view>
    <text class="public-class-kicker">公开课程 · 知守课堂</text>
    <text class="public-class-title">透过现象看本质，\n父母有道，孩子有路。</text>
    <text class="public-class-desc">从一堂课开始学习与沟通。\n报名费用以各场次页面显示为准。</text>
    <view class="public-class-actions">
      <button class="join-button" bindtap="goPublicClasses">课程报名 <text>↗</text></button>
    </view>
  </view>

  <view class="home-paths">
    <button class="home-path" bindtap="goPlaza"><text class="path-number">01 / 学习</text><text class="path-title">课程学习 <text>↗</text></text><text class="path-desc">关系沟通 · 情绪成长</text></button>
    <button class="home-path" bindtap="goCustomerPortal"><text class="path-number">02 / 陪伴</text><text class="path-title">我的报名与咨询 <text>↗</text></text><text class="path-desc">入场凭证 · 预约 · 执行反馈</text></button>
  </view>

  <view class="search-box" bindtap="goSearch">
    <view class="search-lens"></view>
    <text class="search-text">搜索共修课程与学习主题</text>
  </view>

  <view wx:if="{{loadingCourses}}" class="loading-notice">正在加载课程…</view>
  <view wx:elif="{{courseError}}" class="loading-notice"><text>{{courseError}}</text><button class="retry-button" bindtap="fetchFeaturedCourses">重新加载</button></view>
  <block wx:else>
    <view wx:if="{{publicCourses.length}}" class="section-head">
      <view><text class="section-kicker">从认知开始 · 读懂孩子</text><text class="section-title">孩子教育公开课</text></view>
    </view>
    <view wx:for="{{publicCourses}}" wx:key="id" class="home-course-card public-recording" data-id="{{item.id}}" bindtap="openCourse" aria-label="观看公开课{{item.title}}">
      <image class="public-recording-cover" src="{{item.coverUrl}}" mode="aspectFit"/>
      <view class="home-course-body"><text class="home-course-title">{{item.title}}</text><view class="series-entry-footer"><text>公开课 · {{item.durationText}}</text><text>立即观看 ↗</text></view></view>
    </view>

    <view class="section-head">
      <view><text class="section-kicker">亲子关系 · 孩子成长</text><text class="section-title">孩子系列课程</text></view>
      <text class="section-note">答案库系列</text>
    </view>
    <view class="home-course-list">
      <view wx:if="{{childCourses.length}}" class="home-course-card series-entry" bindtap="goChildSeries" aria-label="查看孩子系列课程">
        <view class="home-course-cover">
          <image class="home-course-image" src="/assets/course-covers/child-education.png" mode="aspectFit"/>
        </view>
        <view class="home-course-body">
          <text class="series-entry-kicker">《答案库》系列课程</text>
          <text class="home-course-title">探索更多孩子成长主题</text>
          <view class="series-entry-footer"><text>孩子系列 · {{childCourses.length}} 门</text><text class="series-entry-action">查看全部课程</text></view>
        </view>
      </view>
      <view wx:if="{{phoneCourses.length}}" class="home-topic-list">
        <view wx:for="{{phoneCourses}}" wx:key="id" class="home-topic-card" data-id="{{item.id}}" bindtap="openCourse" aria-label="查看{{item.title}}">
          <view class="topic-cover">
            <image wx:if="{{item.coverUrl}}" class="topic-cover-image" src="{{item.coverUrl}}" mode="aspectFill"/>
            <view wx:else class="topic-cover-fallback"><text>{{item.title}}</text></view>
          </view>
          <view class="topic-body">
            <text class="topic-label">手机主题 · 孩子系列</text>
            <text class="topic-title">{{item.title}}</text>
            <view class="topic-footer"><text>{{item.durationText}}</text><text>进入课程 ↗</text></view>
          </view>
        </view>
      </view>
      <view wx:if="{{!childCourses.length}}" class="loading-notice">孩子系列课程准备中</view>
    </view>

    <view class="section-head">
      <view><text class="section-kicker">从自己开始 · 持续成长</text><text class="section-title">个人成长系列课程</text></view>
    </view>
    <button class="home-series-entry" bindtap="goGrowthSeries" aria-label="查看个人成长系列课程">
      <view class="home-series-cover">
        <image class="series-cover-image" src="/assets/course-covers/personal-growth.png" mode="aspectFit" aria-label="个人成长系列课程封面"/>
      </view>
      <view class="home-series-link"><text>查看系列课程</text><text aria-hidden="true">↗</text></view>
    </button>

    <view wx:if="{{archivedCourses.length}}" class="archived-series">
      <view class="library-heading"><text class="library-title">未公开系列课程</text><text class="section-count">定向开放</text></view>
      <view wx:for="{{archivedCourses}}" wx:key="id" class="archived-course" data-id="{{item.id}}" bindtap="openCourse" aria-label="{{item.title}}，进入查看观看权限">
        <image class="public-recording-cover" src="{{item.coverUrl}}" mode="aspectFit"/>
        <view class="archived-course-copy"><text>{{item.title}}</text><text>🔒 授权观看</text></view>
      </view>
    </view>
  </block>
</view>
