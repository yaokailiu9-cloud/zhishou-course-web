page{background:#fbf9f8;color:#002727}.bundle-page{padding:32rpx 36rpx 96rpx;max-width:900rpx;margin:auto}.bundle-back,.bundle-retry,.bundle-share{background:transparent;color:#285b50;font-size:28rpx;padding:0;margin:0;text-align:left}.bundle-back::after,.bundle-retry::after,.bundle-share::after,.bundle-course::after{border:0}.bundle-cover{width:100%;height:340rpx;display:block;margin:24rpx 0}.bundle-title{display:block;font-size:42rpx;font-weight:600;line-height:1.4}.bundle-price{display:flex;gap:24rpx;align-items:baseline;margin:24rpx 0;font-size:48rpx;font-weight:600}.bundle-price-note{font-size:26rpx;color:#49625a;font-weight:400}.bundle-description,.bundle-note{display:block;font-size:28rpx;line-height:1.8;color:#49625a;white-space:pre-wrap}.bundle-checkout{margin-top:36rpx;border-top:1rpx solid #d9e2df;padding-top:12rpx}.bundle-label{display:block;font-size:28rpx;margin:24rpx 0 12rpx}.bundle-input{width:100%;box-sizing:border-box;background:#fff;border:1rpx solid #a0b4ad;border-radius:12rpx;padding:22rpx;height:92rpx;font-size:30rpx;color:#002727}.bundle-note{font-size:25rpx;margin:24rpx 0}.bundle-pay{background:#002727;color:#fff;border-radius:12rpx;font-size:30rpx;line-height:1.5;padding:24rpx 20rpx;margin:24rpx 0}.bundle-pay[disabled]{background:#dfe6e3;color:#466158}.bundle-success{background:#e9f1ed;color:#244d40;padding:24rpx;margin-top:32rpx;font-size:28rpx;line-height:1.7}.bundle-error{display:block;color:#9d3027;font-size:28rpx;line-height:1.7;margin:24rpx 0}.bundle-catalog{margin:48rpx 0 28rpx}.bundle-catalog-title{font-size:32rpx;font-weight:600}.bundle-course{display:flex;justify-content:space-between;gap:24rpx;padding:26rpx 0;margin:0;border-bottom:1rpx solid #d9e2df;border-radius:0;background:transparent;color:#002727;text-align:left;line-height:1.5;font-size:28rpx}.bundle-course text:last-child{color:#49625a;font-size:25rpx;flex-shrink:0}.bundle-state{padding:100rpx 0;line-height:2;font-size:30rpx}.bundle-input:focus,.bundle-pay:focus-visible,.b