<view class="bundle-page">
  <button class="bundle-back" bindtap="goBack">返回课程</button>
  <view wx:if="{{loading}}" class="bundle-state">正在加载课程包…</view>
  <block wx:elif="{{offer}}">
    <image class="bundle-cover" src="/assets/course-covers/child-education.png" mode="aspectFit"/>
    <text class="bundle-title">{{offer.title}}</text>
    <view class="bundle-price"><text>¥{{offer.price}}</text><text class="bundle-price-note">一次购买 · {{offer.courses.length}} 门课程</text></view>
    <text class="bundle-description">{{offer.description}}</text>
    <view wx:if="{{purchased}}" class="bundle-success">已购买，以下课程已为当前账号解锁。</view>
    <view wx:else class="bundle-checkout">
      <text class="bundle-label">购买人姓名</text><input class="bundle-input" value="{{form.name}}" data-key="name" bindinput="input" aria-label="购买人姓名" placeholder="请输入姓名" maxlength="60" disabled="{{busy}}"/>
      <text class="bundle-label">联系手机</text><input class="bundle-input" value="{{form.phone}}" data-key="phone" bindinput="input" aria-label="联系手机" placeholder="请输入11位手机号" type="number" maxlength="11" disabled="{{busy}}"/>
      <text class="bundle-note">在微信内支付，确认到账后自动解锁给付款账号。公开课程可继续直接观看。</text>
      <button class="bundle-pay" bindtap="buy" disabled="{{busy || !offer.available}}" loading="{{busy}}">{{busy ? '正在确认支付…' : (offer.available ? '微信支付 ¥' + offer.price + '，解锁课程' : '暂未开放购买')}}</button>
    </view>
    <text wx:if="{{error}}" class="bundle-error" role="alert">{{error}}</text>
    <button wx:if="{{error}}" class="bundle-retry" bindtap="refresh" disabled="{{busy}}">刷新购买状态</button>
    <view class="bundle-catalog"><text class="bundle-catalog-title">课程包包含</text><button wx:for="{{offer.courses}}" wx:key="id" class="bundle-course" data-id="{{item.id}}" bindtap="openCourse"><text>{{item.title}}</text><text>{{purchased ? '去观看' : '查看介绍'}} ›</text></button></view>
    <button class="bundle-share" bindtap="copyLink">复制课程包购买链接</button>
  </block>
  <view wx:else class="bundle-state"><text>{{error || '课程包暂不可用'}}</text><button class="bundle-retry" bindtap="refresh">重新加载</button></view>
</view>
