.customer-service-panel {
  margin-top: 36rpx;
  padding: 28rpx 32rpx;
  background: rgba(15, 118, 110, 0.06);
  border: 1rpx solid rgba(15, 118, 110, 0.14);
  border-radius: 24rpx;
}

.customer-service-copy {
  width: 100%;
  min-width: 0;
}

.customer-service-title {
  display: block;
  color: var(--em-color-text);
  font-size: 28rpx;
  font-weight: 600;
}

.customer-service-desc {
  display: block;
  margin-top: 8rpx;
  color: var(--em-color-text-soft);
  font-size: 24rpx;
  line-height: 1.6;
}

.customer-service-actions {
  display: flex;
  gap: 16rpx;
  width: 100%;
  margin-top: 24rpx;
}

.customer-service-actions button {
  flex: 1 1 0;
  width: 0;
  min-width: 0;
  padding: 0 12rpx;
  white-space: nowrap;
}

.manager-page {
  min-height: 100vh;
  box-sizing: border-box;
  padding: 0 var(--em-page-x) calc(64rpx + env(safe-area-inset-bottom));
  color: var(--em-color-text);
  background: var(--em-color-bg);
  font-family: var(--em-font-family);
}

.manager-topbar {
  display: flex;
  align-items: center;
  justify-content: flex-start;
  box-sizing: border-box;
  padding-left: 8rpx;
}

.icon-button {
  position: relative;
  z-index: 2;
  display: flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
  width: 64rpx;
  height: 64rpx;
  margin: 0;
  color: var(--em-color-primary);
  font-size: 32rpx;
  font-weight: 600;
  line-height: 1;
  background: var(--em-color-surface);
  border: 1rpx solid var(--em-color-border);
  border-radius: 50%;
  box-shadow: 0 8rpx 20rpx rgba(0, 39, 39, 0.08);
}

.icon-button text {
  display: block;
  height: 34rpx;
  line-height: 30rpx;
}

.view-tabs,
.status-tabs {
  display: flex;
  gap: 8rpx;
  padding: 8rpx;
  background: var(--em-color-bg-soft);
  border-radius: var(--em-radius-pill);
}

.view-tabs {
  margin-top: 16rpx;
}

.view-tab,
.status-tab {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  min-width: 0;
  height: 64rpx;
  padding: 0;
  margin: 0;
  color: var(--em-color-text-secondary);
  font-size: 24rpx;
  font-weight: 700;
  line-height: 64rpx;
  background: transparent;
  border-radius: var(--em-radius-pill);
}

.view-tab::after,
.status-tab::after,
.primary-action::after,
.ghost-action::after {
  border: 0;
}

.view-tab.active,
.status-tab.active {
  color: var(--em-color-text-inverse);
  background: var(--em-color-primary);
}

.hero-line {
  margin-top: 36rpx;
}

.hero-line.compact {
  margin-top: 34rpx;
}

.hero-title {
  display: block;
  color: var(--em-color-primary);
  font-family: var(--em-font-serif);
  font-size: 50rpx;
  font-weight: 600;
  line-height: 1.12;
}

.hero-copy {
  display: block;
  margin-top: 14rpx;
  color: var(--em-color-text-secondary);
  font-size: 25rpx;
  line-height: 1.5;
}

.stats-grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 18rpx;
  margin-top: 26rpx;
}

.stat-card,
.request-card,
.session-card,
.order-card,
.summary-panel,
.empty-card {
  background: var(--em-color-surface);
  border: 1rpx solid var(--em-color-border);
  box-shadow: var(--em-shadow-card);
}

.stats-grid-compact {
  grid-template-columns: repeat(2, minmax(0, 1fr));
}

.workbench-tip {
  margin-top: 28rpx;
  padding: 28rpx 32rpx;
  color: var(--em-color-text-soft);
  font-size: 26rpx;
  line-height: 1.6;
  background: var(--em-color-surface);
  border: 1rpx solid var(--em-color-border);
  border-radius: var(--em-radius-xl);
  box-shadow: var(--em-shadow-card);
}

.workbench-tip .workbench-link {
  width: 100%;
  margin-top: 20rpx;
}

.stat-card {
  min-height: 144rpx;
  padding: 26rpx;
  border-radius: var(--em-radius-xl);
}

.stat-card.dark {
  color: var(--em-color-text-inverse);
  background: var(--em-color-primary);
  border: 0;
}

.stat-value {
  display: block;
  color: var(--em-color-primary);
  font-size: 44rpx;
  font-weight: 800;
  line-height: 1;
}

.stat-card.dark .stat-value {
  color: #ffffff;
}

.stat-label {
  display: block;
  margin-top: 16rpx;
  color: var(--em-color-text-secondary);
  font-size: 23rpx;
  font-weight: 700;
}

.stat-card.dark .stat-label {
  color: rgba(255, 255, 255, 0.68);
}

.section-row {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  margin: 38rpx 0 18rpx;
}

.section-title {
  color: var(--em-color-primary);
  font-family: var(--em-font-serif);
  font-size: 38rpx;
  font-weight: 600;
}

.section-meta {
  color: var(--em-color-text-secondary);
  font-size: 24rpx;
  font-weight: 700;
}

.work-list,
.session-list,
.order-list {
  display: flex;
  flex-direction: column;
  gap: 22rpx;
  margin-top: 22rpx;
}

.request-card,
.session-card,
.order-card {
  padding: 26rpx;
  border-radius: var(--em-radius-xl);
}

.request-head,
.client-line,
.request-meta,
.request-actions,
.progress-row,
.session-footer,
.order-meta,
.order-actions,
.summary-panel {
  display: flex;
  align-items: center;
}

.request-head {
  align-items: flex-start;
}

.client-avatar {
  position: relative;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  width: 72rpx;
  height: 72rpx;
  margin-right: 18rpx;
  overflow: hidden;
  color: var(--em-color-primary);
  font-size: 24rpx;
  font-weight: 800;
  background: var(--em-color-primary-soft);
  border-radius: 50%;
}

.client-avatar.small {
  width: 62rpx;
  height: 62rpx;
}

.avatar-image {
  width: 100%;
  height: 100%;
}

.client-main {
  flex: 1;
  min-width: 0;
}

.client-line {
  max-width: 100%;
  min-width: 0;
}

.client-name {
  display: block;
  flex: 0 1 auto;
  min-width: 0;
  overflow: hidden;
  color: var(--em-color-primary);
  font-size: 29rpx;
  font-weight: 800;
  line-height: 1.25;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.tag-pill,
.status-pill,
.timer-pill {
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  height: 42rpx;
  max-width: 180rpx;
  padding: 0 16rpx;
  margin-left: 12rpx;
  overflow: hidden;
  color: var(--em-color-primary);
  font-size: 21rpx;
  font-weight: 800;
  line-height: 42rpx;
  text-overflow: ellipsis;
  white-space: nowrap;
  background: var(--em-color-primary-soft);
  border-radius: var(--em-radius-pill);
}

.tag-pill.gold,
.status-pill.orange {
  color: var(--em-color-gold-strong);
  background: var(--em-color-gold-soft);
}

.status-pill.blue {
  color: var(--em-color-success);
  background: var(--em-color-success-soft);
}

.status-pill.gray {
  color: var(--em-color-text-secondary);
  background: var(--em-color-bg-soft);
}

.timer-pill {
  color: var(--em-color-gold-strong);
  background: var(--em-color-gold-soft);
}

.request-time {
  display: block;
  margin-top: 8rpx;
  color: var(--em-color-text-secondary);
  font-size: 24rpx;
  line-height: 1.25;
}

.request-title,
.order-title {
  display: block;
  margin-top: 24rpx;
  color: var(--em-color-primary);
  font-size: 28rpx;
  font-weight: 700;
  line-height: 1.45;
}

.order-title {
  margin-top: 10rpx;
  color: var(--em-color-text-secondary);
  font-size: 24rpx;
  font-weight: 600;
}

.request-meta,
.order-meta {
  justify-content: space-between;
  padding-top: 22rpx;
  margin-top: 22rpx;
  color: var(--em-color-text-secondary);
  font-size: 24rpx;
  font-weight: 700;
  border-top: 1rpx solid var(--em-color-border-muted);
}

.session-footer {
  flex-direction: column;
  align-items: stretch;
  gap: 18rpx;
  margin-top: 24rpx;
  padding-top: 22rpx;
  border-top: 1rpx solid var(--em-color-border-muted);
}

.session-price {
  color: var(--em-color-primary);
  font-size: 34rpx;
  font-weight: 800;
  line-height: 1.2;
}

.session-actions {
  display: grid;
  grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
  gap: 14rpx;
  width: 100%;
}

.session-action-btn {
  width: 100%;
  min-width: 0;
  padding: 0 16rpx;
  font-size: 23rpx;
}

.request-actions {
  display: grid;
  grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
  gap: 14rpx;
  margin-top: 24rpx;
}

.request-actions .primary-action:only-child {
  grid-column: 1 / 3;
}

.primary-action,
.ghost-action {
  display: flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
  min-width: 132rpx;
  height: 88rpx;
  padding: 0 24rpx;
  margin: 0;
  font-size: 24rpx;
  font-weight: 800;
  line-height: 1.4;
  border-radius: var(--em-radius-pill);
}

.primary-action {
  color: var(--em-color-text-inverse);
  background: var(--em-color-primary);
}

.ghost-action {
  color: var(--em-color-primary);
  background: #ffffff;
  border: 1rpx solid var(--em-color-primary);
}

.empty-card {
  display: flex;
  align-items: center;
  justify-content: center;
  min-height: 160rpx;
  color: var(--em-color-text-secondary);
  font-size: 25rpx;
  border-radius: var(--em-radius-xl);
}

.progress-row {
  gap: 14rpx;
  margin-top: 24rpx;
  color: var(--em-color-text-secondary);
  font-size: 24rpx;
  white-space: nowrap;
}

.progress-row text {
  flex-shrink: 0;
}

.progress-track {
  flex: 1;
  height: 10rpx;
  overflow: hidden;
  background: var(--em-color-bg-soft);
  border-radius: var(--em-radius-pill);
}

.progress-fill {
  height: 100%;
  background: var(--em-color-primary);
  border-radius: var(--em-radius-pill);
}

.gold-fill {
  background: var(--em-color-gold);
}

.order-progress {
  width: 100%;
  margin-top: 20rpx;
}

.order-actions {
  justify-content: space-between;
}

.order-actions .request-time {
  flex: 1;
  min-width: 0;
  margin-top: 0;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.order-action-buttons {
  display: flex;
  flex: 0 0 auto;
  gap: 12rpx;
}

.order-action-buttons .primary-action,
.order-action-buttons .ghost-action {
  min-width: 140rpx;
  padding: 0 22rpx;
}

.summary-panel {
  justify-content: space-between;
  padding: 30rpx;
  margin-top: 24rpx;
  color: var(--em-color-text-inverse);
  background: var(--em-color-primary);
  border: 0;
  border-radius: var(--em-radius-xl);
}

.summary-label {
  display: block;
  color: rgba(255, 255, 255, 0.68);
  font-size: 23rpx;
}

.summary-value {
  display: block;
  margin-top: 12rpx;
  color: #ffffff;
  font-size: 38rpx;
  font-weight: 800;
}
