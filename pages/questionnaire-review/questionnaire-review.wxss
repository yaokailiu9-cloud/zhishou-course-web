@import "../../styles/course-components.wxss";
.questionnaire-review-page{padding-bottom:90rpx}.review-card{padding:34rpx 32rpx;margin:22rpx 0;background:#fff;border:1rpx solid var(--em-color-border);border-radius:22rpx}.review-grid{display:grid;grid-template-columns:1fr 1fr;gap:0 28rpx}.review-grid>view,.review-row{padding:25rpx 0;border-bottom:1rpx solid #ece8e2}.review-card .review-row:last-child,.review-grid>view:nth-last-child(-n+2){border-bottom:0}.review-label{display:block;margin-bottom:10rpx;color:#7b817f;font-size:23rpx;line-height:1.55}.review-value{display:block;color:#123b35;font-size:28rpx;line-height:1.75;word-break:break-word;white-space:pre-wrap}.review-value.emphasis{font-weight:700}.review-value.long-text{padding:20rpx 22rpx;background:#f7f5f0;border-radius:14rpx}.review-value.phone{font-family:Arial,sans-serif;letter-spacing:1rpx}
