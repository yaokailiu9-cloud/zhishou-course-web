@import "../../styles/course-components.wxss";
.questionnaire-review-page{padding-bottom:90rpx}.review-card{padding:34rpx 32rpx;margin:22rpx 0;background:#fff;border:1rpx solid var(--em-color-border);border-radius:22rpx}.review-grid{display:grid;grid-template-columns:1fr 1fr;gap:0 28rpx}.review-grid>view,.review-row{padding:25rpx 0;border-bottom:1rpx solid #ece8e2}.review-card .review-row:last-child,.review-grid>view:nth-last-child(-n+2){border-bottom:0}.review-label{display:block;margin-bottom:10rpx;color:#7b817f;font-size:23rpx;line-height:1.55}.review-value{display:block;color:#123b35;font-size:28rpx;line-height:1.75;word-break:break-word;white-space:pre-wrap}.review-value.emphasis{font-weight:700}.review-value.long-text{padding:20rpx 22rpx;background:#f7f5f0;border-radius:14rpx}.review-value.phone{font-family:Arial,sans-serif;letter-spacing:1rpx}.feedback-card textarea{box-sizing:border-box;width:100%;min-height:300rpx;padding:24rpx 26rpx;background:#fbfaf7;border:1rpx solid var(--em-color-border);border-radius:18rpx;font-size:27rpx;line-height:1.75}.editor-label{margin-top:22rpx}.editor-tip,.feedback-meta{display:block;margin-top:18rpx;color:#7b817f;font-size:22rpx;line-height:1.65}.schedule-label{margin-top:28rpx}.schedule-row{display:grid;grid-template-columns:1.45fr 1fr;gap:14rpx}.schedule-value{padding:22rpx 18rpx;color:#123b35;text-align:center;background:#f7f5f0;border:1rpx solid var(--em-color-border);border-radius:14rpx;font-size:25rpx}.action-row{display:grid;grid-template-columns:1fr 1.25fr;gap:16rpx;margin-top:28rpx}.action-row button{margin:0}.published-head{display:flex;align-items:center;justify-content:space-between;gap:16rpx;margin:16rpx 0 22rpx}.feedback-result{padding:28rpx!important;background:#f4f7f5!important}.feedback-meta{padding-top:18rpx;border-top:1rpx solid #ece8e2}
