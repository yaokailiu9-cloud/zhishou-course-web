.privacy-page {
  min-height: 100vh;
  padding: 36rpx var(--em-page-x) calc(64rpx + env(safe-area-inset-bottom));
  color: var(--em-color-primary);
  background: #fbf9f8;
  font-family: var(--em-font-family);
}

.privacy-hero {
  display: flex;
  flex-direction: column;
  gap: 18rpx;
  padding: 18rpx 0 36rpx;
}

.privacy-kicker {
  color: var(--em-color-text-secondary);
  font-size: 24rpx;
  font-weight: 700;
  line-height: 1.4;
}

.privacy-title {
  color: var(--em-color-primary);
  font-size: 44rpx;
  font-weight: 800;
  line-height: 1.28;
}

.privacy-lede {
  color: var(--em-color-text-secondary);
  font-size: 27rpx;
  font-weight: 500;
  line-height: 1.7;
}

.privacy-meta {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
  margin-top: 6rpx;
  color: var(--em-color-text-muted);
  font-size: 24rpx;
  font-weight: 600;
  line-height: 1.45;
}

.basis-band {
  padding: 28rpx 0;
  border-top: 1rpx solid var(--em-color-border-muted);
  border-bottom: 1rpx solid var(--em-color-border-muted);
}

.band-title,
.section-title {
  display: block;
  color: var(--em-color-primary);
  font-size: 32rpx;
  font-weight: 800;
  line-height: 1.3;
}

.basis-list {
  display: flex;
  flex-wrap: wrap;
  gap: 14rpx;
  margin-top: 22rpx;
}

.basis-chip,
.right-pill {
  display: inline-flex;
  align-items: center;
  min-height: 48rpx;
  padding: 0 18rpx;
  color: var(--em-color-gold-strong);
  font-size: 24rpx;
  font-weight: 700;
  line-height: 1.3;
  background: rgba(254, 214, 91, 0.18);
  border-radius: var(--em-radius-pill);
}

.promise-grid {
  display: grid;
  gap: 18rpx;
  margin: 32rpx 0 40rpx;
}

.promise-item {
  padding: 28rpx 30rpx;
  background: #ffffff;
  border: 1rpx solid var(--em-color-border-muted);
  border-radius: 20rpx;
  box-shadow: 0 10rpx 30rpx rgba(0, 39, 39, 0.04);
}

.promise-label {
  display: block;
  color: var(--em-color-primary);
  font-size: 28rpx;
  font-weight: 800;
  line-height: 1.3;
}

.promise-value {
  display: block;
  margin-top: 10rpx;
  color: var(--em-color-text-secondary);
  font-size: 24rpx;
  font-weight: 600;
  line-height: 1.55;
}

.privacy-section {
  padding: 38rpx 0 8rpx;
  border-top: 1rpx solid var(--em-color-border-muted);
}

.section-desc {
  display: block;
  margin-top: 12rpx;
  color: var(--em-color-text-secondary);
  font-size: 25rpx;
  font-weight: 500;
  line-height: 1.65;
}

.data-group,
.policy-block {
  padding: 30rpx 0;
  border-bottom: 1rpx solid var(--em-color-border-muted);
}

.data-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
}

.data-title,
.policy-title {
  color: var(--em-color-primary);
  font-size: 30rpx;
  font-weight: 800;
  line-height: 1.35;
}

.data-tag {
  flex: 0 0 auto;
  padding: 8rpx 16rpx;
  color: var(--em-color-success);
  font-size: 24rpx;
  font-weight: 800;
  line-height: 1;
  background: var(--em-color-success-soft);
  border-radius: var(--em-radius-pill);
}

.data-list {
  display: flex;
  flex-direction: column;
  gap: 10rpx;
  margin-top: 18rpx;
}

.data-line {
  display: flex;
  align-items: flex-start;
  gap: 12rpx;
  color: var(--em-color-primary);
  font-size: 25rpx;
  font-weight: 600;
  line-height: 1.45;
}

.data-dot {
  flex: 0 0 auto;
  width: 8rpx;
  height: 8rpx;
  margin-top: 14rpx;
  background: var(--em-color-gold);
  border-radius: 50%;
}

.data-purpose,
.policy-copy {
  display: block;
  margin-top: 18rpx;
  color: var(--em-color-text-secondary);
  font-size: 25rpx;
  font-weight: 500;
  line-height: 1.75;
}

.policy-title {
  display: block;
}

.rights-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 14rpx;
  margin-top: 24rpx;
}

.right-pill {
  color: var(--em-color-primary);
  background: #ffffff;
  border: 1rpx solid var(--em-color-border-muted);
}

.contact-panel {
  margin-top: 42rpx;
  padding: 32rpx;
  color: var(--em-color-primary);
  background: #ffffff;
  border: 1rpx solid var(--em-color-border-muted);
  border-radius: 24rpx;
  box-shadow: 0 12rpx 32rpx rgba(0, 39, 39, 0.05);
}

.contact-title {
  display: block;
  font-size: 30rpx;
  font-weight: 800;
  line-height: 1.35;
}

.contact-copy {
  display: block;
  margin-top: 14rpx;
  color: var(--em-color-text-secondary);
  font-size: 24rpx;
  font-weight: 500;
  line-height: 1.65;
}

.contact-button {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 100%;
  height: 76rpx;
  margin-top: 24rpx;
  color: #ffffff;
  font-size: 24rpx;
  font-weight: 800;
  background: var(--em-color-primary);
  border-radius: var(--em-radius-lg);
}
