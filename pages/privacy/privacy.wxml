<view class="privacy-page">
  <view class="privacy-hero">
    <text class="privacy-kicker">知手 隐私与安全</text>
    <text class="privacy-title">让敏感关系问题，只为服务本身被使用</text>
    <text class="privacy-lede">本协议依据个人信息、数据安全、网络安全及微信小程序隐私保护要求制定，并结合本项目的登录、预约、支付、咨询和经理接单流程适配。</text>
    <view class="privacy-meta">
      <text>更新日期：{{updatedAt}}</text>
      <text>适用范围：知手咨询小程序</text>
    </view>
  </view>

  <view class="basis-band">
    <text class="band-title">参考依据</text>
    <view class="basis-list">
      <text wx:for="{{basisItems}}" wx:key="*this" class="basis-chip">{{item}}</text>
    </view>
  </view>

  <view class="promise-grid">
    <view wx:for="{{promiseItems}}" wx:key="label" class="promise-item">
      <text class="promise-label">{{item.label}}</text>
      <text class="promise-value">{{item.value}}</text>
    </view>
  </view>

  <view class="privacy-section">
    <text class="section-title">信息清单</text>
    <text class="section-desc">以下内容来自当前项目规划和已实现的数据流，用于说明我们在什么场景处理哪些信息。</text>
    <view class="data-group" wx:for="{{dataGroups}}" wx:key="title">
      <view class="data-head">
        <text class="data-title">{{item.title}}</text>
        <text class="data-tag">{{item.tag || '必要'}}</text>
      </view>
      <view class="data-list">
        <view wx:for="{{item.items}}" wx:for-item="dataItem" wx:key="*this" class="data-line">
          <text class="data-dot"></text>
          <text>{{dataItem}}</text>
        </view>
      </view>
      <text class="data-purpose">{{item.purpose}}</text>
    </view>
  </view>

  <view class="privacy-section">
    <text class="section-title">完整协议</text>
    <view class="policy-block" wx:for="{{sections}}" wx:key="title">
      <text class="policy-title">{{item.title}}</text>
      <text wx:for="{{item.paragraphs}}" wx:for-item="paragraph" wx:key="*this" class="policy-copy">{{paragraph}}</text>
    </view>
  </view>

  <view class="privacy-section">
    <text class="section-title">你的隐私权利</text>
    <view class="rights-grid">
      <text wx:for="{{rights}}" wx:key="*this" class="right-pill">{{item}}</text>
    </view>
  </view>

</view>
