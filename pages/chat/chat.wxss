.chat-page {
  display: flex;
  flex-direction: column;
  height: 100vh;
  min-height: 100vh;
  box-sizing: border-box;
  padding: 0 var(--em-chat-page-x) env(safe-area-inset-bottom);
  overflow: hidden;
  color: var(--em-color-text);
  background:
    radial-gradient(circle at 12% 10%, rgba(254, 214, 91, 0.10), transparent 260rpx),
    linear-gradient(180deg, #fffefe 0%, var(--em-color-bg) 100%);
}

.chat-nav {
  flex-shrink: 0;
  position: sticky;
  top: 0;
  z-index: 10;
  display: flex;
  align-items: center;
  gap: 14rpx;
  margin: 0 calc(-1 * var(--em-chat-page-x));
  padding-left: var(--em-chat-page-x);
  padding-bottom: 10rpx;
  background: rgba(251, 249, 248, 0.96);
  border-bottom: 1rpx solid var(--em-color-border);
  box-sizing: border-box;
}

.nav-back {
  display: flex;
  align-items: center;
  justify-content: center;
  flex: 0 0 64rpx;
  width: 64rpx;
  height: 64rpx;
  color: var(--em-color-primary);
  font-size: 44rpx;
  font-weight: 800;
  border-radius: 50%;
}

.nav-title {
  display: flex;
  align-items: center;
  flex: 1;
  min-width: 0;
  gap: 16rpx;
}

.nav-mark {
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  width: 54rpx;
  height: 54rpx;
  color: var(--em-color-gold-strong);
  background: var(--em-color-gold-soft);
  border-radius: 50%;
}

.nav-mark-button {
  position: relative;
  overflow: visible;
}

.nav-mark-button::after {
  content: "";
  position: absolute;
  inset: -8rpx;
}

.nav-mark-active {
  color: #ffffff;
  background: var(--em-color-primary);
  box-shadow: 0 8rpx 20rpx rgba(0, 39, 39, 0.18);
}

.nav-mark-avatar-wrap {
  overflow: visible;
  color: #ffffff;
  background: var(--em-color-primary);
}

.nav-mark-avatar-image {
  width: 100%;
  height: 100%;
  border-radius: 50%;
}

.nav-mark-list-icon {
  font-size: 28rpx;
  font-weight: 700;
  line-height: 1;
}

.nav-mark-avatar-text {
  font-size: 24rpx;
  font-weight: 700;
}

.nav-title-copy-button {
  flex: 1;
  min-width: 0;
}

.nav-mark-badge {
  position: absolute;
  top: -6rpx;
  right: -10rpx;
  min-width: 30rpx;
  height: 30rpx;
  padding: 0 8rpx;
  color: #ffffff;
  font-size: 18rpx;
  font-weight: 700;
  line-height: 30rpx;
  text-align: center;
  background: #d97706;
  border: 2rpx solid #ffffff;
  border-radius: 999rpx;
}

.title-name,
.title-sub {
  display: block;
}

.title-name {
  overflow: hidden;
  color: var(--em-color-primary);
  font-size: 27rpx;
  font-weight: var(--em-font-weight-bold);
  line-height: 1.2;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.title-sub {
  margin-top: 5rpx;
  color: var(--em-color-text-secondary);
  font-size: 21rpx;
  line-height: 1.2;
}

.nav-avatar {
  display: none;
  align-items: center;
  justify-content: center;
  width: 58rpx;
  height: 58rpx;
  color: #ffffff;
  font-size: 24rpx;
  font-weight: var(--em-font-weight-bold);
  background: var(--em-color-primary);
  border-radius: 50%;
}

.service-card {
  position: relative;
  display: grid;
  grid-template-columns: minmax(0, 1fr) auto;
  gap: 20rpx;
  align-items: center;
  padding: 40rpx 28rpx 28rpx;
  margin: 36rpx 0 26rpx;
  background: var(--em-color-surface);
  border: 1rpx solid var(--em-color-border);
  border-radius: var(--em-radius-xl);
  box-shadow: var(--em-shadow-card);
}

.service-card.is-collapsed {
  display: block;
  padding: 8rpx 24rpx 12rpx;
  margin: 12rpx 0 8rpx;
}

.service-card.is-collapsed .service-card-handle {
  top: 6rpx;
  height: 18rpx;
}

.service-time-only {
  display: flex;
  flex-direction: row;
  align-items: baseline;
  justify-content: flex-end;
  gap: 8rpx;
  margin-top: 20rpx;
}

.service-card.is-collapsed .time-value,
.service-card.is-collapsed .time-label {
  display: inline;
  margin: 0;
}

.service-card.is-collapsed .time-value {
  font-size: 28rpx;
  line-height: 1.1;
}

.service-card.is-collapsed .time-label {
  font-size: 24rpx;
  line-height: 1.1;
}

.service-card-handle {
  position: absolute;
  top: 10rpx;
  left: 0;
  right: 0;
  z-index: 2;
  display: flex;
  justify-content: center;
  align-items: center;
  height: 24rpx;
}

.service-handle-arrow {
  width: 0;
  height: 0;
}

.service-handle-arrow.is-up {
  border-right: 11rpx solid transparent;
  border-bottom: 13rpx solid rgba(0, 39, 39, 0.38);
  border-left: 11rpx solid transparent;
}

.service-handle-arrow.is-down {
  border-top: 13rpx solid rgba(0, 39, 39, 0.38);
  border-right: 11rpx solid transparent;
  border-left: 11rpx solid transparent;
}

.service-label,
.service-desc,
.time-label,
.time-value,
.service-price {
  display: block;
}

.service-label {
  color: var(--em-color-primary);
  font-family: var(--em-font-serif);
  font-size: 34rpx;
  font-weight: 600;
}

.service-desc {
  margin-top: 8rpx;
  color: var(--em-color-text-secondary);
  font-size: 23rpx;
}

.service-time {
  grid-row: span 2;
  text-align: right;
}

.time-label {
  color: var(--em-color-text-muted);
  font-size: 24rpx;
}

.time-value {
  margin-top: 6rpx;
  color: var(--em-color-primary);
  font-family: "SF Mono", "DIN Alternate", "Menlo", "PingFang SC", monospace;
  font-size: 32rpx;
  font-weight: 700;
  letter-spacing: 0;
  line-height: 1.05;
}

.service-price {
  grid-column: 1 / span 2;
  justify-self: start;
  padding: 8rpx 16rpx;
  color: var(--em-color-primary);
  font-size: 24rpx;
  font-weight: var(--em-font-weight-bold);
  background: var(--em-color-primary-soft);
  border-radius: var(--em-radius-pill);
}

.renew-action {
  grid-column: 1 / span 2;
  width: 100%;
  height: 74rpx;
  margin: 8rpx 0 0;
  color: #ffffff;
  font-size: 26rpx;
  font-weight: 800;
  line-height: 74rpx;
  background: var(--em-color-primary);
  border-radius: var(--em-radius-pill);
  box-shadow: var(--em-shadow-button);
}

.renew-action::after {
  border: none;
}

.chat-scroll {
  flex: 1;
  height: 0;
  min-height: 0;
}

.system-card {
  max-width: 86%;
  padding: 24rpx 26rpx;
  margin: 10rpx auto 34rpx;
  color: var(--em-color-text-secondary);
  font-size: 25rpx;
  line-height: 1.7;
  text-align: center;
  background: rgba(255, 255, 255, 0.76);
  border: 1rpx solid var(--em-color-border);
  border-radius: var(--em-radius-xl);
}

.messages {
  display: flex;
  flex-direction: column;
  gap: 26rpx;
  padding-bottom: 28rpx;
}

.message-row {
  display: flex;
  align-items: flex-end;
  gap: 16rpx;
}

.message-row.user {
  justify-content: flex-end;
}

.message-avatar,
.user-message-avatar {
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  width: 58rpx;
  height: 58rpx;
  overflow: hidden;
  font-size: 24rpx;
  font-weight: var(--em-font-weight-bold);
  border-radius: 50%;
}

.message-avatar {
  color: var(--em-color-gold-strong);
  background: var(--em-color-gold-soft);
}

.message-avatar-button {
  box-shadow: 0 0 0 2rpx rgba(0, 39, 39, 0.08);
}

.user-message-avatar {
  color: #ffffff;
  background: var(--em-color-primary);
}

.chat-avatar-image {
  width: 100%;
  height: 100%;
}

.bubble {
  max-width: 72%;
  padding: 24rpx 28rpx;
  color: var(--em-color-text);
  font-size: 28rpx;
  line-height: 1.68;
  background: var(--em-color-surface);
  border: 1rpx solid var(--em-color-border);
  border-radius: 28rpx;
  box-shadow: 0 12rpx 34rpx rgba(0, 39, 39, 0.05);
}

.message-row.user .bubble {
  color: #ffffff;
  background: var(--em-color-primary);
  border-color: var(--em-color-primary);
  box-shadow: var(--em-shadow-button);
}

.recall-row {
  justify-content: center;
}

.recall-notice {
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: center;
  max-width: 100%;
  padding: 6rpx 0 2rpx;
}

.recall-notice-text {
  color: rgba(0, 39, 39, 0.42);
  font-size: 24rpx;
  line-height: 1.5;
  white-space: nowrap;
}

.recall-reedit {
  margin-left: 10rpx;
  color: #576b95;
  font-size: 24rpx;
  line-height: 1.5;
  white-space: nowrap;
}

.chat-footer {
  flex-shrink: 0;
  z-index: 20;
  padding-top: 6rpx;
  background:
    linear-gradient(180deg, rgba(251, 249, 248, 0) 0%, rgba(251, 249, 248, 0.92) 18%, rgba(251, 249, 248, 0.98) 100%);
}

.chat-composer {
  display: flex;
  align-items: center;
  gap: 10rpx;
  min-height: 0;
  padding: 8rpx 10rpx 8rpx 16rpx;
  background: rgba(255, 255, 255, 0.98);
  border: 1rpx solid var(--em-color-border);
  border-radius: 26rpx;
  box-shadow: 0 8rpx 24rpx rgba(0, 39, 39, 0.07);
}

.composer-input {
  flex: 1;
  min-width: 0;
  height: 68rpx;
  padding: 0 22rpx;
  color: var(--em-color-primary);
  font-size: 25rpx;
  font-weight: 600;
  background: #f4f1f0;
  border-radius: var(--em-radius-pill);
}

.composer-input[disabled] {
  color: var(--em-color-text-muted);
  background: #f1eeee;
}

.composer-send {
  display: flex;
  align-items: center;
  justify-content: center;
  flex: 0 0 68rpx;
  width: 68rpx;
  height: 68rpx;
  color: #ffffff;
  font-size: 34rpx;
  font-weight: 800;
  line-height: 1;
  background: var(--em-color-primary);
  border-radius: 50%;
  box-shadow: 0 10rpx 22rpx rgba(0, 39, 39, 0.16);
}

.composer-send.disabled {
  color: var(--em-color-text-muted);
  background: #e6e1df;
  box-shadow: none;
}

.session-drawer-root {
  position: fixed;
  inset: 0;
  z-index: 1000;
  pointer-events: none;
}

.session-drawer-mask {
  position: absolute;
  inset: 0;
  pointer-events: auto;
  background: rgba(0, 24, 24, 0.42);
}

.session-drawer {
  position: absolute;
  top: 0;
  bottom: 0;
  left: 0;
  display: flex;
  flex-direction: column;
  width: 78%;
  max-width: 620rpx;
  pointer-events: auto;
  background: #f7f5f4;
  border-right: 1rpx solid var(--em-color-border);
  box-shadow: 18rpx 0 48rpx rgba(0, 39, 39, 0.18);
  animation: sessionDrawerIn 0.22s ease;
}

@keyframes sessionDrawerIn {
  from {
    transform: translateX(-100%);
  }

  to {
    transform: translateX(0);
  }
}

.session-drawer-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
  padding: calc(env(safe-area-inset-top) + 120rpx) 28rpx 24rpx;
  background: rgba(255, 255, 255, 0.96);
  border-bottom: 1rpx solid var(--em-color-border);
}

.session-drawer-title,
.session-drawer-subtitle,
.session-drawer-count,
.session-drawer-name,
.session-drawer-time,
.session-drawer-preview,
.session-drawer-status,
.session-drawer-empty {
  display: block;
}

.session-drawer-title {
  color: var(--em-color-primary);
  font-size: 34rpx;
  font-weight: 700;
}

.session-drawer-subtitle {
  margin-top: 6rpx;
  color: var(--em-color-text-secondary);
  font-size: 24rpx;
}

.session-drawer-count {
  min-width: 56rpx;
  padding: 10rpx 18rpx;
  color: var(--em-color-primary);
  font-size: 24rpx;
  font-weight: 700;
  text-align: center;
  background: var(--em-color-primary-soft);
  border-radius: var(--em-radius-pill);
}

.session-drawer-list {
  flex: 1;
  min-height: 0;
  padding: 12rpx 0 calc(24rpx + env(safe-area-inset-bottom));
}

.session-drawer-item {
  display: flex;
  gap: 18rpx;
  align-items: flex-start;
  padding: 22rpx 24rpx;
  margin: 0 16rpx 12rpx;
  background: rgba(255, 255, 255, 0.88);
  border: 1rpx solid transparent;
  border-radius: 24rpx;
}

.session-drawer-item.active {
  background: #ffffff;
  border-color: rgba(0, 39, 39, 0.12);
  box-shadow: 0 10rpx 28rpx rgba(0, 39, 39, 0.06);
}

.session-drawer-avatar {
  position: relative;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  width: 84rpx;
  height: 84rpx;
  overflow: visible;
  color: #ffffff;
  font-size: 30rpx;
  font-weight: 700;
  background: var(--em-color-primary);
  border-radius: 18rpx;
}

.session-drawer-unread {
  position: absolute;
  top: -8rpx;
  right: -8rpx;
  min-width: 32rpx;
  height: 32rpx;
  padding: 0 8rpx;
  color: #ffffff;
  font-size: 24rpx;
  font-weight: 700;
  line-height: 32rpx;
  text-align: center;
  background: #d97706;
  border: 2rpx solid #f7f5f4;
  border-radius: 999rpx;
}

.session-drawer-avatar-image {
  width: 100%;
  height: 100%;
  border-radius: 18rpx;
}

.session-drawer-body {
  flex: 1;
  min-width: 0;
}

.session-drawer-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12rpx;
}

.session-drawer-name {
  overflow: hidden;
  flex: 1;
  color: var(--em-color-primary);
  font-size: 28rpx;
  font-weight: 700;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.session-drawer-time {
  flex-shrink: 0;
  color: var(--em-color-text-muted);
  font-family: "SF Mono", "DIN Alternate", "Menlo", "PingFang SC", monospace;
  font-size: 24rpx;
}

.session-drawer-preview {
  overflow: hidden;
  margin-top: 8rpx;
  color: var(--em-color-text-secondary);
  font-size: 24rpx;
  line-height: 1.5;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.session-drawer-meta {
  display: flex;
  align-items: center;
  margin-top: 12rpx;
}

.session-drawer-status {
  padding: 4rpx 12rpx;
  font-size: 24rpx;
  border-radius: var(--em-radius-pill);
}

.session-drawer-status.active {
  color: #0f766e;
  background: rgba(15, 118, 110, 0.12);
}

.session-drawer-status.waiting {
  color: #b45309;
  background: rgba(180, 83, 9, 0.12);
}

.session-drawer-status.ended {
  color: #717878;
  background: #f1efee;
}

.session-drawer-empty {
  padding: 80rpx 40rpx;
  color: var(--em-color-text-muted);
  font-size: 24rpx;
  text-align: center;
}

.chat-empty {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
  height: 100%;
  min-height: 560rpx;
  padding: 64rpx 52rpx 112rpx;
  text-align: center;
}

.chat-empty-mark {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 104rpx;
  height: 104rpx;
  color: #8a6c08;
  font-family: var(--em-font-serif);
  font-size: 36rpx;
  background: #fbefcc;
  border-radius: 50%;
}

.chat-empty-title { margin-top: 30rpx; color: var(--em-color-primary); font-size: 32rpx; font-weight: 700; line-height: 1.4; }

.nav-back { width:44px; height:44px; flex-basis:44px; }
.composer-send { width:44px; height:44px; flex-basis:44px; }
.composer-input { box-sizing:border-box; height:auto; min-height:44px; max-height:120px; padding:9rpx 18rpx; line-height:1.35; font-size:28rpx; }
.send-error { padding:16rpx; color:#8b3e31; background:#fff1eb; font-size:26rpx; line-height:1.5; }
.send-recovery { display:flex; gap:16rpx; }
.send-recovery button { min-height:44px; padding:16rpx; color:#194e43; font-size:26rpx; }
.title-sub,.service-desc,.time-label { font-size:24rpx; }

.failed-message { display:block; max-height:120px; overflow-y:auto; white-space:pre-wrap; word-break:break-all; margin-top:12rpx; }
/* Service management follows the reference's compact archive list and review cards. */
.service-chat-page {height:100vh;display:flex;flex-direction:column;background:#f6f4ef;color:#292723;overflow:hidden;}
.service-chat-nav {display:flex;align-items:center;gap:22rpx;padding:20rpx 30rpx;background:#fffdf8;border-bottom:1rpx solid #e7e2d8;flex-shrink:0;}
.service-profile {margin:0;width:86rpx;height:86rpx;padding:0;border-radius:50%;background:#3c564c;color:#fff;font-size:36rpx;display:flex;align-items:center;justify-content:center;position:relative;}
.service-profile-chevron {position:absolute;bottom:0;right:0;font-size:22rpx;background:#bb9c5f;border-radius:50%;width:28rpx;height:28rpx;line-height:28rpx;}
.service-chat-title {display:flex;flex:1;min-width:0;flex-direction:column;gap:6rpx;}.service-chat-title text:first-child {font-size:34rpx;font-weight:600;}.service-chat-title text:last-child {font-size:22rpx;color:#77746c;}
.service-nav-refresh {margin:0;padding:0;width:62rpx;background:transparent;font-size:36rpx;color:#5d655e;}
.service-case-strip {padding:24rpx 30rpx;display:flex;flex-wrap:wrap;align-items:center;gap:12rpx;background:#fffdf8;flex-shrink:0;}.service-case-strip>text {font-size:24rpx;color:#77746c;}.service-case-strip button {margin:0 0 0 auto;padding:0 16rpx;line-height:48rpx;font-size:24rpx;background:#eceee7;color:#3c564c;}
.service-case-name {font-size:30rpx;font-weight:600;}.service-grade,.service-priority,.service-pending {display:inline-block;margin-left:12rpx;padding:3rpx 12rpx;border-radius:10rpx;font-size:22rpx;background:#e9e1d0;color:#795f32;}.service-priority,.service-pending {background:#fae2d5;color:#a04e30;}
.service-danger,.service-list-danger {background:#f5e6df;color:#994b38;padding:12rpx 24rpx;font-size:24rpx;line-height:1.5;}
.service-content-tabs,.service-list-tabs {display:flex;gap:8rpx;padding:14rpx 22rpx;background:#fffdf8;flex-shrink:0;overflow-x:auto;}.service-content-tabs button,.service-list-tabs button {margin:0;padding:0 20rpx;font-size:25rpx;line-height:56rpx;background:transparent;color:#77746c;white-space:nowrap;}.service-content-tabs .active,.service-list-tabs .active {color:#3c564c;background:#e9ede5;font-weight:600;}
.service-chat-content {flex:1;height:0;min-height:0;}.service-panel,.service-feedback-card {margin:20rpx 24rpx;padding:28rpx;background:#fffdf8;border:1rpx solid #e7e2d8;border-radius:20rpx;display:flex;flex-direction:column;gap:18rpx;}.service-section-title {font-size:30rpx;font-weight:600;}.service-message-head {display:flex;justify-content:space-between;font-size:23rpx;color:#77746c;gap:18rpx;}.service-message-body {white-space:pre-wrap;font-size:28rpx;line-height:1.75;overflow-wrap:anywhere;}.service-reply {display:flex;flex-direction:column;gap:14rpx;margin-top:16rpx;padding:22rpx;border-radius:14rpx;background:#f0f2eb;}
.review-flow {display:flex;gap:8rpx;flex-wrap:wrap;color:#768072;font-size:21rpx;}.review-status {display:flex;justify-content:space-between;gap:12rpx;flex-wrap:wrap;font-size:23rpx;color:#755d33;}.review-actions {display:flex;flex-wrap:wrap;gap:10rpx;}.review-actions button,.service-reply-button {margin:0;background:#e7ecdf;color:#3c564c;font-size:23rpx;padding:0 18rpx;line-height:52rpx;}.review-history {display:flex;flex-direction:column;gap:5rpx;color:#828176;font-size:21rpx;padding-top:10rpx;border-top:1rpx solid #dedfd4;overflow-wrap:anywhere;}
.service-panel input,.service-panel textarea,.service-composer textarea {box-sizing:border-box;width:100%;padding:18rpx;border-radius:12rpx;background:#f4f2ed;border:1rpx solid #e5e0d5;font-size:27rpx;line-height:1.6;}.service-panel textarea {height:170rpx;}.service-select {padding:18rpx;background:#f4f2ed;border-radius:12rpx;font-size:27rpx;}.service-switch {display:flex;align-items:center;justify-content:space-between;}
.service-primary {background:#3c564c!important;color:#fffdf8!important;border-radius:14rpx;font-size:26rpx;line-height:64rpx;margin:0;padding:0 24rpx;}.service-primary[disabled] {opacity:.5;}
.service-composer {padding:18rpx 24rpx calc(20rpx + env(safe-area-inset-bottom));background:#fffdf8;border-top:1rpx solid #e7e2d8;display:flex;gap:12rpx;flex-wrap:wrap;flex-shrink:0;}.service-composer textarea {max-height:180rpx;min-height:76rpx;flex:1;}.service-composer-label {width:100%;font-size:22rpx;color:#77746c;}.service-composer button {align-self:flex-end;}.service-release {display:flex;align-items:center;gap:10rpx;flex-wrap:wrap;font-size:24rpx;}.service-release input {width:110rpx;}
.service-empty {padding:60rpx 35rpx;display:flex;flex-direction:column;align-items:center;gap:20rpx;text-align:center;font-size:27rpx;line-height:1.7;color:#898478;}.service-empty-mark {width:100rpx;height:100rpx;border-radius:30rpx;background:#e8e5da;color:#3c564c;line-height:100rpx;font-size:40rpx;}.service-error,.service-supplement {padding:18rpx 24rpx;background:#f7e5d9;color:#994b38;font-size:25rpx;}.service-error button {font-size:24rpx;background:transparent;}.service-more button {background:transparent;font-size:23rpx;color:#77746c;}
.service-drawer-root {position:fixed;inset:0;z-index:100;}.service-drawer-mask {position:absolute;inset:0;background:rgba(26,31,26,.4);}.service-drawer {position:absolute;left:0;top:0;bottom:0;width:90%;max-width:760rpx;background:#fffdf8;padding:calc(24rpx + env(safe-area-inset-top)) 20rpx 24rpx;display:flex;flex-direction:column;box-sizing:border-box;}.service-drawer-heading {display:flex;align-items:center;justify-content:space-between;padding:15rpx;}.service-drawer-heading>view {display:flex;flex-direction:column;gap:10rpx;}.service-drawer-heading text:first-child {font-size:36rpx;font-weight:600;}.service-drawer-heading text:last-child {font-size:23rpx;color:#77746c;}.service-drawer-heading button {margin:0;background:transparent;font-size:40rpx;}
.service-search-row {display:flex;align-items:center;gap:12rpx;padding:15rpx 4rpx;}.service-search-row input {flex:1;min-width:0;background:#f0ede6;padding:18rpx 12rpx;font-size:24rpx;border-radius:12rpx;}.service-search-row button,.service-filter-picker {margin:0;padding:0 14rpx;font-size:23rpx;line-height:65rpx;background:#f0ede6;border-radius:12rpx;}.service-list-tabs {padding:10rpx 0;}.service-list-tabs button {font-size:22rpx;padding:0 14rpx;}.service-drawer-list {flex:1;height:0;}.service-case-item {display:flex;gap:18rpx;padding:24rpx 10rpx;border-bottom:1rpx solid #ece7dc;}.service-case-item.selected {background:#eef1e8;border-radius:14rpx;}.service-list-avatar {width:76rpx;height:76rpx;line-height:76rpx;text-align:center;flex-shrink:0;border-radius:50%;background:#dbe6d8;color:#3c564c;font-size:32rpx;}.service-list-main {flex:1;min-width:0;display:flex;flex-direction:column;gap:10rpx;}.service-list-preview {font-size:26rpx;color:#5e5a53;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;}.service-list-owner {font-size:22rpx;color:#8a8377;}.service-list-danger {padding:8rpx 12rpx;border-radius:10rpx;}.service-permission-entry {margin:14rpx 0 0;background:#e9ede5;color:#3c564c;font-size:25rpx;}

.service-archive-section {display:flex;flex-direction:column;gap:18rpx;padding:20rpx 0;border-bottom:1rpx solid #e7e2d8;}.service-archive-answer {display:flex;flex-direction:column;gap:8rpx;}.service-archive-answer>text:first-child {color:#827d71;font-size:24rpx;}

.service-nav-history {margin:0;padding:0 12rpx;background:transparent;font-size:23rpx;color:#827d71;}.service-return-entry {margin:14rpx 24rpx;padding:0 20rpx;background:#e9ede5;color:#3c564c;font-size:25rpx;line-height:60rpx;}
