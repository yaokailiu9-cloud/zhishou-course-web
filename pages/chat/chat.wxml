<view wx:if="{{serviceMode}}" class="service-chat-page">
 <view class="service-chat-nav" style="padding-top: {{statusBarHeight}}px;">
  <button wx:if="{{serviceStaff || serviceDetail.staff || serviceAllCases.length > 1}}" class="service-profile" aria-label="展开孩子档案列表" bindtap="toggleServiceDrawer"><text>{{serviceActive.childName ? serviceActive.childName[0] : '知'}}</text><text class="service-profile-chevron">⌄</text><text wx:if="{{serviceOtherUnread > 0}}" class="service-profile-badge">{{serviceOtherUnread > 99 ? '99+' : serviceOtherUnread}}</text></button><view wx:else class="service-profile service-profile-static"><text>{{serviceActive.childName ? serviceActive.childName[0] : '知'}}</text></view>
  <view class="service-chat-title"><view class="service-chat-name"><text>{{serviceActive.childName || '学员反馈'}}</text><text wx:if="{{serviceDetail.staff && serviceMeta.level}}" class="service-grade">{{serviceMeta.level}}{{serviceMeta.subLevel}}</text><text wx:if="{{serviceDetail.staff && serviceMeta.priority}}" class="service-priority">重点</text></view><text>{{serviceDetail.owner ? '老师沟通' : serviceDetail.appointment.contact_name ? serviceDetail.appointment.contact_name + ' · ' + serviceRoleLabel : serviceRoleLabel + ' · 孩子档案与方案反馈'}}</text></view>
  <button wx:if="{{serviceStaff}}" class="service-nav-history" bindtap="showLegacyServiceChat">旧会话</button>
  <button class="service-nav-refresh" aria-label="刷新当前内容" bindtap="refreshServiceView">↻</button>
 </view>
 <view wx:if="{{serviceError}}" class="service-error"><text>{{serviceError}}</text><button bindtap="loadServiceChat">重新加载</button></view>
 <view wx:if="{{serviceLoading && !serviceDetail}}" class="service-empty">正在读取孩子档案…</view>
 <view wx:elif="{{!serviceActive}}" class="service-empty"><text class="service-empty-mark">知</text><text>暂无可查看的孩子档案</text><text>档案关联后，家长反馈与工作人员回复会保留在这里。</text><button bindtap="toggleServiceDrawer">查看档案列表</button></view>
 <block wx:if="{{serviceDetail}}">
  <view wx:if="{{serviceDetail.staff && serviceMeta.danger}}" class="service-danger">危险因素：{{serviceMeta.danger}}</view>
  <view class="service-content-tabs"><button class="{{serviceTab === 'feedback' ? 'active' : ''}}" data-tab="feedback" bindtap="switchServiceTab">老师沟通<text wx:if="{{serviceActive.unread > 0 && serviceTab !== 'feedback'}}" class="service-tab-badge">{{serviceActive.unread > 99 ? '99+' : serviceActive.unread}}</text></button><button wx:if="{{consult}}" class="{{serviceTab === 'consult' ? 'active' : ''}}" data-tab="consult" bindtap="switchServiceTab">咨询记录</button><button wx:if="{{serviceDetail.staff}}" class="{{serviceTab === 'history' ? 'active' : ''}}" data-tab="history" bindtap="switchServiceTab">历史记录</button><button wx:if="{{serviceDetail.staff}}" class="{{serviceTab === 'plan' ? 'active' : ''}}" data-tab="plan" bindtap="switchServiceTab">方案审核</button><button class="{{serviceTab === 'archive' ? 'active' : ''}}" data-tab="archive" bindtap="openServiceArchive">孩子档案</button></view>
  <scroll-view id="service-message-scroll" scroll-y class="service-chat-content" scroll-into-view="{{serviceFeedbackScrollTarget}}" bindscroll="onServiceFeedbackScroll"><view id="service-content-top"></view>
   <block wx:if="{{serviceTab === 'feedback'}}">
    <view wx:if="{{serviceFeedbackCursor || dialogueCursor}}" class="service-more"><button disabled="{{serviceBusy || dialogueLoading}}" bindtap="moreServiceTimeline">查看更早消息</button></view>
    <view wx:if="{{!serviceTimeline.length && !dialogueLoading}}" class="service-empty service-feedback-empty"><text class="service-empty-mark">信</text><text class="service-empty-title">还没有沟通记录</text><text class="service-empty-description">{{serviceDetail.owner ? '可以在下方填写孩子的执行情况，或向老师反馈问题。' : '家长的反馈和消息会显示在这里，可以直接在下方给家长发消息。'}}</text></view>
    <block wx:for="{{serviceTimeline}}" wx:key="key">
    <view wx:if="{{item.kind === 'dialogue'}}" class="service-swipe-row talk-row {{item.isMine ? 'mine-row' : ''}} {{serviceSwipeKey === item.key + ':' + 'dialogue' ? 'is-open' : ''}}" data-key="{{item.key}}" data-kind="dialogue" data-id="{{item.id}}" data-swipe="{{item.key + ':' + 'dialogue'}}" catchtouchstart="startServiceSwipe" bindtouchmove="moveServiceSwipe" catchtouchend="endServiceSwipe" catchtouchcancel="closeServiceSwipe">
     <button class="service-swipe-quote" aria-label="引用这条消息" data-key="{{item.key}}" data-kind="dialogue" data-id="{{item.id}}" catchtap="quoteServiceItem" disabled="{{item.isDeleted || !serviceDetail.owner && !canTalk}}">引用</button>
    <view class="service-swipe-bubble service-feedback-card service-feedback-message talk-message {{item.isMine ? 'mine-message' : ''}} {{item.isTeacher ? 'teacher-message' : ''}}" data-key="{{item.key}}" data-kind="dialogue" data-id="{{item.id}}"><view class="service-message-head"><text><text wx:if="{{item.isNew}}" class="service-new-tag">新</text>{{item.label}}</text><text>{{item.timeText}}</text></view><view wx:if="{{item.quote}}" class="service-quote"><text>{{item.quote}}</text></view><text wx:if="{{item.isDeleted}}" class="service-message-deleted">该消息已删除</text><text wx:else class="service-message-body">{{item.content}}</text><view wx:if="{{item.canDelete}}" class="service-message-actions"><button class="service-message-delete" data-key="{{item.key}}" data-kind="dialogue" data-id="{{item.id}}" disabled="{{!!serviceDeletingKey}}" loading="{{serviceDeletingKey === 'dialogue:' + item.id}}" catchtap="deleteServiceMessage">删除</button></view><text wx:if="{{!item.isDeleted && item.readText}}" class="service-read-state {{item.read ? 'read' : ''}}">{{item.readText}}</text></view>
    </view>
    <view wx:elif="{{item.kind === 'message'}}" class="service-swipe-row message-row {{item.isReply ? 'teacher-row' : ''}} {{serviceSwipeKey === item.key + ':' + item.quoteKind ? 'is-open' : ''}}" data-key="{{item.key}}" data-kind="{{item.quoteKind}}" data-id="{{item.quoteId}}" data-swipe="{{item.key + ':' + item.quoteKind}}" catchtouchstart="startServiceSwipe" bindtouchmove="moveServiceSwipe" catchtouchend="endServiceSwipe" catchtouchcancel="closeServiceSwipe">
     <button class="service-swipe-quote" aria-label="引用这条消息" data-key="{{item.key}}" data-kind="{{item.quoteKind}}" data-id="{{item.quoteId}}" catchtap="quoteServiceItem" disabled="{{item.isDeleted || !serviceDetail.owner && !canTalk}}">引用</button>
    <view class="service-swipe-bubble service-feedback-card service-feedback-message {{item.isReply ? 'teacher-message' : ''}}" data-key="{{item.key}}" data-kind="{{item.quoteKind}}" data-id="{{item.quoteId}}"><view class="service-message-head"><text>{{item.isReply ? '老师回复' : '我的反馈'}}</text><text>{{item.timeText}}</text></view><view wx:if="{{item.quote}}" class="service-quote"><text>{{item.quote}}</text></view><text class="service-message-body">{{item.content}}</text></view>
    </view>
    <view wx:else class="service-swipe-row {{serviceSwipeKey === item.key + ':' + 'feedback' ? 'is-open' : ''}}" data-key="{{item.key}}" data-kind="feedback" data-id="{{item.id}}" data-swipe="{{item.key + ':' + 'feedback'}}" catchtouchstart="startServiceSwipe" bindtouchmove="moveServiceSwipe" catchtouchend="endServiceSwipe" catchtouchcancel="closeServiceSwipe">
     <button class="service-swipe-quote" aria-label="引用这条消息" data-key="{{item.key}}" data-kind="feedback" data-id="{{item.id}}" catchtap="quoteServiceItem" disabled="{{item.isDeleted || !serviceDetail.owner && !canTalk}}">引用</button>
    <view class="service-swipe-bubble service-feedback-card" data-key="{{item.key}}" data-kind="feedback" data-id="{{item.id}}">
     <view class="service-message-head"><text>家长反馈</text><text>{{item.timeText}}</text></view><view wx:if="{{item.quote}}" class="service-quote"><text>{{item.quote}}</text></view><text class="service-message-body">{{item.content}}</text>
     <view wx:if="{{item.reply.body.content}}" class="service-swipe-row service-swipe-reply {{serviceSwipeKey === item.key + ':reply' ? 'is-open' : ''}}" data-swipe="{{item.key + ':reply'}}" catchtouchstart="startServiceSwipe" bindtouchmove="moveServiceSwipe" catchtouchend="endServiceSwipe" catchtouchcancel="closeServiceSwipe">
      <button class="service-swipe-quote" aria-label="引用老师回复" data-key="{{item.key}}" data-kind="reply" data-id="{{item.reply.id}}" catchtap="quoteServiceItem" disabled="{{item.isDeleted || !serviceDetail.owner && !canTalk}}">引用</button>
     <view class="service-swipe-bubble service-reply" data-key="{{item.key}}" data-kind="reply" data-id="{{item.reply.id}}"><text class="service-message-head">{{item.replyShown ? '老师回复' : '未发出的回复草稿 · 家长看不到'}}</text><text class="service-message-body">{{item.reply.body.content}}</text><view wx:if="{{item.reply.canDelete}}" class="service-message-actions"><button class="service-message-delete" data-key="{{item.key}}" data-kind="reply" data-id="{{item.reply.id}}" disabled="{{!!serviceDeletingKey}}" loading="{{serviceDeletingKey === 'reply:' + item.reply.id}}" catchtap="deleteServiceMessage">删除</button></view><text wx:if="{{item.readText}}" class="service-read-state {{item.read ? 'read' : ''}}">{{item.readText}}</text></view>
     </view>
    </view>
    </view>
    </block>
   </block>
   <block wx:elif="{{serviceTab === 'history'}}">
    <view class="service-history-heading"><text class="service-section-title">历史记录</text><text class="service-muted">当前孩子档案的修改、审核和删除操作。早期记录可能仅保存操作与备注。</text><button class="service-secondary" loading="{{serviceHistoryLoading}}" disabled="{{serviceHistoryLoading}}" bindtap="refreshServiceHistory">刷新记录</button></view>
    <view wx:if="{{serviceHistoryError}}" class="service-inline-error"><text>{{serviceHistoryError}}</text></view>
    <view wx:for="{{serviceHistory}}" wx:key="key" class="service-history-item">
     <view class="service-history-meta"><text class="service-history-action {{item.action === 'DELETE' ? 'deleted' : ''}}">{{item.actionText}}</text><text>{{item.timeText}}</text></view>
     <text class="service-muted">{{item.actorText}}{{item.actorAccountId ? ' · 账号 ' + item.actorAccountId : ''}} · {{item.kindText}}</text>
     <view wx:if="{{item.beforeText}}" class="service-history-body"><text class="service-history-label">{{item.action === 'DELETE' ? '删除的原文' : '修改前'}}</text><text class="service-message-body" selectable>{{item.beforeText}}</text></view>
     <view wx:if="{{item.afterText}}" class="service-history-body"><text class="service-history-label">{{item.beforeText ? '修改后' : '当时内容'}}</text><text class="service-message-body" selectable>{{item.afterText}}</text></view>
     <text wx:if="{{item.note}}" class="service-muted">备注：{{item.note}}</text>
    </view>
    <view wx:if="{{!serviceHistory.length && !serviceHistoryLoading && !serviceHistoryError}}" class="service-empty">暂无修改或删除记录</view>
    <view wx:if="{{serviceHistoryCursor}}" class="service-more"><button loading="{{serviceHistoryLoading}}" disabled="{{serviceHistoryLoading}}" bindtap="moreServiceHistory">加载更多历史记录</button></view>
   </block>
   <block wx:elif="{{serviceTab === 'archive'}}"><view class="service-panel"><text class="service-section-title">孩子家庭档案</text><view wx:for="{{serviceArchiveSections}}" wx:for-item="section" wx:key="title" class="service-archive-section"><text class="service-section-title">{{section.title}}</text><view wx:for="{{section.fields}}" wx:for-item="field" wx:key="key" class="service-archive-answer"><text>{{field.label}}</text><text class="service-message-body">{{field.value}}</text></view></view><text wx:if="{{!serviceArchiveSections.length}}" class="service-muted">{{serviceDetail.owner ? '还没有填写孩子档案。' : '家长尚未填写孩子档案。'}}</text>
     <button wx:if="{{consult.needsArchive}}" class="service-link-button" bindtap="openConsultDetail">填写孩子基础信息 ›</button><button wx:if="{{consult.canEditArchive}}" class="service-link-button" bindtap="openConsultDetail">修改档案备注 ›</button><text class="service-field-help">聊天中仅查看档案；修改需进入档案页确认提交，避免误改。</text></view></block>
   <block wx:elif="{{serviceTab === 'consult'}}">
    <view wx:if="{{consultError}}" class="service-inline-error"><text>{{consultError}}</text></view>
    <view class="service-panel"><view class="service-panel-head"><text class="service-section-title">预约安排</text><text class="service-status-pill">{{consult.appointment.statusText}}</text></view>
     <text>{{consult.appointment.status === 'PENDING' ? '期望时间：' + consult.appointment.requested_time : '咨询时间：' + consult.appointment.timeText}}</text>
     <text class="service-muted">负责老师：{{consult.appointment.provider.display_name || '待安排'}}</text>
     <text wx:if="{{consult.appointment.concerns}}" class="service-message-body">{{consult.appointment.concerns}}</text>
     <text wx:if="{{consult.appointment.staff_note}}" class="service-muted">{{consult.appointment.staff_note}}</text>
     <text wx:if="{{consult.appointment.status === 'PENDING'}}" class="service-notice">申请已提交，确认具体时间后才算预约成功。</text>
     <button wx:if="{{consult.canAccept && consult.appointment.status === 'PENDING'}}" class="service-link-button" bindtap="openConsultDetail">确认预约时间 ›</button>
     <button wx:if="{{consult.needsArchive}}" class="service-link-button" bindtap="openConsultDetail">填写孩子基础信息 ›</button>
    </view>
    <view class="service-panel"><text class="service-section-title">老师沟通记录与执行建议</text>
     <block wx:if="{{consult.record}}"><text wx:if="{{consult.isStaff && consult.record.status !== 'CONFIRMED'}}" class="service-notice">草稿，家长暂不可见</text><text class="service-message-body">{{consult.record.summary}}</text><view wx:for="{{consult.advice}}" wx:key="key" class="service-advice"><text class="service-advice-index">{{index + 1}}</text><text class="service-message-body">{{item.content}}</text></view></block>
     <text wx:else class="service-muted">{{consult.isStaff ? '尚未整理本次沟通记录。' : '老师确认沟通记录后，会在这里显示执行建议。'}}</text>
     <button wx:if="{{consult.canReply}}" class="service-link-button" bindtap="openConsultDetail">整理记录、录音总结与确认完成 ›</button>
    </view>
    <view wx:if="{{consult.canSendFeedback}}" class="service-panel"><text class="service-section-title">反馈执行情况</text><picker range="{{consult.advice}}" range-key="content" value="{{consultAdviceIndex}}" bindchange="chooseConsultAdvice"><view class="service-select">{{consult.advice[consultAdviceIndex].content || '选择执行建议'}} ⌄</view></picker><textarea aria-label="执行反馈内容" placeholder="我是怎么做的？孩子有什么反应？遇到了什么困难？" value="{{consultFeedbackInput}}" data-field="consultFeedbackInput" bindinput="inputConsult" maxlength="6000" /><button class="service-primary" loading="{{consultBusy}}" disabled="{{consultBusy || !consultFeedbackInput}}" bindtap="sendConsultFeedback">提交执行反馈</button></view>
    <view wx:if="{{consult.canSendNote}}" class="service-panel"><text class="service-section-title">本次咨询留言</text><text class="service-muted">补充想和老师沟通的情况，老师会在下方回复。</text><textarea aria-label="留言内容" placeholder="想补充的情况或问题" value="{{consultNoteInput}}" data-field="consultNoteInput" bindinput="inputConsult" maxlength="6000" /><button class="service-primary" loading="{{consultBusy}}" disabled="{{consultBusy || !consultNoteInput}}" bindtap="sendConsultNote">发送留言</button></view>
    <text class="service-list-title">沟通、执行反馈与老师回复</text>
    <view wx:for="{{consultFeedback}}" wx:key="id" class="service-feedback-card"><view class="service-message-head"><text>{{item.kindText}}</text><text>{{item.timeText}} · {{item.replies.length ? '已回复' : '待回复'}}</text></view><text wx:if="{{item.adviceText}}" class="service-muted">对应建议：{{item.adviceText}}</text><text class="service-message-body">{{item.content}}</text>
     <view wx:for="{{item.replies}}" wx:for-item="reply" wx:key="id" class="service-reply"><text class="service-message-head">{{reply.author.display_name || '老师'}}回复{{reply.timeText ? ' · ' + reply.timeText : ''}}</text><text class="service-message-body">{{reply.content}}</text></view>
     <block wx:if="{{consult.canReply}}"><textarea aria-label="回复家长" placeholder="回复这条反馈" data-id="{{item.id}}" value="{{consultReplyInputs[item.id]}}" bindinput="inputConsultReply" maxlength="6000" /><button class="service-primary" loading="{{consultBusy}}" disabled="{{consultBusy}}" data-id="{{item.id}}" bindtap="sendConsultReply">回复家长</button></block>
    </view>
    <view wx:if="{{!consultFeedback.length}}" class="service-empty service-feedback-empty"><text class="service-empty-description">还没有执行反馈或留言。预约确认后可留言，老师确认建议后可反馈执行情况。</text></view>
    <view wx:if="{{consultFeedbackCursor}}" class="service-more"><button loading="{{consultMoreLoading}}" disabled="{{consultMoreLoading}}" bindtap="moreConsultFeedback">查看更早记录</button></view>
   </block>
   <block wx:else>
    <view class="service-panel"><text class="service-section-title">方案审核详情</text><text>学生：{{serviceActive.childName}} · 家长：{{serviceDetail.appointment.contact_name}}</text><text>监护专员：{{serviceDetail.appointment.guardian.display_name || '未分配'}}</text><text>总监：{{serviceDetail.appointment.director.display_name || '待分配'}}</text><text wx:if="{{serviceMeta.phase}}">方案阶段：{{serviceMeta.phase}}</text><text wx:if="{{serviceDetail.staff && serviceMeta.memo}}">备忘录：{{serviceMeta.memo}}</text>
     <block wx:if="{{servicePlan}}"><text wx:if="{{servicePlan.body}}" class="service-message-body">{{servicePlan.body.summary}}</text><text wx:if="{{servicePlan.body.advice}}" class="service-message-body">执行建议：{{servicePlan.body.advice}}</text>
      <view wx:if="{{servicePlan.supplementNote || servicePlan.body.supplementNote}}" class="service-supplement">补充要求：{{servicePlan.supplementNote || servicePlan.body.supplementNote}}</view><text wx:if="{{servicePlan.body.parentSupplement}}">家长补充：{{servicePlan.body.parentSupplement}}</text>
      <view wx:if="{{serviceDetail.staff}}" class="review-flow"><text>监护专员整理</text><text>›</text><text>总监复核</text><text>›</text><text>总管终审</text></view>
<view wx:if="{{serviceDetail.staff}}" class="review-status"><text>{{servicePlan.stageText}}</text><text wx:if="{{servicePlan.availableText}}">{{servicePlan.availableText}} 可见</text></view>
<block wx:if="{{serviceDetail.staff}}">
 <view class="review-actions">
  <button wx:if="{{servicePlan.stage === 'DRAFT' && serviceDetail.appointment.director_id}}" data-id="{{servicePlan.id}}" data-action="SUBMIT" disabled="{{serviceBusy}}" bindtap="reviewServiceItem">提交总监复核</button><view wx:if="{{servicePlan.stage === 'DRAFT' && !serviceDetail.appointment.director_id}}" class="review-hint"><text>本档案还没有分配总监，暂时不能提交复核。</text><text>请由总管前往「我的 → 工作台 → 服务管理」安排。</text></view>
  <button wx:if="{{servicePlan.stage === 'DIRECTOR' && serviceRole === 'DIRECTOR' || servicePlan.stage === 'GENERAL' && serviceCanManage}}" data-id="{{servicePlan.id}}" data-action="APPROVE" disabled="{{serviceBusy}}" bindtap="reviewServiceItem">{{servicePlan.stage === 'GENERAL' ? '终审通过' : '复核通过'}}</button>
  <button wx:if="{{servicePlan.stage === 'DIRECTOR' && serviceRole === 'DIRECTOR' || servicePlan.stage === 'GENERAL' && serviceCanManage}}" data-id="{{servicePlan.id}}" data-action="RETURN" disabled="{{serviceBusy}}" bindtap="reviewServiceItem">退回修改</button>
  <button wx:if="{{servicePlan.kind === 'PLAN' && (servicePlan.stage === 'DIRECTOR' && serviceRole === 'DIRECTOR' || servicePlan.stage === 'GENERAL' && serviceCanManage)}}" data-id="{{servicePlan.id}}" data-action="SUPPLEMENT" disabled="{{serviceBusy}}" bindtap="reviewServiceItem">让家长补充信息</button>
 </view>
 <view wx:for="{{servicePlan.history}}" wx:for-item="log" wx:key="at" class="review-history"><text>{{log.roleText}} · {{log.actionText}} · {{log.timeText}}</text><text wx:if="{{log.note}}">{{log.note}}</text></view>
</block>
     </block><text wx:else>方案尚未提交</text>
     <block wx:if="{{serviceDetail.canDraft && (!servicePlan || servicePlan.stage === 'DRAFT' || servicePlan.stage === 'SUPPLEMENT')}}"><button bindtap="editServicePlan">{{servicePlan ? '编辑方案草稿' : '整理方案'}}</button><block wx:if="{{servicePlanEditing}}"><textarea maxlength="16000" placeholder="方案内容" value="{{servicePlanSummary}}" data-field="servicePlanSummary" bindinput="inputService" /><textarea maxlength="10000" placeholder="执行建议" value="{{servicePlanAdvice}}" data-field="servicePlanAdvice" bindinput="inputService" /><button class="service-primary" disabled="{{serviceBusy}}" bindtap="saveServiceDraft">保存方案草稿</button></block></block>
     <block wx:if="{{serviceDetail.owner && servicePlan.stage === 'SUPPLEMENT'}}"><textarea maxlength="6000" placeholder="按老师要求补充信息" value="{{serviceInput}}" bindinput="inputService" /><button class="service-primary" disabled="{{serviceBusy}}" bindtap="supplementServiceCase">提交补充信息</button></block>
    </view>
   </block>
   <view wx:if="{{serviceDetail.staff && serviceTab === 'plan' && servicePlan}}" class="service-panel service-review-settings">
    <button class="service-settings-toggle" aria-expanded="{{serviceReviewSettingsOpen}}" bindtap="toggleServiceReviewSettings"><view><text>审核设置</text><text>退回说明{{serviceCanManage ? ' · 家长可见时间' : ''}}</text></view><text>{{serviceReviewSettingsOpen ? '收起 −' : '展开 +'}}</text></button>
    <block wx:if="{{serviceReviewSettingsOpen}}">
     <text class="service-field-label">退回 / 补充说明</text><textarea aria-label="退回或补充说明" placeholder="填写原因或需要补充的信息" value="{{serviceNote}}" data-field="serviceNote" bindinput="inputService" maxlength="2000" /><text class="service-field-help">退回修改或要求补充时必填。</text>
     <view wx:if="{{serviceCanManage}}" class="service-release"><text class="service-field-label">终审通过后，对家长开放</text><view class="service-release-control"><input aria-label="终审后的开放延迟小时数" type="digit" value="{{serviceReleaseHours}}" data-field="serviceReleaseHours" bindinput="inputService" /><text>小时后</text></view><text class="service-field-help">填 0 即审核通过后立即可见。</text></view>
    </block>
   </view>
   <view id="service-feedback-end" class="service-feedback-end"></view>
  </scroll-view>
  <view wx:if="{{(serviceTab === 'feedback' || serviceDetail.owner && serviceTab === 'archive')}}" class="service-composer">
   <view wx:if="{{serviceQuote && (serviceDetail.owner || serviceTab === 'feedback' && canTalk)}}" class="service-quote-bar"><text>{{serviceQuote.label}}：{{serviceQuote.text}}</text><button aria-label="取消引用" bindtap="clearServiceQuote">×</button></view>
   <block wx:if="{{serviceDetail.owner}}">
    <view class="service-composer-head"><text class="service-composer-label">反馈给老师 · 左滑消息，点击引用</text></view>
    <view class="service-composer-actions"><textarea aria-label="家长反馈内容" auto-height maxlength="6000" value="{{serviceInput}}" placeholder="填写执行情况，或想反馈的问题…" bindinput="inputService" disabled="{{serviceBusy}}" /><button class="service-primary" disabled="{{serviceBusy || !serviceInput}}" bindtap="sendServiceFeedback">发送反馈</button></view>
   </block>
   <block wx:elif="{{serviceTab === 'feedback' && canTalk}}">
    <text class="service-composer-label">直接给家长发消息 · 左滑消息，点击引用</text>
    <text wx:if="{{dialogueError}}" class="service-composer-error">{{dialogueError}}</text>
    <view class="service-composer-actions"><textarea aria-label="给家长的消息" auto-height maxlength="6000" value="{{dialogueContent}}" placeholder="给家长发消息…" bindinput="inputDialogue" disabled="{{dialogueSending}}" /><button class="service-primary" loading="{{dialogueSending}}" disabled="{{dialogueSending || !dialogueContent}}" bindtap="sendServiceDialogue">发送</button></view>
   </block>
   <view wx:else class="service-composer-notice"><text>当前账号仅可查看这个孩子的沟通记录</text><text>需要回复家长时，请由负责老师直接发消息。</text></view>
  </view>
 </block>
 <view wx:if="{{serviceDrawer}}" class="service-drawer-root"><view class="service-drawer-mask" bindtap="closeServiceDrawer"></view><view class="service-drawer">
  <view class="service-drawer-heading"><view><text>孩子档案</text><text>{{serviceRoleLabel}} · 共 {{serviceCases.length}} 个档案{{serviceOtherUnread > 0 ? ' · ' + serviceOtherUnread + ' 条新消息' : ''}}</text></view><button aria-label="关闭档案列表" bindtap="closeServiceDrawer">×</button></view>
  <view class="service-search-row"><input placeholder="查找孩子、家长或反馈" value="{{serviceSearch}}" bindinput="searchServiceCases" /><button bindtap="sortServiceCases">{{serviceSortNewest ? '最新' : '最早'}} ↕</button><picker range="{{serviceLevels}}" value="{{serviceLevelFilter}}" bindchange="changeServiceLevel"><view class="service-filter-picker">等级 ⌄</view></picker></view>
  <view class="service-list-tabs"><button class="{{serviceFilter === 'ALL' ? 'active' : ''}}" data-filter="ALL" bindtap="changeServiceFilter">全部</button><button class="{{serviceFilter === 'PENDING' ? 'active' : ''}}" data-filter="PENDING" bindtap="changeServiceFilter">待回复</button><button class="{{serviceFilter === 'PRIORITY' ? 'active' : ''}}" data-filter="PRIORITY" bindtap="changeServiceFilter">重点</button><button wx:if="{{serviceStaff}}" class="{{serviceFilter === 'DIRECTOR' ? 'active' : ''}}" data-filter="DIRECTOR" bindtap="changeServiceFilter">总监审核</button><button wx:if="{{serviceCanManage}}" class="{{serviceFilter === 'GENERAL' ? 'active' : ''}}" data-filter="GENERAL" bindtap="changeServiceFilter">总管审核</button></view>
  <scroll-view scroll-y class="service-drawer-list"><view wx:for="{{serviceCases}}" wx:key="id" class="service-case-item {{serviceActive.id === item.id ? 'selected' : ''}}" data-id="{{item.id}}" bindtap="selectServiceCase"><view class="service-list-avatar">{{item.childName[0]}}<text wx:if="{{item.unread > 0}}" class="service-list-unread">{{item.unread > 99 ? '99+' : item.unread}}</text></view><view class="service-list-main"><view><text class="service-case-name">{{item.childName}}</text><text wx:if="{{serviceStaff && item.metadata.level}}" class="service-grade">{{item.metadata.level}}{{item.metadata.subLevel}}</text><text wx:if="{{serviceStaff && item.metadata.priority}}" class="service-priority">重点</text><text wx:if="{{item.pending}}" class="service-pending">{{item.pending}}条待回复</text><text wx:if="{{item.latestTimeText}}" class="service-list-time">{{item.latestTimeText}}</text></view><text class="service-list-preview {{item.unread > 0 ? 'unread' : ''}}"><text wx:if="{{item.latestFrom}}" class="service-list-from">{{item.latestFrom}}：</text>{{item.latest}}</text><text class="service-list-owner">{{item.parentName}} · {{item.guardianName || '未分配监护专员'}}</text><text wx:if="{{serviceStaff && item.metadata.danger}}" class="service-list-danger">危险因素：{{item.metadata.danger}}</text></view></view><view wx:if="{{!serviceCases.length}}" class="service-empty">没有符合条件的档案</view><button wx:if="{{serviceCaseCursor}}" bindtap="moreServiceCases">加载更多档案</button></scroll-view>
 </view></view>
</view>

<view wx:if="{{!serviceMode}}" class="chat-page">
  <view class="chat-nav" style="height: {{navHeight}}px; padding-top: {{statusBarHeight}}px; padding-right: {{navPaddingRight}}px;">
    <button aria-label="返回" class="nav-back" bindtap="goBack">‹</button>
    <view class="nav-title">
      <view
        class="nav-mark {{canOpenSessionDrawer ? 'nav-mark-button nav-mark-avatar-wrap' : ''}} {{sessionDrawerVisible ? 'nav-mark-active' : ''}}"
        catchtap="onNavMarkTap"
      >
        <image
          wx:if="{{isManagerView && customerAvatarUrl}}"
          class="nav-mark-avatar-image"
          src="{{customerAvatarUrl}}"
          mode="aspectFill"
        ></image>
        <text wx:elif="{{isManagerView}}" class="nav-mark-avatar-text">{{customerAvatarText || '客'}}</text>
        <text wx:elif="{{canOpenSessionDrawer}}" class="nav-mark-list-icon">☰</text>
        <text wx:else>✦</text>
        <text wx:if="{{canOpenSessionDrawer && managerTotalUnread > 0}}" class="nav-mark-badge">{{managerTotalUnread > 99 ? '99+' : managerTotalUnread}}</text>
      </view>
      <view class="{{canOpenSessionDrawer ? 'nav-title-copy-button' : ''}}" catchtap="onNavMarkTap">
        <text class="title-name">{{chatTitle}}</text>
        <text class="title-sub">{{chatSubtitle}}</text>
      </view>
    </view>
  </view>

  <button class="service-return-entry" bindtap="showServiceFeedback">孩子档案与方案反馈 ›</button>

  <scroll-view class="chat-scroll" scroll-y scroll-with-animation scroll-into-view="{{scrollIntoView}}">
    <view wx:if="{{!messages.length}}" class="chat-empty">
      <view class="chat-empty-mark"><text>知</text></view>
      <text class="chat-empty-title">暂时还没有创建相应的聊天。</text>
    </view>
    <view wx:else class="system-card">
      <text>{{systemText}}</text>
    </view>

    <view class="messages">
      <block wx:for="{{messages}}" wx:key="id">
        <view wx:if="{{item.type === 'recall-notice'}}" id="msg-{{item.id}}" class="message-row recall-row">
          <view class="recall-notice">
            <text class="recall-notice-text">你撤回了一条消息</text>
            <text wx:if="{{item.canReedit}}" class="recall-reedit" data-id="{{item.id}}" catchtap="onReeditRecall">重新编辑</text>
          </view>
        </view>
        <view wx:elif="{{item.content}}" id="msg-{{item.id}}" class="message-row {{item.role}}">
          <view wx:if="{{item.role === 'assistant'}}" class="message-avatar {{canOpenSessionDrawer ? 'message-avatar-button' : ''}}" catchtap="onCustomerAvatarTap">
            <image wx:if="{{leftAvatarUrl}}" class="chat-avatar-image" src="{{leftAvatarUrl}}" mode="aspectFill"></image>
            <text wx:else>{{leftAvatarText}}</text>
          </view>
          <view
            class="bubble"
            catchlongpress="{{isManagerView && item.role === 'user' && item.senderRole === 'manager' && !item.isRecalled ? 'onMessageLongPress' : ''}}"
            data-id="{{item.id}}"
          >
            <text>{{item.content}}</text>
          </view>
          <view wx:if="{{item.role === 'user'}}" class="user-message-avatar">
            <image wx:if="{{rightAvatarUrl}}" class="chat-avatar-image" src="{{rightAvatarUrl}}" mode="aspectFill"></image>
            <text wx:else>{{rightAvatarText}}</text>
          </view>
        </view>
      </block>
    </view>
  </scroll-view>

  <view class="chat-footer">
    <view wx:if="{{sendError}}" class="send-error"><text>{{sendError}}</text><text wx:if="{{failedMessage}}" class="failed-message" selectable>{{failedMessage}}</text><view class="send-recovery"><button bindtap="loadBackendMessages">刷新记录</button><button bindtap="copyUnsentMessage">复制原文</button></view></view>
    <view wx:if="{{hasAccess && !serviceEnded}}" class="chat-composer">
      <textarea auto-height maxlength="4000" class="composer-input" placeholder="{{composerPlaceholder}}" value="{{input}}" confirm-type="send" disabled="{{sending || !hasAccess || serviceEnded}}" bindinput="onInput" bindconfirm="sendMessage" />
      <button aria-label="发送消息" loading="{{sending}}" class="composer-send {{serviceEnded || !hasAccess ? 'disabled' : ''}}" disabled="{{sending || !hasAccess || serviceEnded || !input}}" bindtap="sendMessage">↑</button>
    </view>
  </view>

  <view wx:if="{{sessionDrawerVisible}}" class="session-drawer-root">
    <view
      class="session-drawer-mask"
      bindtap="closeSessionDrawer"
      catchtouchmove="preventTouchMove"
    ></view>
    <view class="session-drawer session-drawer-open" catchtouchmove="preventTouchMove">
      <view class="session-drawer-header">
        <view>
          <text class="session-drawer-title">我的客户</text>
        </view>
        <text wx:if="{{managerTotalUnread > 0}}" class="session-drawer-count">{{managerTotalUnread > 99 ? '99+' : managerTotalUnread}}</text>
      </view>
      <scroll-view scroll-y class="session-drawer-list" show-scrollbar="{{false}}">
        <view
          wx:for="{{managerSessionList}}"
          wx:key="id"
          class="session-drawer-item {{item.active ? 'active' : ''}}"
          data-id="{{item.id}}"
          bindtap="switchToManagerSession"
        >
          <view class="session-drawer-avatar">
            <image wx:if="{{item.avatarUrl}}" class="session-drawer-avatar-image" src="{{item.avatarUrl}}" mode="aspectFill"></image>
            <text wx:else>{{item.avatarText}}</text>
            <text wx:if="{{item.unreadCount > 0}}" class="session-drawer-unread">{{item.unreadCount > 99 ? '99+' : item.unreadCount}}</text>
          </view>
          <view class="session-drawer-body">
            <view class="session-drawer-row">
              <text class="session-drawer-name">{{item.name}}</text>

            </view>
            <text class="session-drawer-preview">{{item.topic}}</text>
            <view class="session-drawer-meta">
              <text class="session-drawer-status {{item.displayStatus}}">{{item.statusLabel}}</text>
            </view>
          </view>
        </view>
        <view wx:if="{{!managerSessionList.length && !managerSessionLoading}}" class="session-drawer-empty">
          暂无进行中的客户会话
        </view>
        <view wx:if="{{managerSessionLoading}}" class="session-drawer-empty">加载中...</view>
      </scroll-view>
    </view>
  </view>
</view>
