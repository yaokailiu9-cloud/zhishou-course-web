<view class="profile-page safe-bottom">
  <view class="custom-nav" style="height: {{navHeight}}px; padding-top: {{statusBarHeight}}px;">
    <text class="nav-brand">知守</text>
  </view>

  <block wx:if="{{!isLoggedIn}}">
    <view class="login-screen">
      <view class="login-brand">
        <view class="login-avatar-shell">
          <button class="login-avatar-picker" open-type="chooseAvatar" bindchooseavatar="onChooseLoginAvatar">
            <image wx:if="{{loginForm.avatarUrl}}" class="login-avatar-img" src="{{loginForm.avatarUrl}}" mode="aspectFill"></image>
            <image wx:else class="login-avatar-img" src="{{defaultPortrait}}" mode="aspectFill"></image>
          </button>
          <view class="login-avatar-badge">头像</view>
        </view>
        <text class="login-title">欢迎来到知守</text>
        <text class="login-subtitle">使用微信身份登录，一个微信仅对应一个账户</text>
      </view>

      <view class="login-card">
        <view class="login-field">
          <text class="login-prefix">名</text>
          <input
            class="login-input"
            type="nickname"
            maxlength="20"
            placeholder="设置你的唯一用户名"
            placeholder-class="login-placeholder"
            value="{{loginForm.nickName}}"
            bindinput="onLoginNickNameInput"
          />
        </view>
      </view>

      <button class="login-button {{loginLoading ? 'is-loading' : ''}}" loading="{{loginLoading}}" disabled="{{loginLoading}}" bindtap="loginByWechat">微信登录</button>

      <text class="login-status">{{loginTip}}</text>

      <view class="login-benefits">
        <view class="login-benefit-item">
          <view class="benefit-dot"></view>
          <text>首次登录需设置头像和唯一用户名</text>
        </view>
        <view class="login-benefit-item">
          <view class="benefit-dot"></view>
          <text>再次登录时，同一微信将自动进入原账户</text>
        </view>
      </view>

      <view class="login-agreement">
        <text>登录即代表你已阅读并同意</text>
        <text class="agreement-link" bindtap="goPrivacy">《隐私与安全说明》</text>
      </view>
    </view>
  </block>

  <block wx:else>
    <view class="member-hero">
      <view class="profile-photo">
        <image wx:if="{{userInfo.avatarUrl}}" class="profile-photo-img" src="{{userInfo.avatarUrl}}" mode="aspectFill"></image>
        <image wx:else class="profile-photo-img" src="{{defaultPortrait}}" mode="aspectFill"></image>
        <view class="photo-accent"></view>
      </view>
      <text class="profile-name">{{userInfo.nickName || serviceProvider.displayName || '微信用户'}}</text>
      <text class="profile-badge">{{isServiceProvider ? '已认证 · 在线服务' : '客户中心'}}</text>
      <text wx:if="{{isServiceProvider}}" class="profile-quote">你的工作身份已启用，可进入工作台查看会话。</text>
      <button class="edit-button" bindtap="goEditProfile">编辑个人资料</button>
    </view>

    <view wx:if="{{isServiceProvider}}" class="manager-panel">
      <view class="manager-panel-head">
        <text class="manager-title">工作台</text>
        <text class="manager-state">{{serviceProvider.onlineStatus === 'online' ? '在线' : '离线'}}</text>
      </view>
      <view class="manager-stats">
        <view wx:for="{{managerStats}}" wx:key="label" class="manager-stat">
          <text class="manager-stat-value">{{item.value}}</text>
          <text class="manager-stat-label">{{item.label}}</text>
        </view>
      </view>
      <button class="manager-button" data-view="workbench" bindtap="goManagerSection">进入工作台</button>
    </view>

    <view wx:else class="wealth-grid">
      <view class="wealth-card net-worth">
        <view>
          <text class="wealth-label">累计消费</text>
          <view class="wealth-value"><text>¥</text>{{accountBalanceText}}</view>
        </view>
        <view class="wallet-ghost">▣</view>
      </view>
    </view>

    <view class="settings-section">
      <text class="settings-caption">客户服务</text>
      <view class="settings-row" bindtap="goCustomerPortal">
        <view class="settings-copy"><text class="settings-title">进入客户端</text><text class="settings-desc">我的报名、线下预约、孩子基础信息与执行反馈</text></view>
        <text class="settings-arrow">›</text>
      </view>
      <view class="settings-row" bindtap="goPublicClasses">
        <view class="settings-copy"><text class="settings-title">免费公开课</text><text class="settings-desc">报名参加后，可申请线下咨询</text></view>
        <text class="settings-arrow">›</text>
      </view>
      <view wx:if="{{isServiceProvider}}" class="settings-row" bindtap="goOfflineWorkbench">
        <view class="settings-copy"><text class="settings-title">公开课与线下咨询管理</text><text class="settings-desc">报名、到课核实、预约确认与反馈回复</text></view>
        <text class="settings-arrow">›</text>
      </view>
    </view>

    <view class="settings-section">
      <text class="settings-caption">系统与偏好</text>
      <view wx:if="{{testCustomerPreviewActive}}" class="settings-row test-preview-row" bindtap="exitTestCustomerPreview">
        <view class="settings-copy">
          <text class="settings-title">退出客户端测试</text>
          <text class="settings-desc">当前为测试客户小安，点此恢复经理身份</text>
        </view>
        <text class="settings-arrow">›</text>
      </view>
      <view class="settings-row" bindtap="goPrivacy">
        <view class="settings-copy">
          <text class="settings-title">隐私与安全</text>
          <text class="settings-desc">管理登录、手机号与隐私授权</text>
        </view>
        <text class="settings-arrow">›</text>
      </view>
      <view class="settings-row" bindtap="goSupport">
        <view class="settings-copy">
          <text class="settings-title">帮助与支持</text>
          <text class="settings-desc">报名、咨询与资料管理帮助</text>
        </view>
        <text class="settings-arrow">›</text>
      </view>
      <view class="settings-row" bindtap="goAbout">
        <view class="settings-copy">
          <text class="settings-title">关于 知守</text>
          <text class="settings-desc">了解服务与当前版本</text>
        </view>
        <text class="settings-arrow">›</text>
      </view>
      <view class="logout-row" bindtap="logout">
        <text>退出当前账号</text>
      </view>
    </view>
  </block>
</view>
