.profile-page {
  min-height: 100vh;
  padding: 0 var(--em-page-x) 176rpx;
  color: var(--em-color-primary);
  background: #fbf9f8;
  font-family: var(--em-font-family);
}

.custom-nav {
  position: relative;
  display: flex;
  align-items: flex-end;
  justify-content: center;
  width: calc(100% + 2 * var(--em-page-x));
  min-height: 104rpx;
  margin: 0 calc(-1 * var(--em-page-x)) 36rpx;
  box-sizing: border-box;
}

.nav-brand {
  position: absolute;
  left: 0;
  right: 0;
  bottom: 0;
  height: 64rpx;
  color: var(--em-color-primary);
  font-family: var(--em-font-serif);
  font-size: 46rpx;
  font-style: italic;
  font-weight: 700;
  line-height: 64rpx;
  text-align: center;
  pointer-events: none;
}

.member-hero {
  display: flex;
  flex-direction: column;
  align-items: center;
  text-align: center;
}

.profile-photo {
  position: relative;
  width: 176rpx;
  height: 176rpx;
  margin-top: 4rpx;
  border-radius: 50%;
  box-shadow: 0 18rpx 54rpx rgba(0, 39, 39, 0.13);
}

.profile-photo-img {
  display: block;
  box-sizing: border-box;
  width: 100%;
  height: 100%;
  border: 6rpx solid #fff6dd;
  border-radius: 50%;
}

.photo-accent {
  position: absolute;
  right: -2rpx;
  bottom: 14rpx;
  width: 52rpx;
  height: 52rpx;
  background: var(--em-color-gold);
  border-radius: 50%;
  box-shadow: 0 10rpx 22rpx rgba(115, 92, 0, 0.16);
}

.profile-name {
  display: block;
  max-width: 100%;
  margin-top: 30rpx;
  overflow: hidden;
  color: var(--em-color-primary);
  font-size: 44rpx;
  font-weight: 800;
  line-height: 1.15;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.profile-badge {
  display: flex;
  align-items: center;
  justify-content: center;
  min-width: 448rpx;
  height: 36rpx;
  margin-top: 14rpx;
  color: var(--em-color-gold-strong);
  font-size: 24rpx;
  font-weight: 800;
  background: rgba(254, 214, 91, 0.18);
  border-radius: var(--em-radius-pill);
}

.profile-quote {
  display: block;
  max-width: 612rpx;
  margin-top: 24rpx;
  color: var(--em-color-text-secondary);
  font-size: 26rpx;
  line-height: 1.7;
}

.edit-button,
.avatar-auth {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 212rpx;
  height: 66rpx;
  margin-top: 22rpx;
  color: var(--em-color-primary);
  font-size: 23rpx;
  font-weight: 800;
  background: #ffffff;
  border: 1rpx solid var(--em-color-border-strong);
  border-radius: var(--em-radius-lg);
}

.avatar-auth {
  margin-top: 34rpx;
}

.login-screen {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 40rpx 44rpx 0;
  text-align: center;
}

.login-brand {
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-top: 24rpx;
}

.login-avatar-shell {
  position: relative;
  width: 148rpx;
  height: 148rpx;
}

.login-avatar-picker {
  display: block;
  width: 148rpx;
  height: 148rpx;
  padding: 0;
  margin: 0;
  overflow: hidden;
  background: transparent;
  border-radius: 50%;
}

.login-avatar-img {
  display: block;
  width: 148rpx;
  height: 148rpx;
  border: 6rpx solid #fff6dd;
  border-radius: 50%;
  box-shadow: 0 22rpx 54rpx rgba(0, 39, 39, 0.22);
}

.login-avatar-badge {
  position: absolute;
  right: -4rpx;
  bottom: 8rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  height: 40rpx;
  padding: 0 14rpx;
  color: var(--em-color-primary);
  font-size: 18rpx;
  font-weight: 800;
  background: var(--em-color-gold);
  border-radius: var(--em-radius-pill);
}

.login-logo {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 148rpx;
  height: 148rpx;
  color: #fff6dd;
  font-size: 64rpx;
  font-weight: 900;
  background: var(--em-color-primary);
  border-radius: 50%;
  box-shadow: 0 22rpx 54rpx rgba(0, 39, 39, 0.22);
}

.login-title {
  margin-top: 28rpx;
  color: var(--em-color-primary);
  font-size: 46rpx;
  font-weight: 800;
  line-height: 1.2;
}

.login-subtitle {
  max-width: 560rpx;
  margin-top: 14rpx;
  color: var(--em-color-text-secondary);
  font-size: 24rpx;
  font-weight: 600;
  line-height: 1.55;
}

.login-card {
  width: 100%;
  margin-top: 64rpx;
  overflow: hidden;
  background: #ffffff;
  border: 1rpx solid var(--em-color-border);
  border-radius: 28rpx;
  box-shadow: 0 16rpx 40rpx rgba(0, 39, 39, 0.06);
}

.login-field {
  display: flex;
  align-items: center;
  height: 104rpx;
  padding: 0 30rpx;
}

.login-field + .login-field {
  border-top: 1rpx solid var(--em-color-border);
}

.login-prefix {
  flex-shrink: 0;
  margin-right: 22rpx;
  color: var(--em-color-primary);
  font-size: 27rpx;
  font-weight: 800;
}

.login-prefix-icon {
  width: 42rpx;
  color: var(--em-color-gold-strong);
  text-align: center;
}

.login-input {
  flex: 1;
  min-width: 0;
  height: 104rpx;
  padding: 0;
  color: var(--em-color-primary);
  font-size: 28rpx;
  text-align: left;
  background: transparent;
  border: 0;
}

.login-placeholder {
  color: rgba(0, 39, 39, 0.32);
}

.login-code-btn {
  flex-shrink: 0;
  min-width: 148rpx;
  margin-left: 16rpx;
  padding: 0 24rpx;
  color: #ffffff;
  font-size: 24rpx;
  font-weight: 700;
  line-height: 60rpx;
  text-align: center;
  background: var(--em-color-primary);
  border-radius: 30rpx;
}

.login-code-btn.is-disabled {
  color: var(--em-color-text-secondary);
  background: rgba(0, 39, 39, 0.06);
}

.login-button {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 100%;
  height: 96rpx;
  margin-top: 44rpx;
  color: #ffffff;
  font-size: 30rpx;
  font-weight: 800;
  letter-spacing: 6rpx;
  background: var(--em-color-primary);
  border-radius: 48rpx;
  box-shadow: 0 18rpx 40rpx rgba(0, 39, 39, 0.22);
}

.login-button[disabled] {
  color: rgba(255, 255, 255, 0.7);
  background: rgba(0, 39, 39, 0.55);
}

.login-status {
  display: block;
  min-height: 34rpx;
  max-width: 100%;
  margin-top: 24rpx;
  color: var(--em-color-gold-strong);
  font-size: 23rpx;
  line-height: 1.55;
}

.login-benefits {
  display: flex;
  flex-direction: column;
  gap: 18rpx;
  align-items: center;
  width: 100%;
  margin-top: 40rpx;
  padding: 30rpx 32rpx;
  background: rgba(254, 214, 91, 0.12);
  border-radius: 24rpx;
}

.login-benefit-item {
  display: flex;
  align-items: center;
  color: var(--em-color-text-secondary);
  font-size: 23rpx;
  line-height: 1.5;
  text-align: left;
}

.benefit-dot {
  flex-shrink: 0;
  width: 10rpx;
  height: 10rpx;
  margin-right: 16rpx;
  background: var(--em-color-gold-strong);
  border-radius: 50%;
}

.login-agreement {
  display: flex;
  align-items: center;
  justify-content: center;
  margin-top: 44rpx;
  color: var(--em-color-text-secondary);
  font-size: 21rpx;
}

.agreement-link {
  color: var(--em-color-primary);
  font-weight: 700;
}

.wealth-grid {
  display: grid;
  margin-top: 64rpx;
}

.wealth-card {
  position: relative;
  display: flex;
  justify-content: space-between;
  min-height: 196rpx;
  padding: 44rpx;
  overflow: hidden;
  background: #ffffff;
  border: 1rpx solid var(--em-color-border-muted);
  border-radius: 32rpx;
  box-shadow: 0 10rpx 32rpx rgba(0, 39, 39, 0.04);
}

.wealth-label {
  display: block;
  color: var(--em-color-text-secondary);
  font-size: 24rpx;
  font-weight: 700;
}

.wealth-value {
  display: flex;
  align-items: baseline;
  margin-top: 24rpx;
  color: var(--em-color-primary);
  font-family: "Songti SC", "STSong", "SimSun", serif;
  font-size: 50rpx;
  font-weight: 700;
  line-height: 1;
}

.wealth-value text {
  margin-right: 10rpx;
  font-family: "Songti SC", "STSong", "SimSun", serif;
  font-size: 34rpx;
}

.wallet-ghost {
  position: absolute;
  right: -12rpx;
  bottom: -18rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  width: 132rpx;
  height: 132rpx;
  color: rgba(115, 92, 0, 0.42);
  font-size: 60rpx;
  background: rgba(228, 226, 226, 0.64);
  border-radius: 18rpx;
}

.manager-panel {
  margin-top: 28rpx;
  padding: 32rpx 28rpx;
  color: #ffffff;
  background: var(--em-color-primary);
  border-radius: 28rpx;
  box-shadow: 0 18rpx 40rpx rgba(0, 39, 39, 0.16);
}

.manager-panel-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
}

.manager-title {
  display: block;
  font-size: 34rpx;
  font-weight: 800;
  line-height: 1.25;
}

.manager-state {
  flex: 0 0 auto;
  padding: 8rpx 18rpx;
  color: var(--em-color-primary);
  font-size: 24rpx;
  font-weight: 800;
  background: #fff6dd;
  border-radius: var(--em-radius-pill);
}

.manager-stats {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 16rpx;
  width: 100%;
  margin-top: 24rpx;
  box-sizing: border-box;
}

.manager-stat {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
  min-width: 0;
  min-height: 120rpx;
  padding: 22rpx 16rpx;
  text-align: center;
  background: rgba(255, 255, 255, 0.08);
  border: 1rpx solid rgba(255, 255, 255, 0.12);
  border-radius: 18rpx;
}

.manager-stat-value,
.manager-stat-label {
  display: block;
  width: 100%;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.manager-stat-value {
  font-size: 40rpx;
  font-weight: 800;
  line-height: 1.1;
}

.manager-stat-label {
  margin-top: 10rpx;
  color: rgba(255, 255, 255, 0.72);
  font-size: 24rpx;
  font-weight: 700;
}

.manager-button {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 68rpx;
  margin-top: 24rpx;
  color: var(--em-color-primary);
  font-size: 24rpx;
  font-weight: 800;
  background: #ffffff;
  border-radius: var(--em-radius-lg);
}

.customer-preview-button {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 68rpx;
  margin-top: 16rpx;
  color: #ffffff;
  font-size: 24rpx;
  font-weight: 700;
  background: rgba(255, 255, 255, 0.14);
  border: 1rpx solid rgba(255, 255, 255, 0.28);
  border-radius: var(--em-radius-lg);
}

.settings-section {
  width: 100%;
  margin-top: 72rpx;
}

.settings-caption {
  display: block;
  padding: 0 0 30rpx;
  color: var(--em-color-text-secondary);
  font-size: 24rpx;
  font-weight: 600;
  border-bottom: 1rpx solid var(--em-color-border-muted);
}

.settings-row,
.logout-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  width: 100%;
  min-height: 144rpx;
  padding: 28rpx 0;
  background: transparent;
  border-bottom: 1rpx solid var(--em-color-border-muted);
  text-align: left;
}

.settings-row-switch {
  align-items: center;
}

.test-preview-row {
  background: rgba(15, 118, 110, 0.05);
}

.settings-copy {
  display: flex;
  flex: 1;
  flex-direction: column;
  align-items: flex-start;
  min-width: 0;
  padding-right: 32rpx;
  text-align: left;
}

.settings-title {
  display: block;
  color: var(--em-color-primary);
  font-size: 28rpx;
  font-weight: 500;
  line-height: 1.35;
  white-space: nowrap;
}

.settings-desc {
  display: block;
  margin-top: 10rpx;
  color: var(--em-color-text-secondary);
  font-size: 21rpx;
  font-weight: 600;
  line-height: 1.45;
  white-space: nowrap;
}

.settings-arrow {
  flex: 0 0 72rpx;
  width: 72rpx;
  margin-right: -8rpx;
  color: var(--em-color-text-muted);
  font-size: 48rpx;
  font-weight: 300;
  text-align: right;
}

.logout-row {
  justify-content: flex-start;
  min-height: 132rpx;
  color: #c84b45;
  font-size: 30rpx;
  font-weight: 400;
  border-bottom: 0;
}

.logout-row text {
  display: block;
}
