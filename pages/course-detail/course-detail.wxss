.detail-page {
  min-height: 100vh;
  color: var(--em-color-primary);
  background: #fbf9f8;
  font-family: var(--em-font-family);
}

.detail-nav {
  position: fixed;
  top: 0;
  right: 0;
  left: 0;
  z-index: 30;
  box-sizing: border-box;
  padding: 0;
  background: rgba(251, 249, 248, 0.9);
  backdrop-filter: blur(18px);
}

.nav-back {
  position: absolute;
  bottom: 12rpx;
  left: calc(var(--em-page-x) + 12rpx);
  z-index: 2;
  display: flex;
  align-items: center;
  justify-content: flex-start;
  width: 56rpx;
  height: 64rpx;
  padding: 0;
  margin: 0;
  color: var(--em-color-primary);
  font-size: 44rpx;
  font-weight: 400;
  line-height: 1;
  background: transparent;
  border-radius: 0;
}

.nav-back::after {
  border: none;
}

.nav-title {
  position: absolute;
  right: 0;
  bottom: 12rpx;
  left: 0;
  height: 64rpx;
  color: var(--em-color-primary);
  font-size: 30rpx;
  font-weight: 800;
  line-height: 64rpx;
  text-align: center;
  pointer-events: none;
}

.detail-scroll {
  height: 100vh;
  padding-bottom: calc(32rpx + env(safe-area-inset-bottom));
}

.video-hero {
  position: relative;
  width: 100%;
  height: 420rpx;
  overflow: hidden;
  background: var(--em-color-primary);
}

.hero-cover {
  display: block;
  width: 100%;
  height: 100%;
}

.course-video {
  display: block;
  width: 100%;
  height: 100%;
  background: #000000;
}

.hero-mask {
  position: absolute;
  inset: 0;
  background: linear-gradient(180deg, rgba(0, 39, 39, 0.08) 0%, rgba(0, 39, 39, 0.35) 100%);
}

.play-button {
  position: absolute;
  top: 50%;
  left: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  width: 108rpx;
  height: 108rpx;
  background: rgba(255, 255, 255, 0.92);
  border-radius: 50%;
  box-shadow: 0 16rpx 40rpx rgba(0, 39, 39, 0.18);
  transform: translate(-50%, -50%);
}

.play-triangle {
  width: 0;
  height: 0;
  margin-left: 8rpx;
  border-top: 16rpx solid transparent;
  border-bottom: 16rpx solid transparent;
  border-left: 26rpx solid var(--em-color-primary);
}

.hero-duration {
  position: absolute;
  right: 24rpx;
  bottom: 24rpx;
  padding: 6rpx 14rpx;
  color: #ffffff;
  font-size: 24rpx;
  font-weight: 700;
  background: rgba(0, 0, 0, 0.55);
  border-radius: 10rpx;
}

.detail-main {
  padding: 28rpx var(--em-page-x) 0;
}

.title-block {
  margin-bottom: 32rpx;
}

.course-title {
  display: block;
  color: var(--em-color-primary);
  font-size: 40rpx;
  font-weight: 800;
  line-height: 1.35;
}

.course-subtitle {
  display: block;
  margin-top: 12rpx;
  color: var(--em-color-text-secondary);
  font-size: 26rpx;
  line-height: 1.55;
}

.catalog-head {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  margin-bottom: 20rpx;
}

.catalog-title {
  color: var(--em-color-primary);
  font-size: 32rpx;
  font-weight: 800;
}

.catalog-count {
  color: var(--em-color-text-secondary);
  font-size: 24rpx;
  font-weight: 600;
}

.catalog-panel {
  overflow: hidden;
  background: #ffffff;
  border: 1rpx solid var(--em-color-border-muted);
  border-radius: 20rpx;
}

.chapter-row {
  display: flex;
  align-items: center;
  gap: 18rpx;
  padding: 26rpx 24rpx;
  border-bottom: 1rpx solid var(--em-color-border-muted);
}

.chapter-row:last-child {
  border-bottom: 0;
}

.chapter-row.active {
  background: rgba(0, 39, 39, 0.04);
}

.chapter-play-tag {
  flex-shrink: 0;
  padding: 6rpx 12rpx;
  color: var(--em-color-primary);
  font-size: 24rpx;
  font-weight: 700;
  background: var(--em-color-primary-soft);
  border-radius: 999rpx;
}

.chapter-index {
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  width: 44rpx;
  height: 44rpx;
  color: var(--em-color-primary);
  font-size: 24rpx;
  font-weight: 800;
  background: var(--em-color-primary-soft);
  border-radius: 12rpx;
}

.chapter-copy {
  flex: 1;
  min-width: 0;
}

.chapter-title {
  display: block;
  color: var(--em-color-primary);
  font-size: 26rpx;
  font-weight: 700;
  line-height: 1.4;
}

.chapter-duration {
  display: block;
  margin-top: 6rpx;
  color: var(--em-color-text-muted);
  font-size: 24rpx;
}

.catalog-empty {
  padding: 64rpx 32rpx;
  text-align: center;
  background: #ffffff;
  border: 1rpx solid var(--em-color-border-muted);
  border-radius: 20rpx;
}

.catalog-empty-title {
  display: block;
  color: var(--em-color-primary);
  font-size: 28rpx;
  font-weight: 800;
}

.catalog-empty-desc {
  display: block;
  margin-top: 10rpx;
  color: var(--em-color-text-secondary);
  font-size: 24rpx;
}

.detail-course-badge { position:absolute; top:24rpx; left:24rpx; padding:8rpx 20rpx; background:#e5ce99; color:#002727; font-size:24rpx; border-radius:6rpx; }
.course-info-section { padding:32rpx 0; border-top:1rpx solid #e6e1da; }
.course-info-title { display:block; margin-bottom:18rpx; font-family:var(--em-font-serif); font-size:32rpx; line-height:1.5; }
.course-info-body { display:block; color:#515e5a; font-size:27rpx; line-height:1.9; white-space:pre-wrap; overflow-wrap:break-word; }
