<view class="detail-page">
  <view class="detail-nav" style="height: {{navHeight}}px; padding-top: {{statusBarHeight}}px; padding-right: {{navPaddingRight}}px;">
    <button class="nav-back" bindtap="goBack">‹</button>
    <text class="nav-title">{{course.title || '课程详情'}}</text>
  </view>

  <view wx:if="{{loading || error}}" class="detail-state" style="padding-top: {{navHeight + 40}}px;"><text>{{loading ? '正在加载课程…' : error}}</text><button wx:if="{{error}}" class="retry-button" bindtap="retryCourse">重新加载</button><button class="retry-button" bindtap="goBack">返回课程列表</button></view>
  <scroll-view wx:elif="{{course}}" class="detail-scroll" scroll-y style="padding-top: {{navHeight}}px;">
    <view class="video-hero">
      <video
        wx:if="{{showVideoPlayer && playingVideoUrl}}"
        id="courseVideo"
        class="course-video"
        src="{{playingVideoUrl}}"
        poster="{{course.coverUrl}}"
        controls
        show-center-play-btn
        enable-play-gesture
        object-fit="contain"
        binderror="onVideoError"
      ></video>
      <block wx:else>
        <image wx:if="{{course.coverUrl}}" class="hero-cover" src="{{course.coverUrl}}" mode="aspectFill" bindtap="previewCover"></image>
        <view wx:else class="course-cover-placeholder"><text class="cover-label">知守 · 共修课堂</text><text class="cover-message">封面待更新</text></view>
        <view wx:if="{{course.coverUrl}}" class="hero-mask"></view>
        <view wx:if="{{course.chapters[0].hasVideo}}" class="play-button" bindtap="previewCourse">
          <view class="play-triangle"></view>
        </view>
      </block>
      <view wx:if="{{showVideoPlayer && playingVideoUrl}}" class="video-watermark" aria-hidden="true"><text class="video-watermark-text">{{viewerMark}}</text></view>
      <text wx:if="{{showVideoPlayer && audioOnly}}" class="audio-only-tip">当前浏览器仅播放声音 · 微信内可看画面</text>
      <text wx:if="{{isAnswerLibrary ? course.title : course.badge}}" class="detail-course-badge">{{isAnswerLibrary ? course.title : course.badge}}</text>
      <text wx:if="{{course.durationText}}" class="hero-duration">{{course.durationText}}</text>
    </view>

    <view class="detail-main">
      <view class="title-block">
        <view class="course-title-row"><text class="course-title">{{course.title}}</text><button class="course-forward" open-type="share" aria-label="转发课程"><image class="course-forward-icon" src="/assets/icons/course-forward-blue.svg" mode="aspectFit"></image><text>转发</text></button></view>
        <text wx:if="{{course.subtitle}}" class="course-subtitle">{{course.subtitle}}</text>
      </view>

      <view wx:if="{{viewAccess.checked}}" class="course-access-note">{{viewAccess.isPublic ? '本课程对外开放，可直接观看' : (viewAccess.canWatch ? '已为你开通观看' : '可查看课程图片与介绍，视频需开通观看权限')}}</view>

      <button wx:if="{{isAnswerLibrary && viewAccess.checked && !viewAccess.isPublic && !viewAccess.canWatch}}" class="retry-button" bindtap="openEducationBundle">¥688 购买答案库课程系列</button>
      <view wx:for="{{contentSections}}" wx:key="title" class="course-info-section"><text class="course-info-title">{{item.title}}</text><text class="course-info-body">{{item.body}}</text></view>

      <view class="catalog-head">
        <text class="catalog-title">课程目录</text>
        <text class="catalog-count">{{course.chapters.length}} 节</text>
      </view>

      <view wx:if="{{course.chapters.length}}" class="catalog-panel">
        <view wx:for="{{course.chapters}}" wx:key="id" class="chapter-row {{activeChapterIndex === index ? 'active' : ''}}" data-index="{{index}}" bindtap="openChapter">
          <view class="chapter-index">{{index + 1}}</view>
          <view class="chapter-copy">
            <text class="chapter-title">{{item.title}}</text>
            <text wx:if="{{item.duration}}" class="chapter-duration">{{item.duration}}</text>
          </view>
          <text class="chapter-play-tag">{{item.hasVideo ? (item.videoUrl ? '可播放' : '待开通') : '准备中'}}</text>
        </view>
      </view>

      <view wx:else class="catalog-empty">
        <text class="catalog-empty-title">目录准备中</text>
        <text class="catalog-empty-desc">课时上传后会显示在这里</text>
      </view>
    </view>
  </scroll-view>
  <view wx:if="{{showSharePanel && course}}" class="course-forward-mask" bindtap="closeSharePanel">
    <view class="course-forward-sheet" catchtap="keepSharePanelOpen" role="dialog" aria-modal="true" aria-label="转发课程">
      <view class="forward-sheet-head"><text>分享课程</text><button class="forward-close" bindtap="closeSharePanel" aria-label="关闭转发">×</button></view>
      <view class="forward-card"><text class="forward-card-brand">知守 · 课程</text><text class="forward-card-title">{{course.title}}</text><image wx:if="{{course.coverUrl}}" class="forward-card-cover" src="{{course.coverUrl}}" mode="widthFix" aria-label="课程分享封面"></image><text wx:if="{{course.subtitle}}" class="forward-card-subtitle">{{course.subtitle}}</text></view>
      <text class="forward-sheet-hint">{{shareHint}}</text>
      <text wx:if="{{shareError}}" class="forward-share-error">{{shareError}}</text>
      <button class="forward-submit" open-type="share">立即转发</button>
    </view>
  </view>
  <view wx:if="{{showShareGuide}}" class="wechat-forward-guide" bindtap="closeShareGuide" aria-label="关闭微信转发引导">
    <image class="wechat-guide-arrow" src="/assets/icons/wechat-forward-guide.svg" mode="aspectFit"></image>
    <text class="wechat-guide-title">点击右上角“…”</text><text class="wechat-guide-body">选择“发送给朋友”</text><text class="wechat-guide-note">{{shareReady ? '将发送这门课的标题和封面链接卡片' : '发送当前课程链接，封面配置尚未确认'}}</text><text class="wechat-guide-dismiss">轻触任意位置返回</text>
  </view>
</view>
