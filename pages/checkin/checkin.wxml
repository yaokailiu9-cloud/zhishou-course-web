<view class="service-page course-page">
  <view class="service-hero"><text class="eyebrow">现场签到 · 扫码进场</text><text class="page-title">{{classInfo.title || '扫码进场'}}</text><text class="muted">{{classInfo ? classInfo.timeText : '选择课程，查看到场人数与入场名单'}}</text></view>
  <view wx:if="{{error}}" class="error"><text>{{error}}</text><button bindtap="refresh" disabled="{{busy}}">重新核实权限</button></view>
  <block wx:if="{{allowed}}">
    <block wx:if="{{classId}}">
      <view class="course-stats"><view class="course-stat"><text class="number">{{stats.registered}}</text><text>报名总数</text></view><view class="course-stat"><text class="number">{{stats.attended}}</text><text>已签到</text></view><view class="course-stat"><text class="number">{{stats.remaining}}</text><text>未签到</text></view></view>
      <view wx:if="{{scanResult}}" class="card checkin-result"><text class="card-title">{{scanResult.title}} · {{scanResult.name}}</text><text class="body">已签到 {{stats.attended}} 人，还剩 {{stats.remaining}} 人未签到</text></view>
      <button class="primary" bindtap="scan" disabled="{{busy || loading}}">{{busy ? '正在处理…' : '扫码进场'}}</button>
      <text class="muted checkin-help">请扫描用户「我的报名」里的个人入场二维码，并核对本人。开课前两小时开放签到；仅统计有效报名，已取消不计入。人数以本次扫码或刷新时为准。</text>
      <view wx:if="{{candidate}}" class="card"><text class="section-title">核对入场人员</text><text class="card-title">{{candidate.name}}</text><text class="body">{{candidate.phone}}</text><text class="muted">{{candidate.attendanceStatus === 'ATTENDED' ? '此人已签到，重复扫码不会增加人数。' : '确认本人到场后，将登记到课并开放线下咨询申请资格。'}}</text><button class="primary" bindtap="confirmScan" disabled="{{busy}}">{{candidate.attendanceStatus === 'ATTENDED' ? '确认并查看最新人数' : '确认本人到场'}}</button><button class="text-button" bindtap="closeScan" disabled="{{busy}}">取消</button></view>
      <view wx:if="{{isManager}}" class="card checkin-staff"><button class="secondary" bindtap="toggleStaff" disabled="{{busy}}">{{staffOpen ? '收起签到人员设置' : '设置签到人员'}}</button>
        <block wx:if="{{staffOpen}}"><text class="muted checkin-help">管理可查看所有场次。被指定的人员仅能查看本场签到名单和扫码入场，不会获得管理权限。</text><text wx:if="{{staffError}}" class="error">{{staffError}}</text>
          <view wx:for="{{staff}}" wx:key="id" class="row"><text>{{item.name}} · 用户 {{item.accountId}}</text><button class="text-button" data-id="{{item.accountId}}" data-name="{{item.name}}" data-active="false" bindtap="setStaff" disabled="{{busy}}">取消权限</button></view>
          <text wx:if="{{!staff.length}}" class="muted">暂未指定签到人员，管理仍可签到。</text>
          <input value="{{staffSearch}}" placeholder="输入昵称或用户编号" maxlength="60" bindinput="inputStaffSearch" bindconfirm="searchStaff"/><button class="secondary" bindtap="searchStaff" disabled="{{staffLoading || busy}}">查找已登录用户</button>
          <view wx:for="{{candidates}}" wx:key="id" class="row"><text>{{item.name}} · 用户 {{item.id}}</text><button class="secondary" data-id="{{item.id}}" data-name="{{item.name}}" data-active="true" bindtap="setStaff" disabled="{{busy}}">设为本场签到人员</button></view><button wx:if="{{candidateCursor}}" class="text-button" bindtap="moreStaff" disabled="{{staffLoading || busy}}">更多用户</button>
        </block>
      </view>
    </block>
    <input value="{{search}}" placeholder="{{classId ? '搜索报名人姓名或手机号' : '搜索课程名称'}}" maxlength="60" bindinput="inputSearch" bindconfirm="refresh"/><button class="text-button" bindtap="refresh" disabled="{{busy}}">搜索 / 刷新人数</button>
    <scroll-view wx:if="{{classId}}" scroll-x class="course-tabs"><view wx:for="{{tabs}}" wx:key="key" class="course-tab {{filter === item.key ? 'active' : ''}}" data-key="{{item.key}}" bindtap="filter">{{item.label}}</view></scroll-view>
    <block wx:if="{{classId}}"><view wx:for="{{items}}" wx:key="id" class="card"><view class="row"><text class="card-title">{{item.name}}</text><text class="pill">{{item.attendanceStatus === 'ATTENDED' ? '已签到' : '未签到'}}</text></view><text class="muted">{{item.phone}}</text><text wx:if="{{item.attendanceStatus === 'ATTENDED'}}" class="muted">签到时间 {{item.verifiedText}}</text></view></block>
    <block wx:else><view wx:for="{{items}}" wx:key="id" class="card"><text class="card-title">{{item.title}}</text><text class="muted">{{item.timeText}}</text><button class="primary" data-id="{{item.id}}" bindtap="openClass">{{isManager ? '查看签到 / 设置人员' : '扫码进场'}}</button></view></block>
    <view wx:if="{{!loading && !items.length}}" class="empty">{{classId ? '当前条件下暂无报名记录。' : '暂无可签到的课程，请联系管理设置本场签到权限。'}}</view><button wx:if="{{nextCursor}}" class="secondary" bindtap="more" disabled="{{loading || busy}}">加载更多</button>
  </block>
  <text wx:if="{{loading}}" class="muted">正在读取签到信息…</text><button wx:if="{{!loading && !allowed && !error}}" class="primary" bindtap="refresh">登录并核实签到权限</button>
</view>
