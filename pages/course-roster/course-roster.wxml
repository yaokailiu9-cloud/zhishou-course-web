<view class="service-page course-page"><view class="service-hero"><text class="eyebrow">报名名单 · 扫码入场</text><text class="page-title">{{classInfo.title || '本场报名'}}</text><text class="muted">{{classInfo.timeText}}</text></view><view wx:if="{{error}}" class="error"><text>{{error}}</text><button bindtap="refresh">重试</button></view><block wx:if="{{allowed}}"><view class="course-stats"><view class="course-stat"><text class="number">{{stats.registered}}</text><text>有效报名</text></view><view class="course-stat"><text class="number">{{stats.attended}}</text><text>已到课</text></view><view class="course-stat"><text class="number">{{stats.pending}}</text><text>待核实</text></view></view><button class="primary" bindtap="scan" disabled="{{busy}}">扫码核对入场凭证</button><text class="muted">扫描后先核对报名人，再确认实际到课。报名和进群本身不会开通咨询资格。</text>
<view wx:if="{{scanCandidate}}" class="card"><text class="section-title">请核对报名人</text><text class="card-title">{{scanCandidate.registrant_name}}</text><text class="body">{{scanCandidate.phoneMasked}} · {{scanCandidate.public_class.title}}</text><text class="pill">{{scanCandidate.stateText}}</text><button class="primary" bindtap="confirmScan" disabled="{{busy || scanCandidate.attendance_status === 'ATTENDED'}}">{{scanCandidate.attendance_status === 'ATTENDED' ? '已核销，无需重复' : '确认实际到课'}}</button><button class="text-button" bindtap="closeScan" disabled="{{busy}}">收起</button></view>
<input value="{{search}}" placeholder="搜索姓名或手机号" bindinput="inputSearch" bindconfirm="refresh" confirm-type="search"/><button class="text-button" bindtap="refresh">搜索名单</button><scroll-view scroll-x class="course-tabs"><view wx:for="{{tabs}}" wx:key="key" class="course-tab {{filter === item.key ? 'active' : ''}}" data-key="{{item.key}}" bindtap="filter">{{item.label}}</view></scroll-view>
<view wx:for="{{items}}" wx:key="id" class="card"><view class="row"><text class="card-title">{{item.registrant_name}}</text><text class="pill">{{item.stateText}}</text></view><text class="link" data-phone="{{item.phone}}" bindtap="call">{{item.phone}} · 联系报名人</text><text class="muted">{{item.groupText}} · 报名于 {{item.createdText}}</text><block wx:if="{{item.status === 'REGISTERED'}}"><view class="entry-grid"><button class="secondary" disabled="{{busy || item.group_status === 'JOINED' || item.group_status === 'INVITED'}}" data-id="{{item.id}}" data-field="groupStatus" data-value="INVITED" bindtap="verify">已邀请进群</button><button class="secondary" disabled="{{busy || item.group_status === 'JOINED'}}" data-id="{{item.id}}" data-field="groupStatus" data-value="JOINED" bindtap="verify">已加入群聊</button></view><view wx:if="{{item.attendance_status !== 'ATTENDED'}}" class="entry-grid"><button class="primary" disabled="{{busy}}" data-id="{{item.id}}" data-field="attendanceStatus" data-value="ATTENDED" bindtap="verify">人工核实到课</button><button class="text-button" disabled="{{busy}}" data-id="{{item.id}}" data-field="attendanceStatus" data-value="ABSENT" bindtap="verify">标记未到课</button></view><text wx:else class="muted">已核销 · {{item.verifiedText}}</text></block></view><view wx:if="{{!loading && !items.length}}" class="empty">当前条件下暂无报名记录。</view><button wx:if="{{nextCursor}}" class="secondary" bindtap="more" disabled="{{loading}}">加载更多</button></block><text wx:if="{{loading}}" class="muted">正在读取名单…</text><button wx:if="{{!loading && !allowed && !error}}" class="primary" bindtap="refresh">登录并核实工作人员身份</button></view>
