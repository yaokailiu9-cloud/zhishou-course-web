<view class="course-page">
  <view class="course-nav" style="height: {{navHeight}}px; padding-top: {{statusBarHeight}}px;">
    <button class="library-back" bindtap="goHome">返回首页</button>
    <text class="nav-title">课程</text>
  </view>
  <view class="course-body">

    <view wx:if="{{publicCourses.length}}" class="section-head">
      <view><text class="section-kicker">从认知开始 · 读懂孩子</text><text class="section-title">孩子教育公开课</text></view>
    </view>
    <view wx:for="{{publicCourses}}" wx:key="id" class="home-course-card public-recording" data-id="{{item.id}}" bindtap="openCourse" aria-label="观看公开课{{item.title}}">
      <image class="public-recording-cover" src="{{item.coverUrl}}" mode="aspectFit"/>
      <view class="home-course-body"><text class="home-course-title">{{item.title}}</text><view class="series-entry-footer"><text>公开课 · {{item.durationText}}</text><text>立即观看 ↗</text></view></view>
    </view>
    <view class="library-intro">
      <text class="library-kicker">按主题学习</text>
      <view class="library-tabs">
        <button class="library-tab {{activeCategory === 'child' ? 'active' : ''}}" data-category="child" bindtap="selectCategory" aria-label="查看孩子系列课程" aria-selected="{{activeCategory === 'child'}}"><text>孩子系列课程</text><text class="tab-count">{{childCourses.length}} 门课程</text></button>
        <button class="library-tab {{activeCategory === 'growth' ? 'active' : ''}}" data-category="growth" bindtap="selectCategory" aria-label="查看个人成长课程" aria-selected="{{activeCategory === 'growth'}}"><text>个人成长</text><text class="tab-count">{{personalGrowthCourses.length}} 门课程</text></button>
      </view>
    </view>
    <view class="library-series-cover" aria-label="{{activeCategory === 'growth' ? '个人成长系列课程封面' : '孩子教育系列课程封面'}}">
      <image class="library-series-image" src="{{activeCategory === 'growth' ? '/assets/course-covers/personal-growth.png' : '/assets/course-covers/child-education.png'}}" mode="aspectFit"/>
    </view>
    <view wx:if="{{activeCategory === 'child'}}" class="bundle-entry"><view><text class="bundle-entry-title">答案库课程系列 · ¥688</text><text class="bundle-entry-note">非公开课程打包学习，到账后解锁，观看期1年</text></view><button class="bundle-entry-button" bindtap="openEducationBundle">查看课程包</button></view>
    <view class="library-search">
      <text class="library-search-icon">⌕</text>
      <input class="library-search-input" value="{{searchKeyword}}" placeholder="搜索当前分类的课程" confirm-type="search" bindinput="onSearchInput"/>
      <button wx:if="{{searchKeyword}}" class="library-search-clear" bindtap="clearSearch" aria-label="清空搜索">×</button>
    </view>
    <view class="library-heading library-current-heading"><text class="library-title">{{activeCategory === 'growth' ? '个人成长课程' : '孩子系列课程'}}</text><text class="section-count">{{visibleCourses.length}} 门课程</text></view>
    <view class="course-grid">
      <view wx:for="{{visibleCourses}}" wx:key="id" class="course-card" data-id="{{item.id}}" bindtap="openCourse" aria-label="查看{{item.title}}">
        <view class="card-cover-wrap">
          <image wx:if="{{item.coverUrl}}" class="card-cover" src="{{item.coverUrl}}" mode="aspectFill"/>
          <view wx:else class="card-cover-fallback"><text>{{item.title}}</text></view>
          <text wx:if="{{item.durationText}}" class="card-duration">{{item.durationText}}</text>
        </view>
        <view class="card-body">
          <text class="card-title">{{item.title}}</text>
          <view class="card-meta"><text>课程 {{index + 1}}</text><text>查看目录</text></view>
        </view>
      </view>
    </view>

    <view wx:if="{{archivedCourses.length}}" class="archived-series">
      <view class="library-heading"><text class="library-title">未公开系列课程</text><text class="section-count">定向开放</text></view>
      <view wx:for="{{archivedCourses}}" wx:key="id" class="archived-course" data-id="{{item.id}}" bindtap="openCourse" aria-label="{{item.title}}，进入查看观看权限">
        <image class="public-recording-cover" src="{{item.coverUrl}}" mode="aspectFit"/>
        <view class="archived-course-copy"><text>{{item.title}}</text><text>🔒 授权观看</text></view>
      </view>
    </view>
    <view wx:if="{{loading}}" class="empty-state">正在加载课程…</view>
    <view wx:elif="{{error}}" class="empty-state"><text>{{error}}</text><button class="retry-button" bindtap="fetchCourses">重新加载</button></view>
    <view wx:elif="{{!visibleCourses.length}}" class="empty-state">{{searchKeyword ? '没有找到相关课程' : '该分类的课程准备中'}}</view>
  </view>
</view>
