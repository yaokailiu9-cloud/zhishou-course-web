.course-page {
  min-height: 100vh;
  padding-bottom: calc(32rpx + env(safe-area-inset-bottom));
  color: var(--em-color-primary);
  background: #fbf9f8;
  font-family: var(--em-font-family);
}

.course-nav {
  position: sticky;
  top: 0;
  z-index: 20;
  display: flex;
  align-items: flex-end;
  box-sizing: border-box;
  padding: 0 var(--em-page-x) 12rpx;
  background: rgba(251, 249, 248, 0.94);
  backdrop-filter: blur(18px);
}

.nav-title {
  height: 64rpx;
  color: var(--em-color-primary);
  font-size: 40rpx;
  font-weight: 800;
  line-height: 64rpx;
}

.nav-search {
  display: flex;
  align-items: center;
  width: calc(100% - 2 * var(--em-page-x));
  height: 72rpx;
  margin: 0 var(--em-page-x) 20rpx;
  padding: 0 28rpx;
  background: #ffffff;
  border: 1rpx solid var(--em-color-border-muted);
  border-radius: var(--em-radius-pill);
  box-shadow: 0 8rpx 24rpx rgba(0, 39, 39, 0.04);
}

.search-icon {
  flex-shrink: 0;
  margin-right: 14rpx;
  color: var(--em-color-text-muted);
  font-size: 28rpx;
  font-weight: 700;
}

.search-placeholder {
  flex: 1;
  min-width: 0;
  color: var(--em-color-text-placeholder);
  font-size: 26rpx;
}

.course-body {
  padding: 0 var(--em-page-x);
}

.featured-banner {
  position: relative;
  height: 320rpx;
  margin-bottom: 36rpx;
  overflow: hidden;
  border-radius: 24rpx;
  box-shadow: 0 18rpx 48rpx rgba(0, 39, 39, 0.12);
}

.featured-cover {
  display: block;
  width: 100%;
  height: 100%;
}

.featured-mask {
  position: absolute;
  right: 0;
  bottom: 0;
  left: 0;
  height: 70%;
  background: linear-gradient(180deg, rgba(0, 39, 39, 0) 0%, rgba(0, 39, 39, 0.78) 100%);
}

.featured-badge {
  position: absolute;
  top: 20rpx;
  left: 20rpx;
  padding: 8rpx 18rpx;
  color: var(--em-color-primary);
  font-size: 24rpx;
  font-weight: 800;
  background: var(--em-color-gold);
  border-radius: var(--em-radius-pill);
}

.featured-copy {
  position: absolute;
  right: 28rpx;
  bottom: 28rpx;
  left: 28rpx;
}

.featured-kicker {
  display: block;
  color: rgba(255, 255, 255, 0.72);
  font-size: 24rpx;
  font-weight: 700;
}

.featured-title {
  display: block;
  margin-top: 8rpx;
  color: #ffffff;
  font-size: 34rpx;
  font-weight: 800;
  line-height: 1.35;
}

.featured-meta {
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  gap: 8rpx;
  margin-top: 12rpx;
  color: rgba(255, 255, 255, 0.82);
  font-size: 24rpx;
}

.featured-meta .dot {
  opacity: 0.6;
}

.section-head {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  margin-bottom: 24rpx;
}

.section-title {
  color: var(--em-color-primary);
  font-size: 34rpx;
  font-weight: 800;
}

.section-count {
  color: var(--em-color-text-secondary);
  font-size: 24rpx;
  font-weight: 600;
}

.course-grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 22rpx;
}

.course-card {
  overflow: hidden;
  background: #ffffff;
  border: 1rpx solid var(--em-color-border-muted);
  border-radius: 20rpx;
  box-shadow: 0 10rpx 28rpx rgba(0, 39, 39, 0.04);
}

.card-cover-wrap {
  position: relative;
  width: 100%;
  height: 196rpx;
  overflow: hidden;
  background: var(--em-color-primary-soft);
}

.card-cover {
  display: block;
  width: 100%;
  height: 100%;
}

.card-duration {
  position: absolute;
  right: 12rpx;
  bottom: 12rpx;
  padding: 4rpx 10rpx;
  color: #ffffff;
  font-size: 18rpx;
  font-weight: 700;
  background: rgba(0, 0, 0, 0.55);
  border-radius: 8rpx;
}

.card-badge {
  position: absolute;
  top: 12rpx;
  left: 12rpx;
  padding: 4rpx 12rpx;
  color: var(--em-color-primary);
  font-size: 18rpx;
  font-weight: 800;
  background: var(--em-color-gold);
  border-radius: var(--em-radius-pill);
}

.card-body {
  padding: 18rpx 18rpx 20rpx;
}

.card-title {
  display: -webkit-box;
  overflow: hidden;
  color: var(--em-color-primary);
  font-size: 26rpx;
  font-weight: 800;
  line-height: 1.45;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
}

.card-subtitle {
  display: -webkit-box;
  margin-top: 10rpx;
  overflow: hidden;
  color: var(--em-color-text-secondary);
  font-size: 24rpx;
  line-height: 1.4;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
}

.empty-state {
  padding: 80rpx 0 120rpx;
  text-align: center;
}

.empty-title {
  display: block;
  color: var(--em-color-primary);
  font-size: 30rpx;
  font-weight: 800;
}

.empty-desc {
  display: block;
  margin-top: 12rpx;
  color: var(--em-color-text-secondary);
  font-size: 24rpx;
}

/* Keep the original learning library and make free in-person classes easy to find. */
.library-intro { padding:20rpx 0 32rpx; }
.library-kicker { display:block; font-size:21rpx; color:#82704b; letter-spacing:3rpx; }
.library-title { display:block; margin-top:20rpx; font-family:var(--em-font-serif); font-size:52rpx; font-weight:500; line-height:1.4; white-space:pre-line; }
.library-desc { display:block; margin-top:18rpx; color:#717878; font-size:24rpx; }
.public-class-link { display:flex; align-items:center; justify-content:space-between; padding:28rpx; margin-bottom:36rpx; background:#003436; color:#fff; border-radius:16rpx; }
.public-link-kicker { display:block; color:#ddc48d; font-size:21rpx; }
.public-link-title { display:block; font-size:32rpx; margin-top:12rpx; font-family:var(--em-font-serif); }
.public-link-arrow { font-size:40rpx; color:#e5ce99; }
.featured-banner { height:390rpx; border-radius:20rpx; box-shadow:none; }
.featured-title { font-family:var(--em-font-serif); font-size:40rpx; font-weight:500; line-height:1.45; }
.featured-mask { height:100%; background:linear-gradient(180deg,transparent 0%,rgba(0,39,39,.9) 100%); }
.section-title { font-family:var(--em-font-serif); font-size:38rpx; font-weight:600; }
.course-grid { display:flex; flex-direction:column; gap:0; }
.course-card { display:flex; background:transparent; padding:24rpx 0; border:0; border-top:1rpx solid #e8e3df; border-radius:0; box-shadow:none; }
.card-cover-wrap { width:220rpx; height:190rpx; flex-shrink:0; border-radius:12rpx; }
.card-body { flex:1; min-width:0; padding:8rpx 0 8rpx 24rpx; }
.card-title { font-size:29rpx; font-weight:600; line-height:1.5; }
.card-subtitle { font-size:23rpx; line-height:1.7; }
.nav-search { border-radius:12rpx; box-shadow:none; }
.nav-title { font-family:var(--em-font-serif); font-weight:600; }
