.course-page { min-height:100vh; padding-bottom:calc(32px + env(safe-area-inset-bottom)); color:#002727; background:#fbf9f8; font-family:var(--em-font-family); }
.course-nav { position:sticky; top:0; z-index:20; display:flex; align-items:center; gap:18px; box-sizing:border-box; padding-left:12px; padding-right:12px; background:#fbf9f8; border-bottom:1px solid #ebe7e1; }
.library-back { flex:none; margin:0; padding:10px 0; background:transparent; color:#717878; font-size:13px; line-height:24px; }
.nav-title { font-size:20px; font-weight:600; line-height:1.4; }
.course-body { padding:0 12px; }
.library-intro { padding:24px 2px 18px; }
.library-kicker { display:block; margin-bottom:8px; color:#80714e; font-size:12px; letter-spacing:2px; }
.library-heading { display:flex; align-items:baseline; justify-content:space-between; gap:12px; }
.library-title { font-size:24px; font-weight:600; line-height:1.4; }
.library-tabs { display:grid; grid-template-columns:repeat(2,minmax(0,1fr)); gap:10px; }
.library-tab { display:flex; flex-direction:column; align-items:flex-start; justify-content:space-between; min-width:0; min-height:86px; margin:0; padding:14px; border:1px solid #e5ded2; border-radius:10px; background:#fff; color:#20322d; font-size:17px; font-weight:600; text-align:left; }
.library-tab.active { border-color:#002f30; background:#002f30; color:#fff; }
.tab-count { margin-top:8px; color:#858986; font-size:12px; font-weight:400; }
.library-tab.active .tab-count { color:#c6d6d0; }
.library-series-cover { width:100%; aspect-ratio:2752 / 1536; overflow:hidden; margin-bottom:20px; border-radius:10px; }
.library-series-image { display:block; width:100%; height:100%; }
.library-search { display:flex; align-items:center; gap:10px; height:46px; margin-bottom:20px; padding:0 12px; border:1px solid #e5ded2; border-radius:9px; background:#fff; }
.library-search-icon { flex:none; color:#858986; font-size:24px; line-height:1; }
.library-search-input { flex:1; min-width:0; height:100%; color:#20322d; font-size:14px; }
.library-search-clear { flex:none; margin:0; padding:0 4px; background:transparent; color:#858986; font-size:23px; }
.library-current-heading { margin:4px 2px 16px; }
.section-count { color:#858986; font-size:12px; }
.course-grid { display:grid; grid-template-columns:repeat(2,minmax(0,1fr)); column-gap:10px; row-gap:16px; }
.course-card { min-width:0; overflow:hidden; background:#fff; border-radius:8px; }
.card-cover-wrap { position:relative; width:100%; height:auto; aspect-ratio:4 / 3; overflow:hidden; background:#e9e6df; }
.card-cover { display:block; width:100%; height:100%; }
.card-cover-fallback { display:flex; width:100%; height:100%; align-items:center; justify-content:center; padding:12px; box-sizing:border-box; color:#80714e; font-size:15px; }
.card-duration { position:absolute; right:8px; bottom:8px; padding:3px 5px; border-radius:4px; color:#fff; background:rgba(0,0,0,.6); font-size:11px; }
.card-body { padding:10px 9px 12px; }
.card-title { display:-webkit-box; -webkit-line-clamp:2; -webkit-box-orient:vertical; overflow:hidden; min-height:44px; color:#20322d; font-size:15px; font-weight:500; line-height:22px; }
.card-meta { display:flex; align-items:center; justify-content:space-between; gap:4px; margin-top:8px; color:#8a908d; font-size:11px; line-height:16px; }
.empty-state { padding:32px 12px; color:#717878; text-align:center; line-height:1.8; }
.retry-button { display:block; margin:16px auto 0; padding:12px 20px; border-radius:8px; color:#fff; background:#002727; font-size:14px; }

.bundle-entry{display:flex;align-items:center;justify-content:space-between;gap:20rpx;padding:28rpx 0;border-bottom:1rpx solid #d9e2df;margin-bottom:24rpx}.bundle-entry-title{display:block;font-size:30rpx;font-weight:600;color:#002727}.bundle-entry-note{display:block;font-size:24rpx;line-height:1.7;color:#49625a;margin-top:8rpx}.bundle-entry-button{flex-shrink:0;background:#002727;color:#fff;border-radius:12rpx;font-size:25rpx;padding:0 22rpx;margin:0}.bundle-entry-button::after{border:0}
